---
/**
 * The hero's picture: a small mock of a Canon board with four prototypes on it,
 * each labelled with where it runs. Decorative, in the same language as the
 * board mock in McpWalkthrough.
 */
const FRAMES = [
  { name: 'Checkout', source: 'localhost:5173', tag: 'v3' },
  { name: 'Onboarding', source: 'v0 preview' },
  { name: 'Pricing', source: 'Figma prototype' },
  { name: 'Settings', source: 'Vercel preview', pin: '2 notes' },
];
---

<div
  class="board"
  role="img"
  aria-label="A Canon board with four prototypes: Checkout on localhost, Onboarding from a v0 preview, Pricing from a Figma prototype and Settings from a Vercel preview. Checkout is on version 3 and Settings has 2 notes."
>
  <div class="board-bar" aria-hidden="true"><span>Prototypes</span><span>Board</span></div>
  <div class="board-body" aria-hidden="true">
    <div class="grid">
      {FRAMES.map((f) => (
        <div class="item">
          <div class="frame">
            <span class="title">{f.name}</span>
            <span class="line l1"></span>
            <span class="line l2"></span>
            <span class="block"></span>
            {f.tag && <span class="tag">{f.tag}</span>}
            {f.pin && <span class="pin">{f.pin}</span>}
          </div>
          <small>{f.source}</small>
        </div>
      ))}
    </div>
    <p class="notice">Claude Code added Checkout</p>
  </div>
</div>

<style>
  .board {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background-color: var(--color-panel);
    border: 1px solid var(--color-rule);
    font-family: var(--font-app);
    font-size: 13px;
  }
  .board-bar {
    display: flex;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-app-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .board-body {
    position: relative;
    padding: 16px 16px 60px;
    background-color: var(--color-ground);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 12px;
  }
  .item {
    min-width: 0;
  }
  .frame {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    aspect-ratio: 4 / 3;
    padding: 10px;
    border-radius: var(--radius-md);
    background-color: var(--color-panel);
    border: 1px solid var(--color-rule);
    color: var(--color-ink);
    overflow: hidden;
  }
  .title {
    font-size: 12px;
  }
  .line,
  .block {
    display: block;
    border-radius: 2px;
    background-color: var(--color-recess);
  }
  .line {
    height: 5px;
  }
  .l1 {
    width: 70%;
  }
  .l2 {
    width: 45%;
  }
  .block {
    flex: 1;
    min-height: 0;
    margin-top: 2px;
  }
  .tag,
  .pin {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 1px 6px;
    border-radius: 999px;
    font-size: 10px;
    line-height: 1.5;
  }
  .tag {
    background-color: var(--color-recess);
    color: var(--color-ink);
  }
  .pin {
    background-color: var(--color-ink);
    color: var(--color-ground);
  }
  small {
    display: block;
    margin-top: 6px;
    color: var(--color-ink-soft);
    font-size: 11px;
    overflow-wrap: anywhere;
  }
  .notice {
    position: absolute;
    right: 12px;
    bottom: 12px;
    max-width: calc(100% - 24px);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background-color: var(--color-ink);
    color: var(--color-ground);
    font-size: 12px;
  }
</style>
