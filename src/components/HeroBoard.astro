---
/**
 * The hero's picture: a small mock of a Canon board with four prototypes on it,
 * each labelled with where it runs. Decorative, in the same language as the
 * board mock in McpWalkthrough: a dotted canvas, light prototypes on it, and
 * the orange dot of a note as the only hue.
 */
const FRAMES = [
  { name: 'Checkout', source: 'localhost:5173', tag: 'v3/3', kind: 'form' },
  { name: 'Onboarding', source: 'v0 preview', kind: 'ring' },
  { name: 'Pricing', source: 'Figma prototype', kind: 'plans' },
  { name: 'Settings', source: 'Vercel preview', tag: '2 notes', kind: 'list', pin: true },
];
---

<div
  class="board"
  role="img"
  aria-label="A Canon board with four prototypes: Checkout on localhost, Onboarding from a v0 preview, Pricing from a Figma prototype and Settings from a Vercel preview. Checkout is on version 3 and Settings has 2 notes."
>
  <div class="board-bar" aria-hidden="true"><span>Explorations</span><span>Board</span></div>
  <div class="board-body" aria-hidden="true">
    <div class="grid">
      {FRAMES.map((f, i) => (
        <div class="item rise" style={`animation-delay:${120 + i * 70}ms`}>
          <p class="caption">
            <span class="name">{f.name}</span>
            {f.tag && <span class="tag">{f.tag}</span>}
          </p>
          <div class:list={['frame', f.tag === 'v3/3' && 'stacked']}>
            <div class="paper">
              <span class="bar nav"></span>
              <span class="bar title"></span>
              {f.kind === 'form' && (
                <>
                  <span class="input"></span>
                  <span class="input"></span>
                  <span class="spacer"></span>
                  <span class="pill"></span>
                </>
              )}
              {f.kind === 'ring' && (
                <>
                  <span class="ring"></span>
                  <span class="bar short"></span>
                  <span class="spacer"></span>
                  <span class="pill"></span>
                </>
              )}
              {f.kind === 'plans' && (
                <span class="plans">
                  <span class="plan"></span>
                  <span class="plan on"></span>
                </span>
              )}
              {f.kind === 'list' && (
                <>
                  <span class="row"><span></span><i></i></span>
                  <span class="row"><span></span><i class="on"></i></span>
                  <span class="row"><span></span><i></i></span>
                </>
              )}
            </div>
            {f.pin && <span class="pin"></span>}
          </div>
          <small>{f.source}</small>
        </div>
      ))}
    </div>
    <p class="notice rise">Claude Code added&nbsp;Checkout</p>
  </div>
</div>

<style>
  .board {
    /* Prototypes are light pages in both themes. */
    --paper: var(--color-panel);
    --paper-ink: #1a1815;
    --paper-line: #e2e0d9;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-lg);
    background-color: var(--color-panel);
    box-shadow: inset 0 0 0 1px var(--color-rule);
    font-family: var(--font-app);
    font-size: 13px;
  }
  :global(:root[data-app-theme='dark']) .board {
    --paper: #f5f4ef;
  }
  .board-bar {
    display: flex;
    justify-content: space-between;
    padding: 11px 16px;
    border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-app-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .board-body {
    position: relative;
    margin: 0 1px 1px;
    padding: clamp(16px, 2vw, 28px) clamp(16px, 2vw, 28px) 68px;
    border-radius: 0 0 calc(var(--radius-lg) - 1px) calc(var(--radius-lg) - 1px);
    background-color: var(--color-ground);
    background-image: radial-gradient(var(--color-rule) 1px, transparent 1px);
    background-size: 14px 14px;
    background-position: 7px 7px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px clamp(12px, 3vw, 24px);
  }
  .item {
    min-width: 0;
  }
  .caption {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin-bottom: 6px;
  }
  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    color: var(--color-ink-soft);
  }
  .tag {
    flex-shrink: 0;
    padding: 1px 6px;
    border-radius: 5px;
    background-color: var(--color-recess);
    color: var(--color-ink-soft);
    font-family: var(--font-app-mono);
    font-size: 10px;
    line-height: 1.5;
  }
  .frame {
    position: relative;
  }
  /* Two older versions under the current one, each a step darker. */
  .frame.stacked::before,
  .frame.stacked::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    background-color: color-mix(in oklab, var(--paper) 88%, var(--color-ink-soft));
    transform: translate(4px, 4px);
  }
  .frame.stacked::before {
    background-color: color-mix(in oklab, var(--paper) 76%, var(--color-ink-soft));
    transform: translate(8px, 8px);
  }
  .paper {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    aspect-ratio: 4 / 3;
    padding: 10px 12px 12px;
    border-radius: var(--radius-md);
    background-color: var(--paper);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
    overflow: hidden;
  }
  .bar {
    display: block;
    height: 4px;
    border-radius: 2px;
    background-color: var(--paper-line);
  }
  .bar.nav {
    width: 34%;
    height: 3px;
    margin-bottom: 4px;
  }
  .bar.title {
    width: 62%;
    height: 7px;
    background-color: color-mix(in oklab, var(--paper-ink) 70%, var(--paper));
  }
  .bar.short {
    width: 40%;
    align-self: center;
  }
  .input {
    display: block;
    height: 12%;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--paper-line);
  }
  .spacer {
    flex: 1;
  }
  .pill {
    display: block;
    width: 42%;
    height: 9%;
    min-height: 7px;
    border-radius: 999px;
    background-color: var(--paper-ink);
  }
  .ring {
    display: block;
    align-self: center;
    height: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid color-mix(in oklab, var(--paper-ink) 55%, var(--paper));
    border-left-color: var(--paper-line);
  }
  .plans {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-top: 4px;
  }
  .plan {
    border-radius: 5px;
    background-color: #fff;
    box-shadow: inset 0 0 0 1px var(--paper-line);
  }
  .plan.on {
    box-shadow: inset 0 0 0 1.5px var(--paper-ink);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 3px;
    border-bottom: 1px solid var(--paper-line);
  }
  .row span {
    width: 45%;
    height: 4px;
    border-radius: 2px;
    background-color: var(--paper-line);
  }
  .row i {
    width: 14px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--paper-line);
  }
  .row i.on {
    background-color: var(--paper-ink);
  }
  /* A note pinned to the screen: the only hue on the board. */
  .pin {
    position: absolute;
    z-index: 2;
    top: 38%;
    left: 58%;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--brand-orange);
    box-shadow: 0 0 0 2px var(--color-ground);
  }
  small {
    display: block;
    margin-top: 14px;
    color: var(--color-ink-soft);
    font-family: var(--font-app-mono);
    font-size: 10px;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
  }
  .notice {
    position: absolute;
    right: 14px;
    bottom: 14px;
    max-width: calc(100% - 28px);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background-color: var(--color-ink);
    color: var(--color-ground);
    font-size: 12px;
    animation-delay: 700ms;
  }
</style>
