---
import { withBase } from '../lib/withBase';
import { PROJECT } from '../data/v2Preview';

/** The account button in the top bar: who you are, and the way out. */
---

<div class="relative ml-auto" data-account>
  <button
    type="button"
    data-account-button
    aria-expanded="false"
    aria-haspopup="menu"
    aria-controls="account-menu"
    class="flex min-h-11 items-center gap-2 rounded-md px-2 text-[13px] font-medium text-ink-soft transition-colors duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
  >
    <span class="sr-only">Account.</span>
    <span class="hidden sm:inline">{PROJECT.viewer.name}</span>
    <span
      aria-hidden="true"
      class="flex size-8 items-center justify-center rounded-full bg-recess text-[11px] font-semibold text-ink"
    >
      {PROJECT.viewer.initials}
    </span>
  </button>

  {/* The menu floats over both the ground and the panels beneath it, and there
      are no shadows to lift it — so it takes the recess, the one fill that
      reads as distinct against either. */}
  <div
    id="account-menu"
    data-account-menu
    hidden
    class="absolute right-0 z-20 mt-1 flex w-64 max-w-[calc(100vw-2rem)] flex-col gap-[2px] overflow-hidden rounded-md bg-recess p-1"
  >
    <div class="rounded-sm bg-panel px-3 py-3">
      <p class="label">Signed in as</p>
      <p class="mt-1 font-mono text-[13px] break-all text-ink">{PROJECT.account}</p>
    </div>


    <a
      href={withBase('/v2-preview/signin/')}
      data-account-signout
      class="flex min-h-11 items-center rounded-sm bg-panel px-3 text-[13px] font-semibold text-ink transition-colors duration-[120ms] hover:bg-recess focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
    >
      Sign out
    </a>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-account]')) {
    const button = root.querySelector<HTMLButtonElement>('[data-account-button]')!;
    const menu = root.querySelector<HTMLElement>('[data-account-menu]')!;

    function setOpen(open: boolean) {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    }

    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      setOpen(!open);
      if (!open) menu.querySelector<HTMLElement>('button, a')?.focus();
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) setOpen(false);
    });

    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
