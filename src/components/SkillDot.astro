---
// A skill's own small dot (D-125). Decorative: it always sits beside the
// skill's name, which carries the meaning, and no type is set on it.
import { SKILL_DOT } from '../lib/skillLines';

interface Props {
  slug: string;
  /** Diameter in px. */
  size?: number;
  /** Sit on the cap height of the text it precedes, instead of the line's centre. */
  inline?: boolean;
}
const { slug, size = 10, inline = false } = Astro.props;
const token = SKILL_DOT[slug];
if (!token) throw new Error(`No dot colour for skill "${slug}". Add it to SKILL_DOT in src/lib/skillLines.ts.`);
// Raise the dot's bottom edge off the baseline so its middle lands on half the
// cap height (about 0.35em in Public Sans).
const inlineStyle = inline ? `vertical-align:calc(0.35em - ${size / 2}px);margin-right:${Math.round(size * 0.9)}px;` : '';
---

<span
  aria-hidden="true"
  class="skill-dot"
  style={`width:${size}px;height:${size}px;background-color:var(${token});${inlineStyle}`}
></span>

<style>
  .skill-dot {
    display: inline-block;
    flex: none;
    border-radius: 50%;
  }
</style>
