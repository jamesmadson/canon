---
import DepthDots from './DepthDots.astro';
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/withBase';

interface Props {
  skill: CollectionEntry<'skills'>;
}

const { skill } = Astro.props;
const { name, tagline, rating, slug } = skill.data;
---

<a href={withBase(`/skills/${slug}/`)} class="group flex flex-col gap-2 bg-bg p-4 hover:bg-surface/60 focus-visible:outline-2 focus-visible:outline-ink focus-visible:-outline-offset-2">
  <DepthDots rating={rating} />
  <div class="flex flex-col gap-1">
    <h3 class="text-base font-semibold text-ink">{name}</h3>
    <p class="text-[13px] font-medium leading-snug text-ink-soft">{tagline}</p>
  </div>
</a>
