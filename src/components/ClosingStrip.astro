---
/**
 * The closing strip: the name giant and edge to edge, paper on near-black,
 * drifting slowly as it comes into view. Its o is the orange dot, and the dot
 * takes you back to the top.
 *
 * Hovering the dot lifts it, fades an up arrow in and sends out one soft ring;
 * clicking it makes it rise as the page scrolls.
 *
 * The drift is transform and opacity only, driven from scroll progress. The
 * script does not run at all under prefers-reduced-motion, so what that reader
 * gets is the authored static state rather than a stopped animation.
 */
---

<section class="closing-strip" aria-label="Canon" data-closing-strip>
  <p class="giant" data-closing-giant>
    <span aria-hidden="true">can</span><a href="#" class="giant-dot" aria-label="Back to top" data-to-top><svg class="giant-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" /></svg></a><span aria-hidden="true">n</span>
  </p>
  <p class="meta">Every prototype · from any tool · in one place</p>
</section>

<script>
  const strip = document.querySelector<HTMLElement>('[data-closing-strip]');
  const giant = document.querySelector<HTMLElement>('[data-closing-giant]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  const toTop = document.querySelector<HTMLElement>('[data-to-top]');
  toTop?.addEventListener('click', (e) => {
    e.preventDefault();
    // The dot rises a short way as the page starts to scroll, then settles.
    if (!still.matches) {
      toTop.classList.add('rising');
      setTimeout(() => toTop.classList.remove('rising'), 450);
    }
    window.scrollTo({ top: 0, behavior: still.matches ? 'auto' : 'smooth' });
    document.querySelector<HTMLElement>('a[href], button')?.focus({ preventScroll: true });
  });

  if (strip && giant && !still.matches) {
    let frame = 0;

    function draw() {
      frame = 0;
      const box = strip!.getBoundingClientRect();
      const span = window.innerHeight + box.height;
      // 0 as the strip enters from below, 1 as it leaves at the top.
      const progress = Math.min(1, Math.max(0, (window.innerHeight - box.top) / span));
      giant!.style.transform = `translateY(${(0.5 - progress) * 56}px)`;
      giant!.style.opacity = String(0.35 + Math.min(1, progress * 2.2) * 0.65);
    }

    function schedule() {
      if (frame) return;
      frame = requestAnimationFrame(draw);
    }

    draw();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
  }
</script>
