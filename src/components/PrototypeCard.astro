---
import ScreenArt from './ScreenArt.astro';
import { withBase } from '../lib/withBase';
import { daysIdle, idleLabel, isStale } from '../lib/staleness';
import { PREVIEW_AS_OF, sourceLine, type Prototype } from '../data/v2Preview';

interface Props {
  prototype: Prototype;
}

const { prototype } = Astro.props;
const stale = isStale(prototype.lastActivity, PREVIEW_AS_OF);
const idle = daysIdle(prototype.lastActivity, PREVIEW_AS_OF);
const source = sourceLine(prototype);
---

<a
  href={withBase(`/v2-preview/${prototype.slug}/`)}
  class="group flex flex-col border-r border-b border-rule bg-bg transition-colors duration-[120ms] hover:border-rule-strong hover:bg-surface/30 active:bg-surface/50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
>
  {/* One well, one inset, one phone-shaped box — a capture and its absence are
      drawn to the same geometry, so the empty card is the same card. */}
  <span class="flex aspect-[3/2] items-center justify-center overflow-hidden border-b border-rule bg-surface/40 p-4">
    {prototype.screen ? (
      <span class="block h-full overflow-hidden rounded-md border border-rule-strong bg-bg">
        <span class="block h-full aspect-[390/844]">
          <ScreenArt screen={prototype.screen} w={390} h={844} />
        </span>
      </span>
    ) : (
      /* No capture, so no wireframe — the same box, drawn open. */
      <span class="flex h-full aspect-[390/844] items-center justify-center rounded-md border border-dashed border-rule-strong px-2 text-center text-[11px] leading-snug font-medium text-ink-soft">
        No capture
      </span>
    )}
  </span>

  <span class="flex min-h-11 flex-1 flex-col gap-2 px-4 py-4">
    <span class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <span class="text-[15px] font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors group-hover:decoration-ink">
        {prototype.name}
      </span>
      {stale && (
        <span class="rounded-sm border border-rule-strong px-2 py-1 text-[11px] font-semibold tracking-wide text-ink tabular-nums">
          Idle {idle} days
        </span>
      )}
    </span>

    <span
      class:list={[
        'block break-all text-[13px] text-ink-soft',
        source.mono ? 'font-mono' : 'font-medium',
      ]}
    >
      {source.text}
    </span>

    <span class="mt-auto block pt-1 text-[11px] font-medium text-ink-soft tabular-nums">
      {prototype.author} · {idleLabel(prototype.lastActivity, PREVIEW_AS_OF)}
      <span class="block">{prototype.lastActivityNote}</span>
    </span>
  </span>
</a>
