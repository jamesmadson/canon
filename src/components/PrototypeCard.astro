---
import ScreenArt from './ScreenArt.astro';
import { withBase } from '../lib/withBase';
import { daysIdle, idleLabel, isStale } from '../lib/staleness';
import { PREVIEW_AS_OF, sourceLine, type Prototype } from '../data/v2Preview';

interface Props {
  prototype: Prototype;
}

const { prototype } = Astro.props;
const stale = isStale(prototype.lastActivity, PREVIEW_AS_OF);
const idle = daysIdle(prototype.lastActivity, PREVIEW_AS_OF);
const source = sourceLine(prototype);
---

<a
  href={withBase(`/v2-preview/${prototype.slug}/`)}
  class="group flex flex-col border-r border-b border-rule bg-bg transition-colors hover:bg-surface/30 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
>
  <span class="relative block aspect-[3/2] overflow-hidden border-b border-rule bg-surface/40">
    {prototype.screen ? (
      <span
        class="absolute top-[2%] left-1/2 block w-[30%] min-w-[76px] -translate-x-1/2 overflow-hidden rounded-[5px] border border-rule-strong bg-bg"
      >
        <span class="block aspect-[390/844]">
          <ScreenArt screen={prototype.screen} w={390} h={844} />
        </span>
      </span>
    ) : (
      /* No capture, so no wireframe. A dashed well is the whole picture. */
      <span class="absolute inset-0 flex items-center justify-center p-5">
        <span class="flex h-full w-full items-center justify-center rounded-md border border-dashed border-rule-strong px-3 text-center text-[11px] font-medium text-ink-soft">
          No capture yet
        </span>
      </span>
    )}
  </span>

  <span class="flex min-h-11 flex-1 flex-col gap-1.5 px-4 py-3.5">
    <span class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <span class="text-[15px] font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors group-hover:decoration-ink">
        {prototype.name}
      </span>
      {stale && (
        <span class="rounded-sm border border-rule-strong px-2 py-0.5 text-[11px] font-semibold tracking-wide text-ink tabular-nums">
          Idle {idle} days
        </span>
      )}
    </span>

    <span
      class:list={[
        'block break-all text-[13px] text-ink-soft',
        source.mono ? 'font-mono' : 'font-medium',
      ]}
    >
      {source.text}
    </span>

    <span class="mt-auto block pt-1 text-[11px] font-medium text-ink-soft tabular-nums">
      {prototype.author} · {idleLabel(prototype.lastActivity, PREVIEW_AS_OF)}
      <span class="block">{prototype.lastActivityNote}</span>
    </span>
  </span>
</a>
