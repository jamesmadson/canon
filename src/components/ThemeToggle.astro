---
/**
 * Light, Dark, System, in the header of every page.
 *
 * The choice is written to one key and read before the first paint in
 * BaseLayout, so the site is never drawn light and repainted dark. The account
 * menu inside the preview carries the same three buttons against the same key;
 * both scripts update every [data-theme-option] on the page, so the two stay in
 * step without either owning the other.
 */
const THEMES = [
  { id: 'light', label: 'Light' },
  { id: 'dark', label: 'Dark' },
  { id: 'system', label: 'System' },
] as const;
---

<div
  data-theme-toggle
  role="group"
  aria-label="Theme"
  class="flex items-center gap-[2px] rounded-md bg-recess p-[2px]"
>
  {THEMES.map((theme) => (
    <button
      type="button"
      data-theme-option={theme.id}
      aria-pressed="false"
      class="flex min-h-11 items-center justify-center rounded-[9px] px-3 text-[13px] font-medium text-ink-soft transition-colors duration-[120ms] hover:text-ink active:scale-[0.96] aria-pressed:bg-panel aria-pressed:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
    >
      {theme.label}
    </button>
  ))}
</div>

<script>
  const KEY = 'canon-app-theme';
  type Theme = 'light' | 'dark' | 'system';

  function readTheme(): Theme {
    try {
      const stored = localStorage.getItem(KEY);
      if (stored === 'light' || stored === 'dark') return stored;
    } catch {
      /* Private mode, blocked storage — System is the honest fallback. */
    }
    return 'system';
  }

  function applyTheme(theme: Theme) {
    document.documentElement.dataset.appTheme = theme;
    try {
      localStorage.setItem(KEY, theme);
    } catch {
      /* Nothing to do: the choice holds for this page and no further. */
    }
    for (const option of document.querySelectorAll<HTMLButtonElement>('[data-theme-option]')) {
      option.setAttribute('aria-pressed', String(option.dataset.themeOption === theme));
    }
  }

  for (const group of document.querySelectorAll<HTMLElement>('[data-theme-toggle]')) {
    for (const option of group.querySelectorAll<HTMLButtonElement>('[data-theme-option]')) {
      option.addEventListener('click', () => applyTheme(option.dataset.themeOption as Theme));
    }
  }

  applyTheme(readTheme());
</script>
