---
/** Where people reach the maker: a mailto button and the address as plain text. */
const ADDRESS = 'james@jamesmadson.me';
---

<section aria-labelledby="contact-heading" class="max-w-xl">
  <h2 id="contact-heading" class="display">Tell me how it goes</h2>
  <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">
    Canon is early. If you try it, I want to hear what works and what gets in the way.
  </p>
  <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
    <a href={`mailto:${ADDRESS}?subject=Canon`} class="btn btn-primary shrink-0">Email me</a>
    <span class="select-all font-mono text-[13px] text-ink-soft">{ADDRESS}</span>
  </div>
</section>
