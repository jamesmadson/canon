---
/**
 * A copy button that flips to "Copied" and says out loud that nothing was
 * copied. The preview has no clipboard to write to, and a button that claimed
 * otherwise would be the one control here that lies about what it did.
 */
interface Props {
  label: string;
  doneLabel?: string;
  /** Printed under the button, in the preview's own voice. */
  note?: string;
}

const { label, doneLabel = 'Copied', note } = Astro.props;
---

<div class="flex flex-col gap-2">
  <div class="flex flex-wrap items-center gap-3">
    <button
      type="button"
      class="btn btn-quiet"
      data-copy-button
      data-label={label}
      data-done-label={doneLabel}
    >
      {label}
    </button>
    <p class="sr-only" role="status" data-copy-status></p>
  </div>
  {note && <p class="max-w-2xl text-[11px] leading-relaxed font-medium text-ink-soft">{note}</p>}
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-button]')) {
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    let timer: ReturnType<typeof setTimeout> | undefined;

    button.addEventListener('click', () => {
      const done = button.dataset.doneLabel ?? 'Copied';
      button.textContent = done;
      if (status) status.textContent = `${done}. Scripted preview — the clipboard is untouched.`;
      clearTimeout(timer);
      timer = setTimeout(() => {
        button.textContent = button.dataset.label ?? '';
        if (status) status.textContent = '';
      }, 2400);
    });
  }
</script>
