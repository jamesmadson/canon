---
import AccountMenu from './AccountMenu.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PreviewLabel from './PreviewLabel.astro';
import { withBase } from '../lib/withBase';
import { PROJECT } from '../data/v2Preview';

/**
 * The platform chrome the v2 preview lives inside: a slim top bar, a left
 * sidebar, and one content well.
 *
 * Every row in the sidebar is a section that exists and a link that goes to it.
 * A disabled row that looks clickable would be the one lie this preview cannot
 * afford — the whole page is an argument that the product shows you what is
 * actually there — so a section either ships or is not in the list.
 */
interface Props {
  title: string;
  description: string;
  /**
   * Which sidebar row is the current page. Omitted on pages that sit beside
   * the product rather than inside a section — the flow map, for one — where
   * marking a row current would point at a page you are not on.
   */
  active?: 'overview' | 'prototypes' | 'research' | 'members';
}

const { title, description, active } = Astro.props;

const NAV = [
  { id: 'overview', label: 'Overview', href: '/v2-preview/' },
  { id: 'prototypes', label: 'Prototypes', href: '/v2-preview/#prototypes' },
  { id: 'research', label: 'Research', href: '/v2-preview/research/' },
  { id: 'members', label: 'Members', href: '/v2-preview/members/' },
] as const;

// One row height and one row shape for every sidebar entry, so the two live
// sections and the two that only say what they would be sit on the same grid.
const rowBase =
  'flex min-h-11 items-center rounded-sm px-3 text-[13px] font-semibold transition-[background-color,color] duration-[120ms] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink';
---

<BaseLayout title={title} description={description}>
  {/* The shell is a fill on the page, not a box with a line around it. The
      tokens are the site's now, so this element no longer opens a scope — it
      is just the ground the product sits on. */}
  <div data-app-frame class="overflow-hidden rounded-lg bg-ground text-ink">
    <PreviewLabel placement="top" />

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-rule px-4 py-2">
      <a
        href={withBase('/v2-preview/')}
        class="-mx-2 flex min-h-11 items-center px-2 text-[13px] font-semibold tracking-tight text-ink-soft transition-colors duration-[120ms] hover:text-ink focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
      >
        Canon
      </a>
      <span aria-hidden="true" class="text-rule">|</span>
      <p class="flex min-w-0 items-center gap-2 text-[13px] font-medium text-ink-soft">
        <span class="truncate">{PROJECT.team}</span>
        <span aria-hidden="true" class="text-rule-strong">/</span>
        <span class="truncate text-base font-semibold text-ink">{PROJECT.name}</span>
      </p>
      <AccountMenu />
    </div>

    <div class="flex flex-col md:flex-row">
      <nav
        aria-label="Project sections"
        class="shrink-0 border-b border-rule p-2 md:w-48 md:border-r md:border-b-0"
      >
        <ul class="flex flex-wrap gap-1 md:flex-col md:flex-nowrap">
          {NAV.map((item) => (
            <li class="md:w-full">
              <a
                href={withBase(item.href)}
                aria-current={active === item.id ? 'page' : undefined}
                class:list={[
                  rowBase,
                  active === item.id
                    ? 'bg-panel text-ink'
                    : 'text-ink-soft hover:bg-panel/60 hover:text-ink active:bg-panel',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="min-w-0 flex-1 px-4 py-6 sm:px-6">
        <slot />
      </div>
    </div>
  </div>

  <nav class="mt-8 flex flex-wrap gap-x-6 gap-y-1 text-sm font-medium" aria-label="Preview navigation">
    <slot name="footer-nav" />
    <a
      href={withBase('/alpha/')}
      class="flex min-h-11 items-center text-ink-soft underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      Back to the alpha page
    </a>
  </nav>
</BaseLayout>
