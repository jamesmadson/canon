---
/**
 * The logo: one solid orange circle. The dot is the brand, and the only hue
 * the chrome carries. The name itself is set large once, in the closing strip.
 */
interface Props {
  /** Diameter in px. */
  size?: number;
  class?: string;
}

const { size = 16, class: className = '' } = Astro.props;
---

<span aria-hidden="true" class:list={['wordmark-dot', className]} style={`width:${size}px;height:${size}px`}></span>
