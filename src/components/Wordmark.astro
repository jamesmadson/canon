---
/**
 * The logo: the name in Public Sans with the o drawn as a solid orange dot.
 * The dot is the brand, and the only hue the chrome carries.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: className = '' } = Astro.props;
---

<span role="img" aria-label="Canon" class:list={['wordmark', className]} style={`font-size:${size}px`}>
  <span aria-hidden="true">can</span><span aria-hidden="true" class="wordmark-dot"></span><span aria-hidden="true">n</span>
</span>
