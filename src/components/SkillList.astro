---
// The four skills as rows, in the order work does. The skills index renders
// this. With a mouse, hovering or focusing a row floats that skill's own
// preview beside the cursor, following it, so the row's words stay readable;
// the same SkillPreview the homepage shows.
import { getCollection } from 'astro:content';
import { withBase } from '../lib/withBase';
import { SKILL_LINES, ORDER } from '../lib/skillLines';
import SkillPreview from './SkillPreview.astro';

const skills = (await getCollection('skills', ({ data }) => data.status === 'active')).sort(
  (a, b) => ORDER.indexOf(a.data.slug) - ORDER.indexOf(b.data.slug),
);
---

<ul class="mt-10">
  {skills.map((s) => (
    <li class="skill-row">
      <a href={withBase(`/skills/${s.data.slug}/`)} class="skill-link grid grid-cols-1 gap-2 py-6 sm:grid-cols-12 sm:gap-12">
        <span class="display text-[28px] sm:col-span-4">{s.data.name}</span>
        <span class="max-w-[52ch] text-[16px] leading-[1.5] text-ink-soft sm:col-span-6" set:html={SKILL_LINES[s.data.slug] ?? s.data.tagline} />
        <span class="text-[14px] text-ink sm:col-span-2 sm:text-right">
          {s.data.previewType === 'page' ? 'Try it' : 'See what it made'}<span aria-hidden="true"> →</span>
        </span>
      </a>
      <div class="skill-preview" aria-hidden="true">
        <SkillPreview slug={s.data.slug} variant="hover" />
      </div>
    </li>
  ))}
</ul>

<style>
  .skill-row {
    position: relative;
    border-top: 1px solid var(--color-rule);
  }
  .skill-row:last-child {
    border-bottom: 1px solid var(--color-rule);
  }
  .skill-link {
    border-radius: var(--radius-sm);
  }
  .skill-link:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  /* The preview is hidden from everyone until a fine pointer hovers or focuses
     its row. Touch and coarse pointers never see it. */
  .skill-preview {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .skill-link {
      transition: opacity 160ms cubic-bezier(0.2, 0, 0, 1);
    }
    ul:has(.skill-link:is(:hover, :focus-visible)) .skill-link:not(:hover, :focus-visible) {
      opacity: 0.5;
    }
  }

  /* About 360 by 240. It sits below and to the right of the cursor and
     follows it (--x and --y, set by the script below, moved by translate so
     it never touches layout), flipping to the cursor's left near the list's
     right edge, so the words under the cursor stay readable. Keyboard focus
     has no cursor, so it starts under the skill's name. It floats above the
     rows, takes no pointer, and fades in over 320ms with a small rise and a
     scale; leaving takes 200ms. The display change is part of the
     transition, so the preview stays until it has faded. While it is display
     none, its lazy frame is not loaded. */
  @media (hover: hover) and (pointer: fine) and (min-width: 640px) {
    .skill-preview {
      position: absolute;
      z-index: 10;
      top: 0;
      left: 0;
      width: 360px;
      height: 240px;
      translate: var(--x, 0px) var(--y, 72px);
      pointer-events: none;
      opacity: 0;
      transform: translateY(8px) scale(0.96);
      transform-origin: top left;
      transition:
        opacity 200ms cubic-bezier(0.2, 0, 0, 1),
        transform 200ms cubic-bezier(0.2, 0, 0, 1),
        display 200ms allow-discrete;
    }
    /* The text cards take the height of their words, as on the homepage,
       so Strata's Said and Meant are never cut off. */
    .skill-preview:has(.frame-strata, .frame-prune) {
      height: auto;
    }
    .skill-link:is(:hover, :focus-visible) + .skill-preview {
      display: block;
      opacity: 1;
      transform: none;
      transition-duration: 320ms;
    }
    @starting-style {
      .skill-link:is(:hover, :focus-visible) + .skill-preview {
        opacity: 0;
        transform: translateY(8px) scale(0.96);
      }
    }
  }

  /* Reduced motion keeps the fades and drops the rise and the scale. */
  @media (hover: hover) and (pointer: fine) and (min-width: 640px) and (prefers-reduced-motion: reduce) {
    .skill-preview {
      transform: none;
    }
    @starting-style {
      .skill-link:is(:hover, :focus-visible) + .skill-preview {
        transform: none;
      }
    }
  }
</style>

<script>
  // The preview trails the cursor a little, easing toward it each frame, so
  // it glides rather than snaps. With reduced motion it sits at the cursor
  // with no easing. Only a fine pointer ever sees a preview.
  const OFFSET = 24;
  const WIDTH = 360;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const row of document.querySelectorAll<HTMLElement>('.skill-row')) {
    const preview = row.querySelector<HTMLElement>('.skill-preview');
    if (!preview) continue;
    let target = { x: 0, y: 0 };
    let at: { x: number; y: number } | null = null;
    let frame = 0;

    const place = (x: number, y: number) => {
      preview.style.setProperty('--x', `${x}px`);
      preview.style.setProperty('--y', `${y}px`);
    };
    const step = () => {
      frame = 0;
      if (!at) return;
      at.x += (target.x - at.x) * 0.2;
      at.y += (target.y - at.y) * 0.2;
      place(at.x, at.y);
      if (Math.abs(target.x - at.x) > 0.5 || Math.abs(target.y - at.y) > 0.5) frame = requestAnimationFrame(step);
    };

    row.addEventListener('pointermove', (event) => {
      if (!fine.matches) return;
      const box = row.getBoundingClientRect();
      const x = event.clientX - box.left;
      const y = event.clientY - box.top;
      // Right of the cursor while it fits inside the row, otherwise left.
      const left = x + OFFSET + WIDTH > box.width ? x - OFFSET - WIDTH : x + OFFSET;
      target = { x: left, y: y + OFFSET };
      // The first move after entering places it outright: it is still faded
      // out, and a glide in from the last row's spot would read as a jump.
      if (!at || still.matches) {
        at = { ...target };
        place(at.x, at.y);
        return;
      }
      if (!frame) frame = requestAnimationFrame(step);
    });
    row.addEventListener('pointerleave', () => {
      at = null;
      cancelAnimationFrame(frame);
      frame = 0;
    });
    // Focus from the keyboard: under the skill's name, where it always was.
    row.addEventListener('focusin', () => {
      if (at) return;
      preview.style.removeProperty('--x');
      preview.style.removeProperty('--y');
    });
  }
</script>
