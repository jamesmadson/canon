---
/**
 * A four-step walkthrough of the Canon MCP, in one panel: the agent session on
 * the left, what Canon shows on the right. Without script every step is shown,
 * stacked. With script it is a carousel: one step at a time, cross-fading in
 * place, advancing on its own when the progress bar under the active tab fills,
 * unless the reader is pointing at it, has keyboard focus in it, has scrolled
 * it mostly out of view, has hidden the tab, pressed Pause, or prefers reduced
 * motion. It never scrolls sideways.
 */
const STEPS = [
  { title: 'Ask', note: 'Say it in your agent session, in plain&nbsp;words.' },
  { title: 'Approve', note: 'First time only. Canon asks before the agent can do&nbsp;anything.' },
  { title: 'It appears', note: 'The prototype shows up on the board, still running where it&nbsp;was.' },
  { title: 'Get a link', note: 'Ask for a view and get a link to&nbsp;it.' },
];
const MOCK_ALT = [
  'A Canon board, still empty.',
  'A Canon board, still empty.',
  'The Checkout board with one prototype on it, and a notice: Claude Code added Checkout.',
  'The Checkout prototype open full screen at 390 pixels wide.',
];
---

<section
  id="agents"
  class="mx-auto max-w-6xl scroll-mt-8 px-6 pb-24 sm:pb-32"
  aria-labelledby="mcp-heading"
  data-mcp
>
  <div class="max-w-3xl">
    <h2 id="mcp-heading" class="display-lg max-w-[20ch]">The agent that built it can file&nbsp;it.</h2>
    <p class="mt-5 max-w-[44ch] text-[18px] leading-[1.45] text-ink-soft">
      <code class="font-mono text-[15px] text-ink">canon mcp</code> lets Claude Code, Codex or Cursor
      put a prototype on a board, push a new version, or hand you a link to one screen at phone width.
      Canon points at your prototype where it already runs. It does not host&nbsp;it.
    </p>
    <p class="mt-4 font-mono text-[11px] leading-[1.6] tracking-[0.08em] text-ink-soft">
      Coming with the alpha. Not released&nbsp;yet.
    </p>
  </div>

  <div class="carousel mt-10" data-mcp-carousel>
    <div class="panel" data-mcp-panel>
      <div class="stage" aria-live="off" data-mcp-stage>
        {STEPS.map((s, i) => (
          <article class="scene" id={`mcp-scene-${i}`} data-step={i}>
            <div class="term" role="group" aria-label="Agent session">
              <header class="row" style="--i:0">
                <p class="label">Step {i + 1}. {s.title}</p>
                <p class="mt-1 text-[14px] leading-[1.45] text-ink-soft" set:html={s.note} />
              </header>

              {i === 0 && (
                <>
                  <div class="row turn" style="--i:1">
                    <p class="who">you</p>
                    <p>Add localhost:5173 to Canon, on a board called&nbsp;Checkout.</p>
                  </div>
                  <div class="row turn" style="--i:2">
                    <p class="who">claude code</p>
                    <p>Working on&nbsp;it.</p>
                  </div>
                </>
              )}
              {i === 1 && (
                <>
                  <div class="row turn" style="--i:1">
                    <p class="who">claude code</p>
                    <p>Canon needs you to approve me first. Open this&nbsp;link:</p>
                    <p class="code">…/canon/app/#pair=claude-code.47800.…</p>
                  </div>
                  <div class="row ask" style="--i:2">
                    <p class="text-ink">Connect Claude Code to&nbsp;Canon?</p>
                    <p class="mt-1 text-[13px] leading-[1.45] text-ink-soft">
                      It can add and update prototypes and open views. It can't delete anything or read
                      your&nbsp;files.
                    </p>
                    <div class="mt-3 flex gap-2">
                      <span class="chip chip-on">Connect</span>
                      <span class="chip">Cancel</span>
                    </div>
                  </div>
                </>
              )}
              {i === 2 && (
                <div class="row turn" style="--i:1">
                  <p class="who">claude code</p>
                  <p>Added it to the Checkout&nbsp;board.</p>
                </div>
              )}
              {i === 3 && (
                <>
                  <div class="row turn" style="--i:1">
                    <p class="who">you</p>
                    <p>Give me the link to it at phone&nbsp;width.</p>
                  </div>
                  <div class="row turn" style="--i:2">
                    <p class="who">claude code</p>
                    <p>Here you&nbsp;go:</p>
                    <p class="code">…/canon/app/#b/checkout/f/app/full?w=390</p>
                  </div>
                </>
              )}
            </div>

            <div class="mock" role="img" aria-label={MOCK_ALT[i]}>
              <span class="mock-chip">{i === 3 ? '390 · Checkout' : 'Checkout · Board'}</span>
              {i < 2 && (
                <div class="mock-body">
                  <div class="empty">Nothing here yet</div>
                </div>
              )}
              {i === 2 && (
                <div class="mock-body">
                  <div class="card appear">
                    <p class="card-cap">Checkout <small>localhost:5173</small></p>
                    <div class="paper landscape">
                      <span class="bar title"></span>
                      <span class="bar"></span>
                      <span class="grow"></span>
                      <span class="pill"></span>
                    </div>
                  </div>
                  <p class="notice appear-late">Claude Code added&nbsp;Checkout</p>
                </div>
              )}
              {i === 3 && (
                <div class="mock-body">
                  <div class="paper phone grow-in">
                    <span class="bar title"></span>
                    <span class="input"></span>
                    <span class="input"></span>
                    <span class="grow"></span>
                    <span class="pill"></span>
                  </div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="controls" data-mcp-nav>
      <div class="tabs" role="tablist" aria-label="Steps">
        {STEPS.map((s, i) => (
          <button
            type="button"
            class="tab"
            role="tab"
            id={`mcp-tab-${i}`}
            aria-controls={`mcp-scene-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-step-btn={i}
          >
            <span class="tab-cap">{s.title}</span>
            <span class="track"><span class="fill" data-fill></span></span>
          </button>
        ))}
      </div>
      <button type="button" class="btn btn-quiet toggle" data-mcp-toggle aria-pressed="false">Pause</button>
    </div>
  </div>
</section>

<style>
  .panel {
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule);
    background-color: var(--color-panel);
  }
  .stage {
    display: flex;
    flex-direction: column;
  }
  .scene {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    /* Stacked, any spare height goes to the session, not the board. */
    grid-template-rows: 1fr auto;
  }
  .scene + .scene {
    border-top: 1px solid var(--color-rule);
  }
  @media (min-width: 768px) {
    .scene {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: none;
    }
    .term {
      grid-column: span 7;
    }
    .mock {
      grid-column: span 5;
    }
  }

  /* The agent session. */
  .term {
    min-width: 0;
    padding: 22px 20px 26px;
    color: var(--color-ink);
    font-size: 15px;
    line-height: 1.45;
  }
  @media (min-width: 640px) {
    .term {
      padding: 28px 32px 32px;
    }
  }
  .term > * + * {
    margin-top: 18px;
  }
  .who {
    margin-bottom: 4px;
    font-family: var(--font-app-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }
  .code {
    margin-top: 8px;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background-color: var(--color-recess);
    font-family: var(--font-app-mono);
    font-size: 12px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .ask {
    padding: 14px;
    border-radius: var(--radius-md);
    box-shadow: inset 0 0 0 1px var(--color-rule-strong);
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding-inline: 14px;
    border-radius: 999px;
    background-color: var(--color-recess);
    color: var(--color-ink);
    font-size: 13px;
  }
  .chip-on {
    background-color: var(--color-ink);
    color: var(--color-ground);
  }

  /* What Canon shows: the board's dotted canvas, light prototypes on it. */
  .mock {
    --paper: var(--color-panel);
    --paper-ink: #1a1815;
    --paper-line: #e2e0d9;
    position: relative;
    min-width: 0;
    min-height: 240px;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-rule);
    background-color: var(--color-ground);
    background-image: radial-gradient(var(--color-rule) 1px, transparent 1px);
    background-size: 14px 14px;
    background-position: 7px 7px;
    font-size: 13px;
  }
  :global(:root[data-app-theme='dark']) .mock {
    --paper: #f5f4ef;
  }
  @media (min-width: 768px) {
    .mock {
      border-top: 0;
      border-left: 1px solid var(--color-rule);
    }
  }
  .mock-chip {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 2px 8px;
    border-radius: 5px;
    background-color: var(--color-recess);
    color: var(--color-ink-soft);
    font-family: var(--font-app-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
  }
  .mock-body {
    flex: 1;
    position: relative;
    display: grid;
    place-items: center;
    padding: 48px 20px 64px;
  }
  .empty {
    padding: 22px 26px;
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-rule-strong);
    color: var(--color-ink-soft);
  }
  .card {
    width: min(100%, 210px);
  }
  .card-cap {
    margin-bottom: 6px;
    font-size: 12px;
    color: var(--color-ink-soft);
  }
  .card-cap small {
    margin-left: 4px;
    font-family: var(--font-app-mono);
    font-size: 10px;
  }
  .paper {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 12px;
    border-radius: var(--radius-md);
    background-color: var(--paper);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.06);
  }
  .paper.landscape {
    aspect-ratio: 4 / 3;
  }
  .paper.phone {
    width: 116px;
    height: 200px;
  }
  .bar {
    display: block;
    width: 40%;
    height: 4px;
    border-radius: 2px;
    background-color: var(--paper-line);
  }
  .bar.title {
    width: 66%;
    height: 7px;
    background-color: color-mix(in oklab, var(--paper-ink) 70%, var(--paper));
  }
  .input {
    display: block;
    height: 18px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px var(--paper-line);
  }
  .grow {
    flex: 1;
  }
  .pill {
    display: block;
    height: 14px;
    border-radius: 999px;
    background-color: var(--paper-ink);
  }
  .notice {
    position: absolute;
    right: 14px;
    bottom: 14px;
    max-width: calc(100% - 28px);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    background-color: var(--color-ink);
    color: var(--color-ground);
    font-size: 12px;
  }

  /* The steps under the panel: a caption and a thin track per step. The
     active track fills over the interval; the fill animates transform only,
     and its end is what advances the carousel. */
  .controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
  }
  .tabs {
    flex: 1;
    min-width: 0;
    display: flex;
    gap: 8px;
  }
  .tab {
    flex: 1;
    min-width: 0;
    max-width: 140px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    min-height: 48px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    text-align: left;
    color: var(--color-ink-soft);
    transition: color 220ms cubic-bezier(0.2, 0, 0, 1);
  }
  .tab:hover,
  .tab[aria-selected='true'] {
    color: var(--color-ink);
  }
  .tab:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  .tab-cap {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
    line-height: 1.2;
  }
  .track {
    position: relative;
    display: block;
    height: 2px;
    border-radius: 1px;
    background-color: var(--color-rule);
    overflow: hidden;
  }
  .fill {
    position: absolute;
    inset: 0;
    background-color: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .tab[aria-selected='true'] .fill {
    transform: scaleX(1);
  }
  .toggle {
    flex-shrink: 0;
    min-width: 44px;
    padding-inline: 12px;
    font-size: 13px;
  }

  [data-mcp]:not(.js) [data-mcp-nav] {
    display: none;
  }

  /* With script: the steps overlap in one grid cell and cross-fade. The stage
     keeps the height of the tallest step so nothing jumps. */
  [data-mcp].js .stage {
    display: grid;
  }
  [data-mcp].js .scene {
    grid-area: 1 / 1;
    border-top: 0;
    opacity: 0;
    visibility: hidden;
  }
  [data-mcp].js .scene[data-active] {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-mcp].playing .tab[aria-selected='true'] .fill {
      transform: scaleX(0);
      animation: mcp-fill var(--mcp-interval, 6000ms) linear forwards;
    }
    [data-mcp].playing[data-paused] .tab[aria-selected='true'] .fill {
      animation-play-state: paused;
    }

    /* Outgoing fades only; incoming fades and rises a little. */
    [data-mcp].js .scene {
      transition:
        opacity 560ms cubic-bezier(0.2, 0, 0, 1),
        transform 560ms cubic-bezier(0.2, 0, 0, 1),
        visibility 0s linear 560ms;
    }
    [data-mcp].js .scene:not([data-active]):not([data-leaving]) {
      transform: translateY(6px);
    }
    [data-mcp].js .scene[data-active] {
      transform: none;
      transition-delay: 0s;
    }

    /* Inside the incoming step: the session rows rise one after another, and
       Canon's side answers once the agent has spoken. */
    [data-mcp].js .scene[data-active] .row {
      animation: mcp-rise 360ms cubic-bezier(0.2, 0, 0, 1) both;
      animation-delay: calc(120ms + var(--i, 0) * 90ms);
    }
    [data-mcp].js .scene[data-active] .appear {
      animation: mcp-rise 420ms cubic-bezier(0.2, 0, 0, 1) 600ms both;
    }
    [data-mcp].js .scene[data-active] .appear-late {
      animation: mcp-rise 420ms cubic-bezier(0.2, 0, 0, 1) 900ms both;
    }
    [data-mcp].js .scene[data-active] .grow-in {
      animation: mcp-grow 480ms cubic-bezier(0.2, 0, 0, 1) 500ms both;
    }

    @keyframes mcp-fill {
      to {
        transform: scaleX(1);
      }
    }
    @keyframes mcp-rise {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes mcp-grow {
      from {
        opacity: 0.4;
        transform: scale(0.72);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
  }
</style>

<script>
  const INTERVAL = 6000;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-mcp]').forEach((root) => {
    const carousel = root.querySelector<HTMLElement>('[data-mcp-carousel]')!;
    const panel = root.querySelector<HTMLElement>('[data-mcp-panel]')!;
    const stage = root.querySelector<HTMLElement>('[data-mcp-stage]')!;
    const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-step-btn]'));
    const toggle = root.querySelector<HTMLButtonElement>('[data-mcp-toggle]')!;
    root.style.setProperty('--mcp-interval', `${INTERVAL}ms`);

    scenes.forEach((s, i) => {
      s.setAttribute('role', 'tabpanel');
      s.setAttribute('aria-labelledby', `mcp-tab-${i}`);
    });

    let cur = 0;
    let userPaused = false; // the Pause button
    let hover = false;
    let focusIn = false;
    let inView = true;
    let tabShown = !document.hidden;

    const canPlay = () => !reduce.matches && !userPaused;
    const holding = () => hover || focusIn || !inView || !tabShown;

    // Classes and attributes follow state; the CSS fill does the timing.
    const sync = () => {
      root.classList.toggle('playing', !reduce.matches);
      root.toggleAttribute('data-paused', userPaused || holding());
      toggle.textContent = userPaused ? 'Play' : 'Pause';
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.hidden = reduce.matches;
    };

    const go = (n: number, { auto = false, focus = false } = {}) => {
      const to = (n + scenes.length) % scenes.length;
      const from = cur;
      cur = to;
      scenes.forEach((s, i) => {
        s.toggleAttribute('data-leaving', i === from && from !== to);
        s.toggleAttribute('data-active', i === cur);
        s.inert = i !== cur;
      });
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === cur));
        t.tabIndex = i === cur ? 0 : -1;
      });
      if (focus) tabs[cur].focus();
      stage.setAttribute('aria-live', auto && canPlay() ? 'off' : 'polite');
      // Restart the fill for the new step.
      const fill = tabs[cur].querySelector<HTMLElement>('[data-fill]')!;
      fill.style.animation = 'none';
      void fill.offsetWidth;
      fill.style.animation = '';
      sync();
    };

    // The end of the fill is the one clock: pause it and the step waits too.
    root.addEventListener('animationend', (e) => {
      const t = e.target as HTMLElement;
      if (!t.matches('[data-fill]') || !tabs[cur].contains(t)) return;
      if (canPlay() && !holding()) go(cur + 1, { auto: true });
    });

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => go(i));
      t.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowRight: cur + 1, ArrowLeft: cur - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in keys)) return;
        e.preventDefault();
        go(keys[e.key], { focus: true });
      });
    });
    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      stage.setAttribute('aria-live', userPaused ? 'polite' : 'off');
      sync();
    });

    carousel.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch') return;
      hover = true;
      sync();
    });
    carousel.addEventListener('pointerleave', () => {
      hover = false;
      sync();
    });
    // Keyboard focus holds the step; a mouse click on a tab does not, so the
    // carousel keeps going after you pick a step.
    carousel.addEventListener('focusin', (e) => {
      focusIn = (e.target as HTMLElement).matches(':focus-visible');
      sync();
    });
    carousel.addEventListener('focusout', (e) => {
      if (e.relatedTarget && carousel.contains(e.relatedTarget as Node)) return;
      focusIn = false;
      sync();
    });
    new IntersectionObserver(
      ([entry]) => {
        inView = entry.intersectionRatio >= 0.4;
        sync();
      },
      { threshold: [0, 0.4, 1] },
    ).observe(panel);
    document.addEventListener('visibilitychange', () => {
      tabShown = !document.hidden;
      sync();
    });
    reduce.addEventListener('change', sync);

    root.classList.add('js');
    go(0);
  });
</script>
