---
import { getCollection, type CollectionEntry } from 'astro:content';
import { withBase } from '../lib/withBase';

interface Props {
  kit: CollectionEntry<'kits'>;
}

const { kit } = Astro.props;
const { name, tagline, slug, phases } = kit.data;
// Count only what the kit page will actually list, so the card can't promise
// ten skills and show nine.
const activeSlugs = new Set(
  (await getCollection('skills', ({ data }) => data.status === 'active')).map((s) => s.data.slug)
);
const skillCount = phases.reduce(
  (n, phase) => n + phase.entries.filter((e) => activeSlugs.has(e.skill)).length,
  0
);
---

<a href={withBase(`/kits/${slug}/`)} class="group flex flex-col gap-2 border-r border-b border-rule bg-bg p-4 transition-colors hover:bg-surface/60 focus-visible:outline-2 focus-visible:outline-ink focus-visible:-outline-offset-2">
  <h3 class="text-base font-semibold text-ink">{name}</h3>
  <p class="text-[13px] font-medium leading-snug text-ink-soft">{tagline}</p>
  <p class="mt-1 text-[11px] font-medium text-ink-soft">
    {phases.length} {phases.length === 1 ? 'phase' : 'phases'} · {skillCount} skills
  </p>
</a>
