---
import ScreenArt from './ScreenArt.astro';
import { withBase } from '../lib/withBase';
import { daysIdle, idleLabel, isStale } from '../lib/staleness';
import { PREVIEW_AS_OF, sourceLine, type Prototype } from '../data/v2Preview';

/**
 * The narrow form of a prototype: the screen, small, then its name and where
 * it came from. Used in the three-pane preview on /alpha, where a card grid
 * would not fit a third of the width.
 */
interface Props {
  prototype: Prototype;
}

const { prototype } = Astro.props;
const stale = isStale(prototype.lastActivity, PREVIEW_AS_OF);
const idle = daysIdle(prototype.lastActivity, PREVIEW_AS_OF);
const source = sourceLine(prototype);
---

<a
  href={withBase(`/v2-preview/${prototype.slug}/`)}
  class="group flex min-h-11 items-start gap-3 border-b border-rule bg-bg px-4 py-3 transition-colors hover:bg-surface/60 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
>
  <span
    class:list={[
      'block w-9 shrink-0 overflow-hidden rounded-[3px] border bg-bg',
      prototype.screen ? 'border-rule-strong' : 'border-dashed border-rule-strong',
    ]}
  >
    <span class="block aspect-[390/844]">
      {prototype.screen && <ScreenArt screen={prototype.screen} w={390} h={844} />}
    </span>
  </span>

  <span class="flex min-w-0 flex-1 flex-col gap-1">
    <span class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
      <span class="text-[15px] font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors group-hover:decoration-ink">
        {prototype.name}
      </span>
      {stale && (
        <span class="rounded-sm border border-rule-strong px-2 py-0.5 text-[11px] font-semibold tracking-wide text-ink tabular-nums">
          Idle {idle} days
        </span>
      )}
    </span>

    <span
      class:list={[
        'block break-all text-[11px] text-ink-soft',
        source.mono ? 'font-mono' : 'font-medium',
      ]}
    >
      {source.text}
    </span>

    <span class="block text-[11px] font-medium text-ink-soft tabular-nums">
      {prototype.author} · {idleLabel(prototype.lastActivity, PREVIEW_AS_OF)}
    </span>
  </span>
</a>
