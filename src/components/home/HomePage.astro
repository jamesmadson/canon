---
import Hero from './Hero.astro';
import HeroScatter from './HeroScatter.astro';
import WaysIn from './WaysIn.astro';
import AgentBand from './AgentBand.astro';
import FindBand from './FindBand.astro';
import OpenBand from './OpenBand.astro';
import Plans from './Plans.astro';

interface Props {
  waitlistUrl?: string;
  /** Which hero opens the page. The scatter one is the alternate at /hero-b/. */
  hero?: 'terminal' | 'scatter';
}
const { waitlistUrl = '', hero = 'terminal' } = Astro.props;
---

<div class="home">
  <div class="wrap">
    {hero === 'scatter' ? <HeroScatter waitlistUrl={waitlistUrl} /> : <Hero waitlistUrl={waitlistUrl} />}
    <WaysIn />
    <AgentBand />
    <FindBand />
    <OpenBand />
    <Plans waitlistUrl={waitlistUrl} />
  </div>
</div>

<script>
  import '../../scripts/home';
</script>
