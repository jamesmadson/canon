---
import Hero from './Hero.astro';
import HeroScatter from './HeroScatter.astro';
import WorksWith from './WorksWith.astro';
import WaysIn from './WaysIn.astro';
import AgentBand from './AgentBand.astro';
import FindBand from './FindBand.astro';
import OpenBand from './OpenBand.astro';
import Plans from './Plans.astro';

interface Props {
  waitlistUrl?: string;
  /** Which hero opens the page. Tabs is the homepage hero. The terminal one is the earlier hero, kept at /hero-a/. */
  hero?: 'scatter' | 'terminal' | 'cards' | 'tabs';
}
const { waitlistUrl = '', hero = 'tabs' } = Astro.props;
---

<div class="home">
  <div class="wrap">
    {hero === 'terminal' ? <Hero waitlistUrl={waitlistUrl} /> : <HeroScatter waitlistUrl={waitlistUrl} variant={hero} />}
    <WorksWith />
    <WaysIn />
    <AgentBand />
    <FindBand />
    <OpenBand />
    <Plans waitlistUrl={waitlistUrl} />
  </div>
</div>

<script>
  import '../../scripts/home';
</script>
