---
/**
 * Styles for the tabs hero (the homepage) and the hidden /hero-c/ (cards past
 * the edges) (the homepage). They sit on top of HeroScatter's styles and its
 * script. Everything that moves changes only transform and opacity, on one
 * curve. The markup holds the final state, so no script and reduced motion
 * both show it.
 */
---

<style is:global>
  /* ---- Both: one curve, no spring, and the glide stays inside 400ms ---- */
  .hero-c .sstage.live .scard,
  .hero-tabs .sstage.live .scard {
    transition:
      transform 400ms cubic-bezier(0.2, 0, 0, 1),
      opacity 300ms cubic-bezier(0.2, 0, 0, 1);
  }

  /* ---- hero-c: cards past the edges ---- */
  /* The cards may cross the container and the viewport. The page clips them at
     the viewport, so nothing can add a horizontal scroll. */
  .hero-c .sclip {
    clip-path: inset(-700px -50vw 0 -50vw);
  }
  .xcards {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .xcard {
    position: absolute;
    left: calc(var(--fx) * 100%);
    top: var(--fy);
    width: 280px;
    margin: -87px 0 0 -140px;
    transform: rotate(var(--rot)) scale(var(--sc));
    opacity: 0;
  }
  .xcard.xphone {
    display: none;
  }
  .xcard .sh {
    aspect-ratio: 16 / 10;
  }
  .sstage.live .xcard {
    transition: opacity 300ms cubic-bezier(0.2, 0, 0, 1);
  }
  .sstage.live:not(.is-filed) .xcard {
    opacity: 1;
  }
  .sstage.live.out .xcard {
    opacity: 0;
  }
  /* Nearer cards throw a stronger shadow. */
  .hero-c .sstage.live:not(.is-filed) .sh {
    opacity: var(--dep, 1);
  }
  .hero-c .sstage.live .xcard .sh {
    transition: none;
  }
  @media (max-width: 960px) {
    .xcard {
      display: none;
      width: 150px;
      margin: -47px 0 0 -75px;
    }
    .xcard.xphone {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .xcard {
      display: none !important;
    }
  }

  /* ---- hero-tabs: the 30 tabs ---- */
  .hero-tabs .sstage {
    height: 876px;
  }
  .hero-tabs .sbg,
  .hero-tabs .chip,
  .hero-tabs .sh {
    display: none;
  }
  .bframe {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background: var(--wn-rail);
    box-shadow:
      0 0 0 1px var(--edge),
      inset 0 1px 0 var(--hi),
      0 40px 100px -24px var(--shadow);
  }
  .bdots {
    position: absolute;
    left: 16px;
    top: 17px;
    display: flex;
    gap: 7px;
  }
  .bdots i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--wn-line-strong);
  }
  .btabs {
    position: absolute;
    left: 76px;
    right: 14px;
    top: 8px;
    height: 32px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 1px;
  }
  .btab {
    min-width: 0;
  }
  /* While the loop is running, tabs that have not opened yet take no room. */
  .btab.gone {
    display: none;
  }
  .btab-in {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 5px;
    border-radius: 8px 8px 0 0;
    background: color-mix(in srgb, var(--color-ink) 7%, var(--wn-rail));
    color: var(--color-ink-soft);
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
    overflow: hidden;
  }
  .btab-in span {
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, #000 60%, transparent 100%);
    mask-image: linear-gradient(to right, #000 60%, transparent 100%);
  }
  .bico {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--tint);
    box-shadow: inset 0 0 0 1px rgba(26, 25, 24, 0.14);
  }
  .btab[data-n='0'] .btab-in {
    background: var(--wn-main);
    color: var(--color-ink);
  }
  .canon-tab {
    position: absolute;
    left: 0;
    top: 0;
    width: 180px;
  }
  .canon-tab .btab-in {
    background: var(--wn-main);
    color: var(--color-ink);
    padding: 0 12px;
    gap: 8px;
  }
  .canon-tab .btab-in span {
    -webkit-mask-image: none;
    mask-image: none;
  }
  .canon-tab .bico {
    background: var(--sel);
    box-shadow: none;
    border-radius: 50%;
  }
  .bbarline {
    position: absolute;
    left: 0;
    right: 0;
    top: 40px;
    height: 36px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 14px;
    background: var(--wn-main);
  }
  .bnav-dots {
    display: flex;
    gap: 8px;
  }
  .bnav-dots i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--wn-line-strong);
  }
  .burl {
    flex: 1;
    height: 22px;
    border-radius: 11px;
    background: var(--wn-panel);
  }
  .hero-tabs .sapp {
    margin-top: 76px;
    height: calc(100% - 76px);
  }
  .hero-tabs .sapp .wn-rail {
    align-self: stretch;
    background: var(--wn-rail);
    border-right: 1px solid var(--wn-line);
  }
  .hero-tabs .sapp .wn-main {
    margin: 0;
  }

  /* The final state: only the Canon tab is left in the strip. */
  .btab:not(.canon-tab) .btab-in {
    opacity: 0;
  }
  .sstage.live .btab-in {
    transition:
      opacity 240ms cubic-bezier(0.2, 0, 0, 1),
      transform 400ms cubic-bezier(0.2, 0, 0, 1);
    transition-delay: var(--d, 0s);
  }
  .sstage.live:not(.is-filed) .btab:not(.canon-tab) .btab-in {
    opacity: 1;
    transition-delay: 0s;
  }
  .sstage.live:not(.is-filed) .canon-tab .btab-in {
    opacity: 0;
    transition-delay: 0s;
  }
  /* Tabs lift out as the cards take their place. */
  .sstage.live.is-filed .btab:not(.canon-tab) .btab-in {
    transform: translateY(-8px);
  }
  .sstage.live.is-filed .canon-tab .btab-in {
    transition-delay: 0.45s;
  }
  .sstage.live.out .btab:not(.canon-tab) .btab-in,
  .sstage.live.out .canon-tab .btab-in {
    opacity: 0;
    transition-delay: 0s;
  }
  /* A tab that has just opened fades in. */
  .sstage.live .btab.pre:not(.canon-tab) .btab-in {
    opacity: 0;
  }
  /* The cards start as their tab, so loose they are invisible. */
  .hero-tabs .sstage.live:not(.is-filed) .scard {
    opacity: 0;
  }
  .hero-tabs .sstage.live.out .scard {
    opacity: 0;
  }

  /* A prototype page open in the active tab, behind the window until the cards
     file in. */
  .burl {
    display: flex;
    align-items: center;
    padding: 0 12px;
    font-size: 12px;
    line-height: 1;
    color: var(--color-ink-soft);
    overflow: hidden;
    white-space: nowrap;
  }
  .burl-text {
    opacity: 0;
  }
  .bpage {
    position: absolute;
    inset: 76px 0 0;
    padding: 0 40px;
    border-radius: 0 0 14px 14px;
    background: var(--wn-main);
    overflow: hidden;
    opacity: 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--color-ink);
  }
  .pg-nav {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
    max-width: 920px;
    margin: 0 auto;
    color: var(--color-ink-soft);
  }
  .pg-nav b {
    margin-right: auto;
    font-size: 16px;
    color: var(--color-ink);
  }
  .pg-nav em {
    font-style: normal;
    padding: 6px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--wn-line-strong);
    color: var(--color-ink);
  }
  .pg-head {
    max-width: 920px;
    margin: 56px auto 0;
    text-align: center;
  }
  .pg-head h3 {
    margin: 0;
    font-size: 44px;
    line-height: 48px;
    font-weight: 400;
    text-wrap: balance;
  }
  .pg-head p {
    margin: 12px 0 0;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-ink-soft);
  }
  .pg-switch {
    display: inline-flex;
    margin-top: 24px;
    padding: 3px;
    border-radius: 999px;
    background: var(--wn-raised);
  }
  .pg-switch span {
    padding: 5px 16px;
    border-radius: 999px;
    color: var(--color-ink-soft);
  }
  .pg-switch .on {
    background: var(--wn-main);
    color: var(--color-ink);
    box-shadow: 0 1px 2px var(--shadow);
  }
  .pg-plans {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 920px;
    margin: 40px auto 0;
  }
  .pg-plan {
    padding: 22px;
    border-radius: 14px;
    background: var(--wn-panel);
    box-shadow: inset 0 0 0 1px var(--wn-line);
  }
  .pg-plan.pg-pick {
    box-shadow: inset 0 0 0 2px var(--color-ink);
  }
  .pg-plan b {
    display: block;
    font-weight: 500;
  }
  .pg-plan strong {
    display: inline-block;
    margin-top: 10px;
    font-size: 36px;
    line-height: 40px;
    font-weight: 400;
  }
  .pg-plan small {
    display: block;
    color: var(--color-ink-soft);
    font-size: 12px;
  }
  .pg-plan ul {
    margin: 16px 0 20px;
    padding: 0;
    list-style: none;
    color: var(--color-ink-soft);
  }
  .pg-plan li {
    padding: 3px 0;
  }
  .pg-plan > span {
    display: block;
    padding: 9px 0;
    border-radius: 999px;
    text-align: center;
    box-shadow: inset 0 0 0 1px var(--wn-line-strong);
  }
  .pg-plan > .pg-cta {
    background: var(--color-ink);
    color: var(--wn-main);
    box-shadow: none;
  }
  .sstage.live .bpage,
  .sstage.live .burl-text {
    transition: opacity 300ms cubic-bezier(0.2, 0, 0, 1);
  }
  .sstage.live:not(.is-filed) .bpage,
  .sstage.live:not(.is-filed) .burl-text {
    opacity: 1;
  }
  .sstage.live.out .bpage,
  .sstage.live.out .burl-text {
    opacity: 0;
  }

  @media (max-width: 960px) {
    .hero-tabs .sstage {
      height: 716px;
    }
    .bdots {
      display: none;
    }
    .btabs {
      left: 12px;
      right: 12px;
    }
    .btab:nth-child(n + 13):not(.canon-tab) {
      display: none;
    }
    .canon-tab {
      width: 150px;
    }
    .bpage {
      padding: 0 20px;
    }
    .pg-nav {
      gap: 16px;
      height: 52px;
    }
    .pg-nav span {
      display: none;
    }
    .pg-head {
      margin-top: 28px;
    }
    .pg-head h3 {
      font-size: 30px;
      line-height: 34px;
    }
    .pg-switch {
      margin-top: 16px;
    }
    .pg-plans {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
      margin-top: 24px;
    }
    .pg-plan {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 12px;
      padding: 12px 16px;
    }
    .pg-plan b,
    .pg-plan small {
      grid-column: 1;
    }
    .pg-plan strong {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin: 0;
    }
    .pg-plan ul,
    .pg-plan > span {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .btab:not(.canon-tab) .btab-in,
    .bpage,
    .burl-text {
      opacity: 0 !important;
    }
    .canon-tab .btab-in {
      opacity: 1 !important;
      transform: none !important;
    }
    .btab-in {
      transition: none !important;
    }
  }
</style>
