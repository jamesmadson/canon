---
import { tie } from '../../lib/words';

/**
 * Where prototypes come from, as names set in type. No logos and no brand
 * colours. Three static lists on the page's 12-column grid; the names wrap as
 * a tidy grid when a column is narrow and nothing scrolls or cycles.
 */
const GROUPS = [
  {
    id: 'ww-links',
    label: 'Paste a link from',
    names: ['Lovable', 'Figma Make', 'Framer', 'v0', 'Bolt', 'Replit', 'GitHub Pages', 'Vercel', 'Netlify'],
    wide: true,
  },
  { id: 'ww-agents', label: 'Add with your agent', names: ['Claude Code', 'Codex', 'Cursor'], wide: false },
  { id: 'ww-drop', label: 'Or drop', names: ['a zip', 'a folder'], wide: false },
];
---

<section class="works" aria-label="What Canon works with">
  <div class="ww-groups">
    {
      GROUPS.map((g) => (
        <div class:list={['ww-group', g.wide && 'ww-wide']}>
          <p class="ww-label" id={g.id}>{tie(g.label)}</p>
          <ul class="ww-list" role="list" aria-labelledby={g.id}>
            {g.names.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="ww-note">{tie('v0 links work once the project is deployed. Claude artifacts and Webflow staging sites do not allow framing, so add those as a zip.')}</p>
</section>

<style is:global>
  /* A hairline opens the row, like every section below it. */
  .works {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 20px;
    margin-top: 0;
    padding: 24px 0 40px;
    border-top: 1px solid var(--color-rule);
  }
  .ww-groups {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    row-gap: 28px;
  }
  .ww-group {
    grid-column: span 3;
    min-width: 0;
  }
  .ww-group.ww-wide {
    grid-column: span 6;
  }
  .home .ww-label {
    margin: 0 0 12px;
    color: var(--color-ink-soft);
    font-size: 13px;
    line-height: 20px;
  }
  .ww-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ww-wide .ww-list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .ww-list li {
    margin: 0;
    padding: 0;
    color: var(--color-ink);
    font-size: 15px;
    line-height: 24px;
  }
  .home .ww-note {
    grid-column: 1 / span 8;
    margin: 28px 0 0;
    color: var(--color-ink-soft);
    font-size: 13px;
    line-height: 20px;
    /* Balanced, so the second line is never just the last few words. */
    text-wrap: balance;
  }
  @media (max-width: 960px) {
    .ww-group,
    .ww-group.ww-wide {
      grid-column: 1 / -1;
    }
    .ww-list,
    .ww-wide .ww-list {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    }
    .home .ww-note {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .ww-list,
    .ww-wide .ww-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
