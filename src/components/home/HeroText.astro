---
import CopyField from './CopyField.astro';
import { CODEX_CONFIG, CURSOR_CONFIG, REPO_URL, SETUP_COMMAND } from '../../lib/site';
import { withBase } from '../../lib/withBase';
import { waitlistOpen } from '../../lib/waitlist';
import { tie } from '../../lib/words';

/**
 * The hero's words and actions, shared by both hero variants. "Try the MCP"
 * opens a panel under the buttons with the setup command. Without script the
 * panel is simply open and its button is hidden.
 */
interface Props {
  waitlistUrl?: string;
}
const { waitlistUrl = '' } = Astro.props;
---

<div class="htext">
  <h1 id="h-hero" class="rise"><span class="sent">Your prototypes are everywhere.</span><span class="sent">{tie('Canon keeps them in one place.')}</span></h1>
  <p class="lede lede-hero rise rise-2">
    {tie('You and your team juggle Figma Make links, v0 deployments, Lovable apps, zips and whatever an agent built this morning. Canon files every one by project on your machine, named, tagged and easy to find.')}
  </p>
  <div class="mcp-scope" data-mcp>
    <div class="cta rise rise-3">
      <a class="hbtn hbtn-primary" href={withBase('/app/')} data-ga="open_app" data-ga-location="hero">Open the app</a>
      <button type="button" class="hbtn" data-mcp-toggle aria-expanded="false" aria-controls="mcp-panel">Try the MCP</button>
      {waitlistOpen(waitlistUrl) && <a class="hbtn" href="#hosted">Join the hosted waitlist</a>}
    </div>
    <div class="mcp">
      <div class="mcp-panel" id="mcp-panel" role="group" aria-labelledby="mcp-label">
        <p class="mcp-label" id="mcp-label">{tie('Connect your agent')}</p>
        <ol class="mcp-steps">
          <li>
            <p>{tie('Add the server for your agent.')}</p>
            <div class="mcp-switch" role="group" aria-label="Agent" data-mcp-switch>
              <button type="button" aria-pressed="true" data-mcp-pick="Claude Code">Claude Code</button>
              <button type="button" aria-pressed="false" data-mcp-pick="Codex">Codex</button>
              <button type="button" aria-pressed="false" data-mcp-pick="Cursor">Cursor</button>
            </div>
            <div class="mcp-cmd" data-mcp-agent="Claude Code">
              <p class="mcp-where">{tie('Claude Code, in your terminal')}</p>
              <CopyField command={SETUP_COMMAND} name="the setup command" location="hero" />
            </div>
            <div class="mcp-cmd" data-mcp-agent="Codex">
              <p class="mcp-where">{tie('Codex, in ~/.codex/config.toml')}</p>
              <CopyField command={CODEX_CONFIG} name="the Codex config" location="hero" />
            </div>
            <div class="mcp-cmd" data-mcp-agent="Cursor">
              <p class="mcp-where">{tie('Cursor, in .cursor/mcp.json')}</p>
              <CopyField command={CURSOR_CONFIG} name="the Cursor config" location="hero" />
            </div>
          </li>
          <li><p>Open <a href={withBase('/app/')} data-ga="open_app" data-ga-location="hero_steps">Canon</a> in Chrome.</p></li>
          <li><p>{tie('Ask your agent to connect to Canon. Open the link it gives you in a new tab and approve it. Chrome asks to allow local network access: allow it.')}</p></li>
        </ol>
        <p class="mcp-note">
          {'Every agent, in more detail: '}<a href={`${REPO_URL}#connect-your-agent`} data-ga="readme_click">the&nbsp;README</a>.
        </p>
      </div>
    </div>
  </div>
  <p class="fine rise rise-3" data-mcp-after>{tie('Free and open source. No account, and nothing leaves your machine.')}</p>
</div>

<script>
  import '../../scripts/mcp';
</script>

<style is:global>
  /* The panel inverts the surface: ink in light mode, white in dark mode, with
     no border. It opens by transform, opacity and a little blur, and the page
     below glides down by transform (see scripts/mcp.ts). */
  .mcp-scope {
    position: relative;
  }
  .mcp {
    --mp-bg: #1a1918;
    --mp-ink: #f3f0eb;
    --mp-muted: #b0aba3;
    --mp-fill: rgba(255, 255, 255, 0.09);
    --mp-hover: #3b3a38;
    --mp-line: #85817a;
    display: flow-root;
  }
  .mcp-panel {
    position: relative;
    z-index: 5;
    max-width: 580px;
    margin-top: 16px;
    padding: 18px 18px 20px;
    border-radius: 14px;
    background: var(--mp-bg);
    color: var(--mp-ink);
    transform-origin: 0 0;
  }
  .home .mcp-panel p {
    margin: 0;
  }
  .mcp-label {
    font-size: 15px;
    line-height: 22px;
    font-weight: 500;
  }
  .mcp-cmd {
    margin-top: 10px;
  }
  .mcp-steps {
    margin: 12px 0 0;
    padding: 0 0 0 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 22px;
  }
  .mcp-steps li::marker {
    color: var(--mp-muted);
  }
  .mcp-steps a {
    color: var(--mp-ink);
    text-underline-offset: 3px;
  }
  .home .mcp-panel .mcp-where {
    margin-bottom: 6px;
    font-size: 13px;
    line-height: 20px;
    color: var(--mp-muted);
  }
  .mcp-switch {
    display: none;
    gap: 6px;
    margin-top: 10px;
  }
  .js .mcp-switch {
    display: flex;
  }
  .mcp-switch button {
    height: 32px;
    padding: 0 14px;
    border-radius: 9px;
    border: 1px solid var(--mp-line);
    background: none;
    color: var(--mp-ink);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  .mcp-switch button[aria-pressed='true'] {
    background: var(--mp-fill);
  }
  .js .mcp-cmd[hidden] {
    display: none;
  }
  .mcp-panel .setup code {
    white-space: pre;
  }
  .mcp-panel .setup {
    width: 100%;
    background: var(--mp-fill);
    color: var(--mp-ink);
  }
  .mcp-panel .setup code {
    flex: 1 1 auto;
  }
  .mcp-panel .util {
    color: var(--mp-ink);
    border-color: var(--mp-line);
  }
  /* The site-wide .util hover paints the recess colour, which is the same
     family as this panel's ink in either theme. Set both colours here. */
  @media (hover: hover) and (pointer: fine) {
    .mcp-panel .util:hover {
      background: var(--mp-hover);
      color: var(--mp-ink);
    }
  }
  .home .mcp-panel .mcp-note {
    margin-top: 12px;
    font-size: 15px;
    line-height: 22px;
    color: var(--mp-muted);
  }
  .mcp-note a {
    color: var(--mp-ink);
    text-underline-offset: 3px;
  }
  .home .mcp-panel a:focus-visible,
  .home .mcp-panel button:focus-visible {
    outline-color: var(--mp-ink);
  }
  .mcp-scope [aria-expanded='true'] {
    background: var(--color-recess);
  }
  .fine[data-mcp-after] {
    margin-top: 16px;
  }

  /* No script: the panel is open and the button that would open it is gone. */
  html:not(.js) [data-mcp-toggle] {
    display: none;
  }

  /* With script the panel rests closed, out of the flow so the page does not
     reserve its height, and hidden from everything including the tab key. */
  .js .mcp-panel {
    position: absolute;
    inset: 0 0 auto 0;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    filter: blur(4px);
    transform: translateY(-8px) scale(0.98);
    transition:
      opacity 200ms var(--ease),
      transform 200ms var(--ease),
      filter 200ms var(--ease),
      visibility 0s linear 200ms;
  }
  .js .mcp.is-open .mcp-panel {
    position: relative;
    inset: auto;
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    filter: blur(0);
    transform: none;
    transition:
      opacity 360ms var(--ease),
      transform 360ms var(--ease),
      filter 360ms var(--ease),
      visibility 0s linear 0s;
  }
  /* The panel's lines fade up 4px, 40ms apart. They close together, quickly. */
  .js .mcp-panel > * {
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 160ms var(--ease),
      transform 160ms var(--ease);
  }
  .js .mcp.is-open .mcp-panel > * {
    opacity: 1;
    transform: none;
    transition:
      opacity 280ms var(--ease),
      transform 280ms var(--ease);
  }
  .js .mcp.is-open .mcp-panel > :nth-child(1) {
    transition-delay: 40ms;
  }
  .js .mcp.is-open .mcp-panel > :nth-child(2) {
    transition-delay: 80ms;
  }
  .js .mcp.is-open .mcp-panel > :nth-child(3) {
    transition-delay: 120ms;
  }

  /* Reduced motion: the panel only fades. */
  @media (prefers-reduced-motion: reduce) {
    .js .mcp-panel,
    .js .mcp.is-open .mcp-panel {
      filter: none;
      transform: none;
    }
    .js .mcp-panel {
      transition:
        opacity 200ms var(--ease),
        visibility 0s linear 200ms;
    }
    .js .mcp.is-open .mcp-panel {
      transition:
        opacity 200ms var(--ease),
        visibility 0s linear 0s;
    }
    .js .mcp-panel > *,
    .js .mcp.is-open .mcp-panel > * {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .mcp-panel {
      max-width: none;
    }
  }
  @media (max-width: 480px) {
    .mcp-panel {
      padding: 16px 14px 18px;
    }
    .mcp-panel .setup {
      align-items: flex-start;
      flex-wrap: wrap;
      padding: 12px;
    }
    .mcp-panel .setup code {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      overflow: visible;
      font-size: 13px;
    }
  }
</style>
