---
import Thumb from './Thumb.astro';
import { tie } from '../../lib/words';
---

<section class="band" id="open" aria-labelledby="h-open">
  <h2 id="h-open">{tie('Star it, note it, compare versions.')}</h2>
  <p class="lede">{tie('Open a prototype and one bar holds what you need: note, star, versions and archive. Notes stay on your machine, with the prototype.')}</p>
  <div class="canvas" role="img" aria-label="A pricing prototype open in Canon with one note pinned to it and a bar of actions underneath: note, star, versions and archive.">
    <div class="ctitle" aria-hidden="true"><b>Pricing page, annual toggle</b><span class="muted">Version 3 of 3</span></div>
    <div class="page" aria-hidden="true"><Thumb k="p1" /></div>
    <span class="pin" aria-hidden="true">1</span>
    <div class="note" aria-hidden="true">Show the saving next to the yearly&nbsp;price.<small>You · today</small></div>
    <div class="bbar" aria-hidden="true">
      <span class="bitem on">Note</span>
      <span class="bitem">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m8 1.6 1.9 4 4.4.6-3.2 3 .8 4.3L8 11.4l-3.9 2.1.8-4.3-3.2-3 4.4-.6z"></path></svg>
        Star
      </span>
      <span class="bitem">Versions<span class="muted">3</span></span>
      <span class="bitem">Archive</span>
    </div>
  </div>
</section>
