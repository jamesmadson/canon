---
import CopyField from './CopyField.astro';
import Thumb from './Thumb.astro';
import { REPO_URL, SETUP_COMMAND } from '../../lib/site';
import { tie } from '../../lib/words';
import type { ThumbKey } from '../../lib/thumbs';

const PROMPT = 'Add Today and Profile to the iPhone app project.';

type Row = [ThumbKey, string, string];
// Two prototypes that start loose, and the one already filed under iPhone app.
const LOOSE: Row[] = [
  ['today', 'Today', 'Claude Code'],
  ['prof', 'Profile', 'Codex'],
];
const FILED: Row[] = [['onb', 'Onboarding', 'Figma Make']];
---

<section class="band" id="agents" aria-labelledby="h-agents">
  <div class="bhead">
    <h2 id="h-agents"><span class="sent">Say it once.</span><span class="sent">{tie('Your agent does the filing.')}</span></h2>
    <p class="lede">{tie('Your agent can add, name, tag and file prototypes for you. Ask in plain words and they land in the right project.')}</p>
  </div>
  <div class="tint" data-demo="agents">
    <p class="say">{tie('You, to your agent')}</p>
    <p class="big"><span data-type={PROMPT} data-type-start="0">{PROMPT}</span><span class="caret" data-caret="30" style="opacity:0" aria-hidden="true"></span></p>
    <div class="moves" role="img" aria-label="Two loose prototypes under No project, Today and Profile, move into the iPhone app project, which grows from one prototype to three.">
      <div class="mvbox" aria-hidden="true">
        <div class="mvhead"><b>No project</b><span><span data-count data-from="2" data-to="0" data-at="38">0</span></span></div>
        <div class="mvbody">
          {
            LOOSE.map(([k, name, from]) => (
              <div class="mvrow mv-loose" data-tidy="38">
                <Thumb k={k} />
                <b>{name}</b>
                <span>{from}</span>
              </div>
            ))
          }
          <div class="mvempty" data-tidy="38">Nothing loose</div>
        </div>
      </div>
      <svg class="mvarrow" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
      <div class="mvbox" aria-hidden="true">
        <div class="mvhead"><b>iPhone app</b><span><span data-count data-from="1" data-to="3" data-at="38">3</span></span></div>
        <div class="mvbody">
          {
            LOOSE.map(([k, name, from], i) => (
              <div class="mvrow" data-step={38 + i * 2}>
                <Thumb k={k} />
                <b>{name}</b>
                <span>{from}</span>
              </div>
            ))
          }
          {
            FILED.map(([k, name, from]) => (
              <div class="mvrow">
                <Thumb k={k} />
                <b>{name}</b>
                <span>{from}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div class="after">
    <CopyField command={SETUP_COMMAND} name="the setup command" location="agents" />
    <p class="fine">
      One line connects Claude Code. Codex and Cursor take a few lines in their config, <a href={`${REPO_URL}#connect-your-agent`} data-ga="readme_click">written up in the README</a>. Canon works without it, so add it when you want the filing done for&nbsp;you.
    </p>
  </div>
</section>
