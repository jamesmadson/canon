---
import { waitlistOpen } from '../../lib/waitlist';
import Thumb from './Thumb.astro';
import { tie } from '../../lib/words';

interface Props {
  waitlistUrl?: string;
}
const { waitlistUrl = '' } = Astro.props;
const open = waitlistOpen(waitlistUrl);
---

<section class="band" id="hosted" aria-labelledby="h-hosted">
  <div class="bhead">
    <h2 id="h-hosted"><span class="sent">Free on your machine.</span><span class="sent">{tie('Hosted when you need to share.')}</span></h2>
  </div>
  <div class="plans">
    <div class="panel">
      <div class="shot win" role="img" aria-label="Canon in its own window, showing the Onboarding project with two prototypes in a list.">
        <div class="wtitle" aria-hidden="true">Canon</div>
        <div class="wbody" aria-hidden="true">
          <div class="wside">
            <div class="wn-nav on">Home</div>
            <div class="wn-nav">Starred<small>3</small></div>
            <div class="wn-sec">Projects</div>
            <div class="wn-nav">Onboarding<small>5</small></div>
            <div class="wn-nav">Dashboard<small>4</small></div>
          </div>
          <div class="wlist">
            <div class="wgrp"><b>Onboarding</b><span class="muted">5</span></div>
            <div class="wrow"><span class="mini-t"><Thumb k="w2" /></span><b>Welcome, single screen</b><span class="muted">Lovable</span></div>
            <div class="wrow"><span class="mini-t"><Thumb k="w1" /></span><b>Welcome, three steps</b><span class="muted">Claude Code</span></div>
            <div class="wrow"><span class="mini-t"><Thumb k="w3" /></span><b>Invite a teammate</b><span class="muted">Figma Make</span></div>
          </div>
        </div>
      </div>
      <div class="tx2">
        <h3>{tie('Canon, local')}</h3>
        <p>{'Free and open source under MIT. Available now.'}</p>
        <ul>
          <li>Every project and prototype, stored on your machine</li>
          <li>Claude Code, Codex and Cursor, with as many projects as you like</li>
          <li>{tie('Its own window, installed from your browser')}</li>
        </ul>
      </div>
    </div>
    <div class:list={['panel', 'hosted-card', open && 'with-form']}>
      <div>
        <div class="shot" role="img" aria-label="A sketch of a share link, and a comment from someone who opened it.">
          <div class="q"><span>Anyone with the link can comment</span><span class="mini">Copy link</span></div>
          <div class="hshot"><Thumb k="w2" /><span class="hpin">1</span></div>
          <div class="bub"><span class="av">P</span><span><b>Priya</b>{' '}{tie('Try the single screen first?')}</span></div>
        </div>
        <div class="tx2">
          <h3>{tie('Canon, hosted')}</h3>
          <p>{tie('Not built yet. This is what it is for.')}</p>
          <ul>
            <li>Share a project with a link</li>
            <li>{tie('Comments from people who don’t have Canon')}</li>
            <li>{tie('The same projects on every machine, and for a team')}</li>
          </ul>
          {!open && <p class="soon">{tie('The waitlist opens soon.')}</p>}
        </div>
      </div>
      {
        open && (
          <form class="form" aria-labelledby="h-form" method="post" action={waitlistUrl} data-waitlist>
            <h3 id="h-form">{tie('Join the waitlist')}</h3>
            <p class="muted form-hint">{tie('Your email address is all we need.')}</p>
            <div class="frow">
              <div class="wl-field">
                <label for="wl-email">Email</label>
                <input id="wl-email" name="email" type="email" autocomplete="email" required />
              </div>
              <button class="hbtn hbtn-primary" type="submit">Join the waitlist</button>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="wl-gotcha">Leave this field empty</label>
              <input id="wl-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <p class="fine form-note">{tie('Only your email address is sent, to Formspree, so we can tell you when hosting opens.')}</p>
            <p class="fine form-status" role="status" aria-live="polite" data-waitlist-note></p>
          </form>
        )
      }
    </div>
  </div>
</section>
