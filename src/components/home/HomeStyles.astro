---
/**
 * The homepage's styles, in one place, drawn from the site's tokens. Rounded
 * panels have no border; floating pieces get a faint shadow ring. Everything
 * that moves moves by transform or opacity on the one curve.
 */
---

<style is:global>
  .home {
    --ease: cubic-bezier(0.2, 0, 0, 1);
    --edge: color-mix(in srgb, var(--color-ink) 9%, transparent);
    --shadow: rgba(26, 25, 24, 0.12);
    --wn-rail: #f9f7f4;
    --wn-main: #ffffff;
    --wn-panel: #f4f1ee;
    --wn-raised: #efece8;
    --wn-line: rgba(26, 25, 24, 0.08);
    --wn-line-strong: rgba(26, 25, 24, 0.16);
    --glow: rgba(26, 25, 24, 0.05);
    --hi: rgba(255, 255, 255, 0.9);
    --sel: #007FFF;
    overflow-x: clip;
    font-size: 15px;
    line-height: 24px;
  }
  .home h1,
  .home h2,
  .home h3,
  .home p {
    margin: 0;
  }
  .home h1 {
    font-size: 48px;
    line-height: 52px;
    font-weight: 400;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .home h2 {
    font-size: 24px;
    line-height: 30px;
    font-weight: 400;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .home h3 {
    font-size: 18px;
    line-height: 26px;
    font-weight: 500;
    text-wrap: balance;
  }
  .home p {
    text-wrap: pretty;
  }
  /* One sentence per line when it fits; balanced within itself when it does not. */
  .home .sent {
    display: block;
    text-wrap: balance;
  }
  .home .lede {
    font-size: 18px;
    line-height: 28px;
    color: var(--color-ink-soft);
  }
  .home .muted {
    color: var(--color-ink-soft);
  }
  .home .mono {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  /* The one container: header, footer and every page's content share it. */
  .wrap {
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: 40px;
  }
  .home a:focus-visible,
  .home button:focus-visible,
  .home input:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* Buttons: pills for actions, 38px high. Rectangles for utility controls. */
  .hbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    padding: 0 20px;
    border-radius: var(--radius-btn);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--color-input-border);
    background: transparent;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 160ms var(--ease);
  }
  .hbtn:active {
    transform: scale(0.97);
  }
  .hbtn-primary {
    background: var(--color-ink);
    color: var(--color-ground);
    border-color: var(--color-ink);
  }
  .hbtn-small {
    height: 36px;
    padding: 0 18px;
  }
  /* The header's Open the app is a light fill, not an outline. */
  .top .hbtn {
    border-color: transparent;
    background: var(--color-panel);
  }
  .hbtn-wide {
    width: 100%;
  }
  .util {
    height: 32px;
    padding: 0 16px;
    border-radius: var(--radius-btn);
    border: 1px solid var(--color-input-border);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: transform 160ms var(--ease);
  }
  .util:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .util:hover {
      background: var(--color-recess);
      color: var(--color-ink);
    }
  }

  /* Top bar */
  .top {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .lockup {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 9px;
  }
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'text'
      'term'
      'stage';
    gap: 40px 0;
    padding: 56px 0 96px;
  }
  .htext {
    grid-area: text;
  }
  .term {
    grid-area: term;
  }
  .stage {
    grid-area: stage;
  }
  /* Wide enough for two columns: the text on the left, the agent prompt on the right. */
  @media (min-width: 1100px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
      grid-template-areas:
        'text term'
        'stage stage';
      gap: 72px 40px;
      align-items: center;
    }
  }
  .htext {
    max-width: none;
    margin: 0;
  }
  .htext .lede {
    margin-top: 14px;
    max-width: 50ch;
  }
  .home .lede.lede-hero {
    font-size: 20px;
    line-height: 30px;
  }
  .cta {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
    align-items: center;
  }
  .fine {
    margin-top: 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink-soft);
  }
  .setup {
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 11px;
    background: var(--color-panel);
    padding: 6px 6px 6px 18px;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
  }
  .setup code {
    font-family: var(--font-mono);
    font-size: 14px;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .setup code::-webkit-scrollbar {
    display: none;
  }
  .setup .hbtn,
  .setup .util {
    flex: none;
  }
  .setup .util {
    height: 36px;
    padding: 0 18px;
  }

  /* The stage: the app window sits on the page ground and dissolves at its
     bottom and right edges. The terminal is a second window in front. */
  .stage {
    position: relative;
  }
  .stage::before {
    content: '';
    position: absolute;
    left: -240px;
    right: -240px;
    top: -60px;
    height: 640px;
    background: radial-gradient(ellipse 50% 70% at 50% 0%, var(--glow), transparent 72%);
    pointer-events: none;
  }
  .fade {
    position: relative;
    height: 610px;
    margin: 0 -40px 0 -40px;
    padding: 28px 0 0 40px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 97%);
    mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 97%);
  }
  .app {
    display: grid;
    grid-template-columns: 216px minmax(0, 1fr);
    height: 860px;
    border-radius: 14px;
    background: var(--wn-rail);
    box-shadow:
      0 0 0 1px var(--edge),
      inset 0 1px 0 var(--hi),
      0 40px 100px -24px var(--shadow);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-ink);
    overflow: hidden;
  }
  .wn-rail {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px;
    min-height: 0;
  }
  .wn-ws {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 10px;
  }
  .wn-ws b {
    font-size: 13.5px;
    font-weight: 600;
  }
  .wn-mark {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: var(--wn-raised);
    display: grid;
    place-items: center;
  }
  .wn-mark::after {
    content: '';
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #007FFF;
  }
  .wn-search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    margin: 2px 0 8px;
    padding: 0 10px;
    border-radius: 9px;
    background: var(--wn-main);
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .wn-search kbd {
    margin-left: auto;
    font: 500 10.5px var(--font-mono);
  }
  .wn-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    padding: 0 10px;
    border-radius: 6px;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .wn-nav.on {
    background: var(--wn-raised);
    color: var(--color-ink);
  }
  .wn-nav svg {
    flex: none;
    opacity: 0.85;
  }
  .wn-nav small {
    margin-left: auto;
    font: 500 11px var(--font-mono);
  }
  .wn-sec {
    margin: 14px 10px 4px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-ink-soft);
  }
  .wn-foot {
    margin-top: auto;
    padding: 10px;
    border-top: 1px solid var(--wn-line);
    font-size: 11.5px;
    color: var(--color-ink-soft);
  }
  .wn-foot i {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 50%;
    background: var(--color-ink);
    vertical-align: 1px;
  }
  .wn-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 8px 8px 8px 0;
    border-radius: 11px;
    background: var(--wn-main);
    box-shadow:
      0 0 0 1px var(--wn-line),
      0 1px 2px var(--shadow);
    overflow: hidden;
  }
  .wn-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 14px 0 20px;
    border-bottom: 1px solid var(--wn-line);
  }
  .wn-title {
    margin-right: auto;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .wn-title small {
    margin-left: 8px;
    font-size: 13px;
    font-weight: 400;
    color: var(--color-ink-soft);
  }
  .wn-util {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 9px;
    border-radius: 7px;
    box-shadow: inset 0 0 0 1px var(--wn-line-strong);
    color: var(--color-ink-soft);
    font-size: 12px;
  }
  .wn-seg {
    display: inline-flex;
    padding: 2px;
    border-radius: 8px;
    background: var(--wn-panel);
    font-size: 12px;
    color: var(--color-ink-soft);
  }
  .wn-seg span {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 6px;
  }
  .wn-seg .on {
    background: var(--wn-main);
    color: var(--color-ink);
    font-weight: 500;
    box-shadow:
      0 0 0 1px var(--wn-line),
      0 1px 1px var(--shadow);
  }
  .add {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px 0 9px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-ground);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }
  .srow {
    padding: 14px 20px 16px;
    border-bottom: 1px solid var(--wn-line);
  }
  .shead {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 10px;
  }
  .shead b {
    font-size: 13px;
    font-weight: 500;
  }
  .shead .muted:last-child {
    margin-left: auto;
    font-size: 12px;
  }
  .shelf {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .slot {
    position: relative;
    min-width: 0;
  }
  .landing {
    position: absolute;
    inset: 0 0 auto 0;
    aspect-ratio: 16 / 10;
    border-radius: 9px;
    border: 1px dashed var(--color-input-border);
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--color-ink-soft);
    font-size: 12px;
    padding: 0 10px;
  }
  .scard {
    position: relative;
  }
  .scard.sel .thumb {
    box-shadow:
      0 0 0 2px var(--wn-main),
      0 0 0 4px var(--sel);
  }
  .pname {
    margin-top: 8px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pmeta {
    color: var(--color-ink-soft);
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* A prototype thumbnail: a small drawn page in container units, so it reads
     at any size. Each page sits on one muted tint from src/styles/tints.css. */
  .thumb {
    --tint: var(--tint-warm);
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 16 / 10;
    container-type: inline-size;
    border-radius: 9px;
    background: var(--tint);
    box-shadow:
      0 0 0 1px rgba(26, 25, 24, 0.1),
      0 1px 2px rgba(26, 25, 24, 0.05);
    overflow: hidden;
    color: #1c1b19;
    text-align: left;
  }
  .t-sand {
    --tint: var(--tint-sand);
  }
  .t-sage {
    --tint: var(--tint-sage);
  }
  .t-clay {
    --tint: var(--tint-clay);
  }
  .t-slate {
    --tint: var(--tint-slate);
  }
  .t-lilac {
    --tint: var(--tint-lilac);
  }
  .t-warm {
    --tint: var(--tint-warm);
  }
  .thumb u,
  .thumb i,
  .thumb b {
    display: block;
    text-decoration: none;
    font-style: normal;
  }
  .tp-nav {
    flex: none;
    display: flex;
    align-items: center;
    gap: 3cqw;
    height: 8cqw;
    padding: 0 5cqw;
    box-shadow: inset 0 -0.3cqw 0 rgba(26, 25, 24, 0.08);
    font-size: 2.6cqw;
    line-height: 1;
    color: #5c5954;
  }
  .tp-nav b {
    margin-right: auto;
    font-size: 3cqw;
    font-weight: 600;
    color: #1c1b19;
    letter-spacing: -0.01em;
  }
  .tp-split {
    flex: 1;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 5cqw;
    padding: 5cqw;
    min-height: 0;
  }
  .tp-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 2.2cqw;
  }
  .tp-steps {
    display: flex;
    gap: 1cqw;
  }
  .tp-steps i {
    width: 7cqw;
    height: 0.9cqw;
    border-radius: 1cqw;
    background: #e2ded6;
  }
  .tp-steps i.on {
    background: #2a2826;
  }
  .tp-cap {
    font-size: 2.4cqw;
    line-height: 1;
    color: #5c5954;
  }
  .tp-cap.c {
    align-self: center;
  }
  .tp-h {
    font-size: 6cqw;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .tp-t {
    font-size: 2.7cqw;
    line-height: 1.4;
    color: #5c5954;
  }
  .tp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 6.6cqw;
    margin-top: 1cqw;
    padding: 0 3.6cqw;
    border-radius: 999px;
    background: #2a2826;
    color: #fff;
    font-size: 2.7cqw;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
  }
  .tp-btn.o {
    background: #fff;
    color: #1c1b19;
    box-shadow: inset 0 0 0 0.3cqw #d3cfc6;
  }
  .tp-img {
    position: relative;
    border-radius: 2.4cqw;
    background: color-mix(in srgb, var(--tint) 86%, #1a1918);
    overflow: hidden;
  }
  .tp-img i {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 12%;
    height: 24%;
    border-radius: 1.6cqw;
    background: #fff;
    opacity: 0.85;
    box-shadow: 0 0.4cqw 1.2cqw rgba(26, 25, 24, 0.08);
  }
  .tp-img i:nth-child(2) {
    top: 40%;
    left: 22%;
    right: 6%;
  }
  .tp-img i:nth-child(3) {
    top: 68%;
    left: 8%;
    right: 20%;
  }
  .tp-mid {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2cqw;
    background: var(--tint);
    text-align: center;
  }
  .tp-card {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 2cqw;
    width: 52cqw;
    margin-top: 1.5cqw;
    padding: 3.6cqw;
    border-radius: 2.4cqw;
    background: #fff;
    box-shadow:
      0 0 0 0.3cqw #e2ded6,
      0 1cqw 3cqw rgba(26, 25, 24, 0.06);
  }
  .tp-card .tp-btn {
    align-self: center;
  }
  .tp-in {
    display: flex;
    align-items: center;
    height: 6.4cqw;
    padding: 0 2.4cqw;
    border-radius: 1.4cqw;
    background: #fff;
    box-shadow: inset 0 0 0 0.3cqw #cfcbc2;
    font-size: 2.6cqw;
    line-height: 1;
    color: #6f6b63;
    text-align: left;
  }
  .tp-chips {
    display: flex;
    gap: 1.4cqw;
  }
  .tp-chips u {
    display: inline-flex;
    align-items: center;
    height: 4.8cqw;
    padding: 0 2.2cqw;
    border-radius: 999px;
    background: #f1efea;
    color: #5c5954;
    font-size: 2.3cqw;
    line-height: 1;
  }
  .tp-chips u.on {
    background: var(--tint);
    color: #1c1b19;
  }
  .tp-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2cqw;
    padding: 5cqw;
    min-height: 0;
  }
  .tp-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tp-list {
    display: flex;
    flex-direction: column;
    margin-top: 1cqw;
    border-top: 0.3cqw solid #efece6;
  }
  .tp-who {
    display: flex;
    align-items: center;
    gap: 2.4cqw;
    height: 9cqw;
    box-shadow: inset 0 -0.3cqw 0 rgba(26, 25, 24, 0.08);
  }
  .tp-who i {
    flex: none;
    width: 5.2cqw;
    height: 5.2cqw;
    border-radius: 50%;
    background: var(--tint);
  }
  .tp-who div {
    display: flex;
    flex-direction: column;
    gap: 0.6cqw;
    margin-right: auto;
    line-height: 1;
  }
  .tp-who b {
    font-size: 2.7cqw;
    font-weight: 500;
  }
  .tp-who span {
    font-size: 2.3cqw;
    color: #5c5954;
  }
  .tp-who u {
    font-size: 2.4cqw;
    color: #5c5954;
  }
  .tp-foot {
    display: flex;
    gap: 2cqw;
    margin-top: auto;
  }
  .tp-foot .tp-in {
    flex: 1;
  }
  .tp-foot .tp-btn {
    margin: 0;
    height: 6.4cqw;
  }
  .tp-dash {
    flex: 1;
    display: grid;
    grid-template-columns: 20cqw 1fr;
    min-height: 0;
  }
  .tp-side {
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    padding: 4cqw 3cqw;
    background: #faf9f6;
    box-shadow: inset -0.3cqw 0 0 #efece6;
    font-size: 2.4cqw;
    line-height: 1;
    color: #5c5954;
  }
  .tp-side b {
    margin-bottom: 2cqw;
    font-size: 3cqw;
    font-weight: 600;
    color: #1c1b19;
  }
  .tp-side u {
    padding: 1.2cqw 1.6cqw;
    border-radius: 1cqw;
  }
  .tp-side u.on {
    background: #eeebe5;
    color: #1c1b19;
  }
  .tp-main {
    display: flex;
    flex-direction: column;
    gap: 3cqw;
    min-width: 0;
    padding: 4cqw;
  }
  .tp-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2cqw;
  }
  .tp-stat {
    display: flex;
    flex-direction: column;
    gap: 1.2cqw;
    padding: 2.2cqw 2.4cqw;
    border-radius: 1.6cqw;
    background: rgba(255, 255, 255, 0.6);
    box-shadow: inset 0 0 0 0.3cqw rgba(26, 25, 24, 0.1);
    line-height: 1;
  }
  .tp-stat span {
    font-size: 2.2cqw;
    color: #5c5954;
  }
  .tp-stat b {
    font-size: 4.4cqw;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .tp-chart {
    position: relative;
    flex: 1;
    display: flex;
    min-height: 0;
    padding: 3cqw;
