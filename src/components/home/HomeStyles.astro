  /* The terminal, a second window in front of the app */
  .term {
    position: relative;
    width: 100%;
    border-radius: 11px;
    background: #151413;
    color: #edebe6;
    box-shadow:
      0 0 0 1px rgba(237, 235, 230, 0.14),
      inset 0 1px 0 rgba(237, 235, 230, 0.08),
      0 3px 8px rgba(0, 0, 0, 0.25),
      0 36px 80px -8px rgba(0, 0, 0, 0.55);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 21px;
    overflow: hidden;
  }
  .tbar {
    display: flex;
    align-items: center;
    height: 34px;
    padding: 0 14px;
    color: #a29e96;
    font-size: 12px;
    box-shadow: inset 0 -1px 0 rgba(237, 235, 230, 0.08);
  }
  .tbody {
    display: grid;
    gap: 4px;
    align-content: start;
    min-height: 136px;
    padding: 12px 14px 16px;
  }
  .dim {
    color: #a29e96;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 15px;
    background: var(--color-ink);
    vertical-align: -3px;
    margin-left: 1px;
  }
  .term .caret {
    background: #edebe6;
    height: 14px;
    vertical-align: -2px;
  }

  /* Bands */
  /* One 12-column grid, 20px gutters. A hairline opens each section, the head
     sits in its left columns and the picture or cards use the rest. 96px
     between sections, 32px from head to content. */
  .band {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 20px;
    padding: 24px 0 96px;
    border-top: 1px solid var(--color-rule);
  }
  .band > * {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .band > .bhead {
    grid-column: 1 / span 6;
    margin-bottom: 32px;
  }
  .bhead .lede {
    margin-top: 8px;
    max-width: 56ch;
    color: var(--color-ink-soft);
  }
  @media (min-width: 1100px) {
    .band.split > .bhead {
      grid-column: 1 / span 4;
      margin-bottom: 0;
    }
    .band.split > .bbody {
      grid-column: 5 / -1;
      grid-row: 1;
    }
  }
  .panel {
    border-radius: 14px;
    background: var(--color-panel);
    padding: 12px;
  }
  .panel .tx2 {
    padding: 16px 12px 12px;
  }
  .panel .tx2 p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 26px;
    color: var(--color-ink-soft);
  }
  .three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .panel {
    position: relative;
  }
  /* A circled numeral at the card's top left: text in a 20px ring. */
  .num {
    position: absolute;
    z-index: 1;
    top: 22px;
    left: 22px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-ground);
    box-shadow: inset 0 0 0 1px var(--color-ink);
    color: var(--color-ink);
    font-size: 11px;
    line-height: 1;
    font-weight: 500;
  }
  /* The three pictures share one height and are not faded, so every word in
     them can be read. */
  .three .shot {
    height: 216px;
    padding: 52px 20px 20px;
    -webkit-mask-image: none;
    mask-image: none;
  }
  .three .tx2 .marks {
    margin-top: 16px;
  }
  .three .tx2 p {
    max-width: 30ch;
  }
  .ways-note {
    margin-top: 16px;
    max-width: 64ch;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink-soft);
  }
  /* The first picture is the terminal itself, set a little smaller. */
  .three .shot.term-shot {
    display: block;
    padding: 0;
    background: none;
    border-radius: 14px;
  }
  .term-shot .pmini {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: none;
  }
  .term-shot .pmini .pbody {
    flex: 1;
    justify-content: space-between;
  }
  .pmini .pdots {
    display: none;
  }
  .pmini .pinput {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 9px;
  }
  .shot {
    height: 176px;
    border-radius: 9px;
    background: var(--color-ground);
    padding: 20px;
    display: grid;
    align-content: center;
    gap: 12px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 78%, transparent 100%);
  }
  .shot.win {
    display: block;
    height: 208px;
    padding: 0;
    background: var(--wn-rail);
    box-shadow: 0 0 0 1px var(--edge);
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 72%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 72%, transparent 100%);
    font-size: 13px;
    line-height: 18px;
  }
  .wtitle {
    height: 30px;
    display: grid;
    place-items: center;
    font-size: 12px;
    color: var(--color-ink-soft);
  }
  .wbody {
    display: grid;
    grid-template-columns: 124px minmax(0, 1fr);
    padding: 0 0 0 6px;
  }
  .wside {
    padding: 4px 4px;
    font-size: 12.5px;
  }
  .wside .wn-nav {
    height: 28px;
    padding: 0 8px;
  }
  .wside .wn-sec {
    margin: 10px 8px 2px;
  }
  .wlist {
    margin: 0 0 0 4px;
    border-radius: 11px 0 0 0;
    background: var(--wn-main);
    box-shadow: 0 0 0 1px var(--wn-line);
    min-height: 170px;
    overflow: hidden;
  }
  .wgrp {
    display: flex;
    gap: 8px;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    background: var(--wn-panel);
    box-shadow: inset 0 -1px 0 var(--wn-line);
    font-size: 12.5px;
  }
  .wgrp b {
    font-weight: 500;
  }
  .wrow {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 40px;
    padding: 0 14px;
    box-shadow: inset 0 -1px 0 var(--wn-line);
    font-size: 12.5px;
    white-space: nowrap;
  }
  .wrow b {
    font-weight: 500;
  }
  .wrow .muted {
    margin-left: auto;
  }
  .wrow .mini-t .thumb {
    width: 34px;
    border-radius: 4px;
  }
  .shot.dark {
    background: #1a1918;
    color: #edebe6;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    gap: 2px;
  }
  .q {
    height: 40px;
    border-radius: 9px;
    background: var(--color-panel);
    display: flex;
    align-items: center;
    padding: 0 6px 0 12px;
    gap: 8px;
    white-space: nowrap;
    overflow: hidden;
  }
  .q .mono {
    font-size: 12px;
  }
  .q > span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini {
    margin-left: auto;
    flex: 0 0 auto;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-ground);
    font-size: 12px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
  }
  .lrow {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 13px;
    line-height: 18px;
  }
  .lrow > div > b {
    display: block;
    font-weight: 500;
  }
  .mini-t {
    flex: 0 0 auto;
  }
  .mini-t .thumb {
    width: 96px;
    border-radius: 6px;
  }
  /* The zip card: a file chip held over a project, above the slot it will fill. */
  .three .shot.zipshot {
    position: relative;
    display: block;
    padding: 0;
  }
  .zproj {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 92px;
    bottom: 0;
    padding: 12px 12px 0;
    border-radius: 11px 11px 0 0;
    background: var(--color-panel);
  }
  .zhead {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 12px;
    line-height: 16px;
  }
  .zhead b {
    font-weight: 500;
  }
  .zslots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }
  .zslot {
    min-width: 0;
    aspect-ratio: 16 / 10;
    border-radius: 6px;
    overflow: hidden;
  }
  .zslot .thumb {
    width: 100%;
  }
  .zslot.zdrop {
    background: var(--color-recess);
  }
  .zfile {
    position: absolute;
    right: 22px;
    top: 66px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 12px;
    border-radius: 9px;
    background: var(--color-ground);
    color: var(--color-ink);
    transform: rotate(-4deg);
    box-shadow:
      0 14px 24px -8px rgba(26, 25, 24, 0.28),
      0 2px 5px rgba(26, 25, 24, 0.12);
  }
  .zfile .mono {
    font-size: 12px;
  }

  /* The ink panel, the same in both themes */
  .tint {
    --pbg: #1a1918;
    --pink: #f3f0eb;
    --pmuted: #b0aba3;
    border-radius: 14px;
    background: var(--pbg);
    color: var(--pink);
    padding: 40px 40px 36px;
    overflow: hidden;
  }
  .say {
    font-size: 14px;
    line-height: 22px;
    color: var(--pmuted);
  }
  .tint .pmeta {
    color: var(--pmuted);
  }
  .tint .muted {
    color: var(--pmuted);
  }
  .home .big {
    margin-top: 10px;
    font-size: 32px;
    line-height: 40px;
    font-weight: 400;
    letter-spacing: -0.03em;
    min-height: 80px;
    max-width: 26ch;
  }
  .big .caret {
    background: var(--color-orange);
    width: 3px;
    height: 28px;
    vertical-align: -5px;
    margin-left: 3px;
  }
  .moves {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.25fr);
    gap: 20px;
    align-items: start;
    margin-top: 28px;
  }
  .mvarrow {
    margin-top: 8px;
    color: var(--pmuted);
  }
  .mvbox {
    border-radius: 11px;
    background: #232120;
    overflow: hidden;
  }
  .mvhead {
    display: flex;
    gap: 8px;
    align-items: baseline;
    height: 36px;
    padding: 0 14px;
    align-items: center;
    background: #2b2927;
    font-size: 13px;
  }
  .mvhead b {
    font-weight: 500;
  }
  .mvhead span {
    margin-left: auto;
    color: var(--pmuted);
  }
  .mvbody {
    position: relative;
    min-height: 132px;
    padding: 4px 0;
  }
  /* The loose box holds two rows, so it is not taller than it needs to be. */
  .moves .mvbox:first-child .mvbody {
    min-height: 96px;
  }
  .mvrow {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 44px;
    padding: 0 14px;
    font-size: 13px;
    white-space: nowrap;
  }
  .mvrow .thumb {
    flex: none;
    width: 48px;
    border-radius: 4px;
    box-shadow: none;
  }
  .mvrow b {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-weight: 500;
  }
  .mvrow span {
    margin-left: auto;
    color: var(--pmuted);
  }
  /* The loose rows are gone in the finished frame, and shown before the move. */
  .mv-loose {
    opacity: 0;
    transition: opacity 320ms var(--ease);
  }
  .mvempty {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--pmuted);
    font-size: 13px;
    transition: opacity 320ms var(--ease);
  }
  .motion .mv-loose:not(.tidy) {
    opacity: 1;
  }
  .motion .mvempty:not(.tidy) {
    opacity: 0;
  }
  .after {
    display: flex;
    gap: 20px 28px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .after .fine {
    margin-top: 0;
    max-width: 56ch;
    font-size: 15px;
    line-height: 24px;
  }
  .fine a {
    color: var(--color-ink);
  }

  /* The project the three sources feed: one header and a row of prototypes */
  .proj {
    margin-top: 28px;
    padding: 20px 20px 22px;
    border-radius: 14px;
    background: var(--color-panel);
  }
  .proj .shead {
    margin-bottom: 14px;
  }
  .proj .shelf {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .proj .thumb {
    box-shadow: 0 1px 2px var(--shadow);
  }


  /* Search and open */
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }
  .read {
    display: flex;
    gap: 20px;
    align-items: center;
    border-radius: 14px;
    background: var(--color-panel);
    padding: 20px;
  }
  .read .thumb {
    flex: 0 0 200px;
  }
  .read > div > small {
    display: block;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink-soft);
    margin-bottom: 8px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 7px;
    background: var(--color-recess);
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
  }
  .results {
    border-radius: 14px;
    background: var(--color-panel);
    padding: 14px;
    display: grid;
    gap: 4px;
  }
  .results .q {
    margin-bottom: 8px;
  }
  .res {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 14px;
    align-items: start;
    padding: 12px;
    border-radius: 9px;
    font-size: 13px;
  }
  .res.on {
    background: var(--color-ground);
  }
  .res > div > b {
    display: block;
    font-weight: 500;
    font-size: 15px;
  }
  .res > div > small {
    display: block;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink-soft);
    margin-bottom: 8px;
  }
  .canvas {
    position: relative;
    height: 430px;
  }
  .cmask {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background-color: var(--color-panel);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 96%);
    mask-image: linear-gradient(to bottom, #000 0, #000 62%, transparent 96%);
  }
  .ctitle {
    position: absolute;
    left: 24px;
    top: 20px;
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 14px;
  }
  .ctitle b {
    font-weight: 500;
  }
  /* The page, the pin and the note share one box, so the pin stays on the
     Team plan whatever the width. */
  .page {
    position: absolute;
    left: 50%;
    top: 60px;
    width: min(680px, calc(100% - 48px));
    transform: translateX(-50%);
  }
  .page .thumb {
    width: 100%;
    border-radius: 11px;
    box-shadow: 0 24px 60px -12px rgba(26, 25, 24, 0.22);
  }
  .pin {
    position: absolute;
    left: 64%;
    top: 44%;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    border-radius: 50% 50% 50% 4px;
    background: var(--color-ink);
    color: var(--color-ground);
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 500;
  }
  .note {
    position: absolute;
    left: calc(64% + 24px);
    top: 44%;
    width: 232px;
    margin-top: -14px;
    border-radius: 11px;
    background: var(--color-ground);
    box-shadow: 0 12px 32px var(--shadow);
    padding: 12px 14px;
    font-size: 14px;
    line-height: 20px;
  }
  .note small {
    display: block;
    margin-top: 6px;
    font-size: 12px;
    line-height: 18px;
    color: var(--color-ink-soft);
  }
  .bbar {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    display: flex;
    gap: 4px;
    align-items: center;
    padding: 6px;
    border-radius: 14px;
    background: var(--color-ground);
    box-shadow: 0 12px 32px var(--shadow);
    white-space: nowrap;
  }
  .bitem {
    height: 36px;
    padding: 0 12px;
    border-radius: 9px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: 14px;
  }
  .bitem.on {
    background: var(--color-recess);
  }
  /* The bar's actions are pills, like every action button. */
  .bbar .bitem {
    border-radius: 999px;
  }
  .bbar .bnav {
    gap: 6px;
    padding: 0 8px;
  }
  .bbar .bnav .dimmed {
    opacity: 0.4;
  }
  /* On a phone the bar is two rows: the version arrows, then the actions. */
  @media (max-width: 640px) {
    .bbar {
      flex-wrap: wrap;
      justify-content: center;
      width: calc(100% - 24px);
    }
    .bbar .bnav {
      flex: 1 0 100%;
      justify-content: center;
    }
  }
  .stored {
    display: inline-flex;
    margin-left: 8px;
    vertical-align: 1px;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border-radius: 999px;
    background: var(--color-recess);
    color: var(--color-ink-soft);
    font-size: 12px;
    line-height: 1;
    font-weight: 400;
    white-space: nowrap;
  }
  .tagrow {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }
  .tagrow .tag {
    height: 26px;
    padding: 0 10px;
    border-radius: 999px;
  }
  /* The chosen chip is a fill in the selection blue, with ink type. */
  .tag.on {
    background: color-mix(in srgb, var(--sel) 16%, var(--color-ground));
  }
  .res mark {
    padding: 0 2px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--sel) 18%, transparent);
    color: inherit;
  }

  /* Plans */
  .plans {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 20px;
    align-items: stretch;
  }
  .plans ul {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .plans li {
    font-size: 16px;
    line-height: 26px;
    display: flex;
    gap: 10px;
    color: var(--color-ink-soft);
  }
  .plans li::before {
    content: '';
    flex: 0 0 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-ink-soft);
    margin-top: 10px;
  }
  .hosted-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  /* With the form, the card is two columns: text, then the form at the foot
     of the left column, and the picture across the full height on the right.
     The inner wrapper steps aside so the picture, text and form are grid items. */
  .hosted-card.with-form {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    grid-template-areas:
      'text pic'
      'form pic';
    gap: 0 12px;
  }
  .hosted-card.with-form > div {
    display: contents;
  }
  .hosted-card.with-form .shot {
    grid-area: pic;
    height: auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 16px;
    -webkit-mask-image: none;
    mask-image: none;
  }
  /* The sketch fills the column: link row at the top, the comment at the
     foot, and the page between them takes whatever height is left. */
  .hosted-card.with-form .q {
    flex: none;
  }
  .hosted-card.with-form .hshot {
    flex: 1 1 auto;
    width: 100%;
    min-height: 140px;
  }
  .hosted-card.with-form .hshot .thumb {
    height: 100%;
    aspect-ratio: auto;
  }
  .hosted-card.with-form .bub {
    flex: none;
  }
  .hosted-card.with-form .tx2 {
    grid-area: text;
  }
  .hosted-card:not(.with-form) > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    align-items: stretch;
  }
  .hosted-card:not(.with-form) .shot {
    height: auto;
    min-height: 176px;
  }
  /* Below 1180px the two plans stack, so the local one lays its picture beside
     its text and neither card has blank space under its content. */
  @media (max-width: 1180px) {
    .plans {
      grid-template-columns: minmax(0, 1fr);
    }
    .plans > .panel:first-child {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0 12px;
      align-items: center;
    }
  }
  .wrow .muted {
    display: none;
  }
  .hshot {
    position: relative;
    width: 62%;
    margin: 0 auto;
  }
  .hpin {
    position: absolute;
    left: 16%;
    top: 52%;
    width: 22px;
    height: 22px;
    border-radius: 50% 50% 50% 4px;
    background: var(--color-ink);
    color: var(--color-ground);
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 500;
  }
  .bub {
    display: flex;
    gap: 10px;
    align-items: center;
    font-size: 13px;
    line-height: 18px;
  }
  .av {
    flex: 0 0 26px;
    height: 26px;
    border-radius: 50%;
    background: #e6dffb;
    color: #4b2fb3;
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 600;
  }
  .soon {
    margin-top: 16px;
    font-weight: 500;
  }

  /* The waitlist form sits straight on the hosted card. The card has 12px of
     padding, so 12px more here makes 24px on every side (20px on phones). */
  .form {
    grid-area: form;
    container-type: inline-size;
    max-width: 504px;
    margin: 12px 12px 12px;
    padding-top: 24px;
    border-top: 1px solid var(--edge);
  }
  .form-hint {
    margin-top: 4px;
    font-size: 16px;
    line-height: 26px;
  }
  .frow {
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }
  .wl-field label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
    line-height: 20px;
    font-weight: 500;
  }
  .wl-field input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 44px;
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    border-radius: 11px;
    border: 1px solid var(--color-input-border);
    background: var(--color-ground);
    color: var(--color-ink);
    font: inherit;
    padding: 0 12px;
  }
  .frow .hbtn {
    box-sizing: border-box;
    height: 44px;
    padding: 0 20px;
    font-size: 15px;
    line-height: 20px;
  }
  /* The field keeps at least 260px beside the button. Narrower than that, the
     button sits below it at full width. */
  @container (min-width: 460px) {
    .frow {
      grid-template-columns: minmax(260px, 1fr) auto;
      align-items: end;
    }
  }
  .form-note {
    margin-top: 12px;
  }
  .form-status {
    min-height: 20px;
    margin-top: 8px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Footer */
  .foot {
    padding-block: 72px 40px;
  }
.mark {
    position: relative;
    container-type: inline-size;
    border-radius: 14px;
  }
  .mark::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background-color: var(--color-panel);
    background-image: radial-gradient(var(--edge) 1px, transparent 1px);
