---
/**
 * The homepage's styles, in one place, drawn from the site's tokens. Rounded
 * panels have no border; floating pieces get a faint shadow ring. Everything
 * that moves moves by transform or opacity on the one curve.
 */
---

<style is:global>
  .home {
    --ease: cubic-bezier(0.2, 0, 0, 1);
    --edge: color-mix(in srgb, var(--color-ink) 9%, transparent);
    --shadow: rgba(26, 25, 24, 0.12);
    font-size: 15px;
    line-height: 24px;
  }
  @media (prefers-color-scheme: dark) {
    :root[data-app-theme='system'] .home {
      --shadow: rgba(0, 0, 0, 0.4);
    }
  }
  :root[data-app-theme='dark'] .home {
    --shadow: rgba(0, 0, 0, 0.4);
  }
  .home h1,
  .home h2,
  .home h3,
  .home p {
    margin: 0;
  }
  .home h1 {
    font-size: 48px;
    line-height: 52px;
    font-weight: 400;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .home h2 {
    font-size: 32px;
    line-height: 38px;
    font-weight: 400;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .home h3 {
    font-size: 18px;
    line-height: 26px;
    font-weight: 500;
    text-wrap: balance;
  }
  .home p {
    text-wrap: pretty;
  }
  .home .lede {
    font-size: 16px;
    line-height: 26px;
    color: var(--color-ink-soft);
  }
  .home .muted {
    color: var(--color-ink-soft);
  }
  .home .mono {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .home .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .home a:focus-visible,
  .home button:focus-visible,
  .home input:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* Buttons: pills for actions, 38px high. Rectangles for utility controls. */
  .hbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--color-input-border);
    background: transparent;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 160ms var(--ease);
  }
  .hbtn:active {
    transform: scale(0.97);
  }
  .hbtn-primary {
    background: var(--color-ink);
    color: var(--color-ground);
    border-color: var(--color-ink);
  }
  .hbtn-small {
    height: 36px;
    padding: 0 16px;
  }
  .hbtn-wide {
    width: 100%;
  }
  .util {
    height: 32px;
    padding: 0 12px;
    border-radius: 9px;
    border: 1px solid var(--color-input-border);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: transform 160ms var(--ease);
  }
  .util:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .util:hover,
    .opt:hover {
      background: var(--color-recess);
    }
    .opt-input:checked + .opt:hover {
      background: var(--color-ink);
    }
  }

  /* Top bar */
  .top {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 64px;
    flex-wrap: wrap;
  }
  .lockup {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
    margin-right: auto;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 9px;
  }
  .top nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .top nav a {
    min-height: 44px;
    padding: 0 12px;
    display: inline-flex;
    align-items: center;
    border-radius: 9px;
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 15px;
  }
  .top nav a[aria-current='page'] {
    color: var(--color-ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .top nav a:hover {
      color: var(--color-ink);
    }
  }

  /* Hero */
  .hero {
    padding: 40px 0 72px;
  }
  .htext {
    max-width: 640px;
    margin: 0 0 40px;
  }
  .htext .lede {
    margin-top: 14px;
    max-width: 50ch;
  }
  .cta {
    display: flex;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
    align-items: center;
  }
  .fine {
    margin-top: 14px;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink-soft);
  }
  .setup {
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: 11px;
    background: var(--color-panel);
    padding: 6px 6px 6px 18px;
    width: fit-content;
    max-width: 100%;
    min-width: 0;
  }
  .setup code {
    font-family: var(--font-mono);
    font-size: 14px;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .setup code::-webkit-scrollbar {
    display: none;
  }
  .setup .hbtn,
  .setup .util {
    flex: none;
  }
  .setup .util {
    height: 36px;
  }

  /* The stage: the app on one grey panel, a terminal over its lower left */
  .stage {
    position: relative;
    border-radius: 14px;
    background: var(--color-panel);
    padding: 56px 56px 72px;
  }
  .app {
    border-radius: 14px;
    background: var(--color-ground);
    box-shadow:
      0 0 0 1px var(--edge),
      0 20px 50px var(--shadow);
    font-size: 13px;
    line-height: 18px;
    overflow: hidden;
  }
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    background: var(--color-panel);
  }
  .bar b {
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
    font-weight: 500;
    color: var(--color-ink-soft);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-recess);
  }
  .cols2 {
    display: flex;
  }
  .side {
    flex: 0 0 208px;
    background: var(--color-panel);
    padding: 10px 10px 0;
    display: grid;
    gap: 2px;
    align-content: start;
  }
  .sitem {
    display: flex;
    align-items: center;
    height: 30px;
    padding: 0 10px;
    border-radius: 7px;
    color: var(--color-ink-soft);
  }
  .sitem.on {
    background: var(--color-recess);
    color: var(--color-ink);
    font-weight: 500;
  }
  .sitem span {
    margin-left: auto;
    font-size: 12px;
  }
  .shead {
    margin: 16px 10px 4px;
    font-size: 12px;
    color: var(--color-ink-soft);
  }
  .main {
    flex: 1;
    min-width: 0;
    padding: 14px 24px 96px;
  }
  .tools {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .find {
    flex: 1;
    min-width: 0;
    height: 32px;
    border-radius: 9px;
    border: 1px solid var(--color-input-border);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 10px;
    color: var(--color-ink-soft);
    white-space: nowrap;
    overflow: hidden;
  }
  .add {
    height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-ground);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 10px;
    border-radius: 9px;
    background: var(--color-recess);
    font-size: 12px;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .chip i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2e9e6b;
  }
  .prow {
    margin-top: 20px;
  }
  .phead {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 10px;
  }
  .phead b {
    font-weight: 500;
    font-size: 15px;
  }
  .shelf {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .slot {
    position: relative;
    min-width: 0;
  }
  .landing {
    position: absolute;
    inset: 0 0 auto 0;
    height: 133px;
    border-radius: 11px;
    border: 1px dashed var(--color-input-border);
    display: grid;
    place-items: center;
    text-align: center;
    color: var(--color-ink-soft);
    font-size: 12px;
    padding: 0 10px;
  }
  .pcard {
    position: relative;
  }
  .pcard.sel .thumb {
    box-shadow: 0 0 0 1.5px var(--color-ink);
  }
  .pname {
    margin-top: 8px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pmeta {
    color: var(--color-ink-soft);
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .star {
    position: absolute;
    right: 8px;
    top: 8px;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: rgba(26, 25, 24, 0.82);
    color: #edebe6;
    display: grid;
    place-items: center;
  }

  /* A prototype thumbnail: a small drawn page, one accent each */
  .thumb {
    --a: #1a1918;
    --a2: #e4e2dd;
    height: 104px;
    border-radius: 8px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(26, 25, 24, 0.08),
      0 1px 2px rgba(26, 25, 24, 0.06);
    padding: 8px;
    overflow: hidden;
    color: #1a1918;
    font-size: 7px;
    line-height: 9px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .a-blue {
    --a: #2f5bea;
    --a2: #dce5fd;
  }
  .a-green {
    --a: #1f7a54;
    --a2: #d8eee3;
  }
  .a-violet {
    --a: #6b46e0;
    --a2: #e6dffb;
  }
  .a-coral {
    --a: #d9482b;
    --a2: #fbdfd6;
  }
  .app .thumb {
    zoom: 1.42;
    height: 94px;
  }
  .thumb u,
  .thumb i {
    display: block;
    text-decoration: none;
    font-style: normal;
  }
  .nv {
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .nv i {
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--a);
    margin-right: auto;
  }
  .nv u {
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background: #c9c5bd;
  }
  .hd {
    font-weight: 600;
    font-size: 8px;
    line-height: 10px;
    white-space: nowrap;
  }
  .tx {
    height: 2px;
    border-radius: 1px;
    background: #c9c5bd;
  }
  .cols {
    display: flex;
    gap: 4px;
    flex: 1;
    min-height: 0;
  }
  .tier {
    flex: 1;
    min-width: 0;
    border: 1px solid #e4e2dd;
    border-radius: 4px;
    padding: 4px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    background: #fff;
  }
  .tier.hot {
    border-color: var(--a);
    background: var(--a2);
  }
  .pr {
    font-weight: 600;
    font-size: 9px;
    line-height: 10px;
    white-space: nowrap;
  }
  .bt {
    margin-top: auto;
    flex: 0 0 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--a);
    color: #fff;
    font-size: 5px;
    line-height: 9px;
    text-align: center;
    white-space: nowrap;
  }
  .bt.o {
    background: transparent;
    color: var(--a);
    border: 1px solid var(--a);
    line-height: 7px;
  }
  .inp {
    flex: 0 0 10px;
    border-radius: 2px;
    border: 1px solid #b5b1a9;
    background: #fff;
  }
  .tog {
    align-self: flex-start;
    display: flex;
    border-radius: 999px;
    background: #e4e2dd;
    padding: 1px;
    font-size: 5px;
    line-height: 8px;
  }
  .tog b {
    padding: 0 4px;
    border-radius: 999px;
    font-weight: 500;
  }
  .tog b.on {
    background: var(--a);
    color: #fff;
  }
  .img {
    flex: 1;
    min-height: 0;
    border-radius: 4px;
    background: var(--a2);
  }
  .steps {
    display: flex;
    gap: 3px;
  }
  .steps i {
    flex: 1;
    height: 2px;
    border-radius: 1px;
    background: #dedbd5;
  }
  .steps i.on {
    background: var(--a);
  }
  .rowi {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .rowi i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--a2);
  }
  .rowi u {
    flex: 1;
    height: 2px;
    border-radius: 1px;
    background: #c9c5bd;
  }

  /* The terminal over the stage */
  .term {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: min(470px, calc(100% - 48px));
    border-radius: 11px;
    background: #151413;
    color: #edebe6;
    box-shadow:
      0 0 0 1px rgba(119, 115, 107, 0.4),
      0 18px 44px rgba(0, 0, 0, 0.4);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 19px;
    overflow: hidden;
  }
  .tbar {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 10px;
    color: #a29e96;
  }
  .term .lights i {
    background: #2e2d2a;
  }
  .tbody {
    padding: 6px 12px 14px;
    display: grid;
    gap: 4px;
    min-height: 100px;
    align-content: start;
  }
  .dim {
    color: #a29e96;
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 15px;
    background: var(--color-ink);
    vertical-align: -3px;
    margin-left: 1px;
  }
  .term .caret {
    background: #edebe6;
    height: 13px;
    vertical-align: -2px;
  }

  /* Bands */
  .band {
    padding: 72px 0;
  }
  .band .lede {
    margin-top: 14px;
    max-width: 56ch;
  }
  .panel {
    border-radius: 14px;
    background: var(--color-panel);
    padding: 12px;
  }
  .panel .tx2 {
    padding: 16px 12px 12px;
  }
  .panel .tx2 p {
    margin-top: 8px;
    color: var(--color-ink-soft);
  }
  .three {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .mini-t .tog b {
    font-size: 0;
    padding: 2px 6px;
  }
  .srcs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
  }
  .shot {
    height: 176px;
    border-radius: 9px;
    background: var(--color-ground);
    padding: 20px;
    display: grid;
    align-content: center;
    gap: 12px;
    overflow: hidden;
  }
  .shot.dark {
    background: #1a1918;
    color: #edebe6;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    gap: 2px;
  }
  .q {
    height: 40px;
    border-radius: 9px;
    border: 1px solid var(--color-input-border);
    background: var(--color-ground);
    display: flex;
    align-items: center;
    padding: 0 6px 0 12px;
    gap: 8px;
    white-space: nowrap;
    overflow: hidden;
  }
  .q > span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini {
    margin-left: auto;
    flex: 0 0 auto;
    height: 28px;
    padding: 0 10px;
    border-radius: 7px;
    background: var(--color-ink);
    color: var(--color-ground);
    font-size: 12px;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
  }
  .lrow {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 13px;
    line-height: 18px;
  }
  .lrow b {
    display: block;
    font-weight: 500;
  }
  .mini-t {
    flex: 0 0 auto;
  }
  .mini-t .thumb {
    zoom: 0.5;
    width: 128px;
    height: 88px;
  }
  .dropz {
    height: 136px;
    border-radius: 9px;
    border: 1px dashed var(--color-input-border);
    display: grid;
    place-items: center;
    align-content: center;
    gap: 8px;
    font-size: 13px;
  }

  /* The ink panel, the same in both themes */
  .tint {
    --pbg: #1a1918;
    --pink: #f3f0eb;
    --pmuted: #b0aba3;
    border-radius: 14px;
    background: var(--pbg);
    color: var(--pink);
    padding: 56px 56px 48px;
    margin-top: 40px;
    overflow: hidden;
  }
  .say {
    font-size: 14px;
    line-height: 22px;
    color: var(--pmuted);
  }
  .tint .muted {
    color: var(--pmuted);
  }
  .home .big {
    margin-top: 10px;
    font-size: 44px;
    line-height: 50px;
    font-weight: 400;
    letter-spacing: -0.035em;
    min-height: 100px;
    max-width: 20ch;
  }
  .big .caret {
    background: var(--color-orange);
    width: 3px;
    height: 38px;
    vertical-align: -7px;
    margin-left: 3px;
  }
  .plabel {
    display: flex;
    gap: 8px;
    align-items: baseline;
    margin-top: 36px;
  }
  .plabel b {
    font-weight: 500;
  }
  .pile {
    position: relative;
    height: 178px;
    margin-top: 12px;
  }
  .kcard {
    position: absolute;
    top: 0;
    width: 176px;
    font-size: 13px;
    line-height: 18px;
    transition: transform 400ms var(--ease);
  }
  .kcard .thumb {
    height: 118px;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.22);
  }
  .after {
    display: flex;
    gap: 20px 28px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .after .fine {
    margin-top: 0;
    max-width: 52ch;
  }
  .fine a {
    color: var(--color-ink);
  }

  /* Search and open */
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .read {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-top: 32px;
    border-radius: 14px;
    background: var(--color-panel);
    padding: 20px;
  }
  .read .thumb {
    flex: 0 0 168px;
    height: 112px;
  }
  .read small {
    display: block;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink-soft);
    margin-bottom: 8px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 7px;
    background: var(--color-recess);
    font-size: 12px;
    line-height: 1;
    white-space: nowrap;
  }
  .results {
    border-radius: 14px;
    background: var(--color-panel);
    padding: 14px;
    display: grid;
    gap: 4px;
  }
  .results .q {
    margin-bottom: 8px;
  }
  .res {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 14px;
    align-items: start;
    padding: 12px;
    border-radius: 9px;
    font-size: 13px;
  }
  .res.on {
    background: var(--color-ground);
  }
  .res b {
    display: block;
    font-weight: 500;
    font-size: 15px;
  }
  .res small {
    display: block;
    font-size: 13px;
    line-height: 20px;
    color: var(--color-ink-soft);
    margin-bottom: 8px;
  }
  .canvas {
    position: relative;
    height: 500px;
    margin-top: 40px;
    border-radius: 14px;
    background-color: var(--color-panel);
    background-image: radial-gradient(var(--edge) 1px, transparent 1px);
    background-size: 22px 22px;
    overflow: hidden;
  }
  .ctitle {
    position: absolute;
    left: 24px;
    top: 20px;
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 14px;
  }
  .ctitle b {
    font-weight: 500;
  }
  .page {
    position: absolute;
    left: 50%;
    top: 44px;
    margin-left: -323px;
  }
  .page .thumb {
    zoom: 3.4;
    width: 190px;
