---
import Thumb from './Thumb.astro';
import { tie } from '../../lib/words';
import type { ThumbKey } from '../../lib/thumbs';

/** One match per row. The word searched for is marked in its summary. */
const RESULTS: Array<[ThumbKey, string, string, string[], string, boolean]> = [
  ['people', 'People', 'Everyone on the <mark>team</mark>, with roles and last active.', ['Web app', 'People', 'localhost:5173'], 'Tuesday', true],
  ['price', 'Pricing', 'Free, <mark>Team</mark> and Company plans, billed monthly.', ['Marketing site', 'Pricing', 'Lovable'], 'Last week', false],
  ['land', 'Landing page', 'One place for every notebook your <mark>team</mark> writes.', ['Marketing site', 'Landing page', 'Bolt'], 'Monday', false],
];
---

<section class="band split" id="find" aria-labelledby="h-find">
  <div class="bhead">
    <h2 id="h-find">{tie('Search every prototype by what’s in it.')}</h2>
    <p class="lede">{tie('Canon reads a linked prototype’s title and headings, then tags it for you. Search by name, tag, summary, source or note. Your agent can add or remove tags, and tags filter Home in one click.')}</p>
  </div>
  <div class="bbody two">
  <div class="results" role="img" aria-label="Search results for the word team. A row of project chips sits above three prototypes, People, Pricing and Landing page, each with its tags.">
    <div class="q">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3"></path></svg>
      <span>team</span><span class="caret" style="margin-left:-6px"></span>
    </div>
    <div class="tagrow" aria-hidden="true">
      <span class="tag on">All</span>
      <span class="tag">Web app</span>
      <span class="tag">Marketing site</span>
      <span class="tag">iPhone app</span>
    </div>
    {
      RESULTS.map(([k, name, sub, tags, when, on]) => (
        <div class:list={['res', on && 'on']} aria-hidden="true">
          <div class="mini-t"><Thumb k={k} /></div>
          <div>
            <b>{name}</b>
            <small set:html={sub} />
            <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
          </div>
          <span class="muted">{when}</span>
        </div>
      ))
    }
  </div>
    <div class="read" role="img" aria-label="The Pricing prototype and the five tags Canon gave it.">
      <Thumb k="price" />
      <div>
        <small>Tagged when it was added</small>
        <div class="tags" aria-hidden="true">
          {['Marketing site', 'Pricing', 'Team plan', 'Lovable', 'fieldnote-pricing'].map((t) => <span class="tag">{t}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>
