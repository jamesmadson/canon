---
import Thumb from './Thumb.astro';
import { tie } from '../../lib/words';
---

<section class="band" id="ways" aria-labelledby="h-ways">
  <h2 id="h-ways">{tie('Three ways in.')}</h2>
  <p class="lede">{tie('A link, a zip or whatever your agent just built. However a prototype was made, it lands in the same place.')}</p>
  <div class="three">
    <div class="panel">
      <div class="shot dark" role="img" aria-label="A terminal where you ask your agent to add a page to Canon.">
        <div><span class="dim">&gt;</span> add this page to Canon</div>
        <div><span class="dim">⏺ canon_add</span> “Invite a teammate”</div>
        <div class="dim">{tie('Added to Onboarding.')}</div>
      </div>
      <div class="tx2">
        <h3>{tie('Ask your agent')}</h3>
        <p>{tie('Your coding agent adds what it just built, names it and notes where it came from.')}</p>
        <div class="srcs"><span class="chip">Claude Code</span><span class="chip">Codex</span><span class="chip">Cursor</span></div>
      </div>
    </div>
    <div class="panel">
      <div class="shot" role="img" aria-label="A link pasted into Canon becomes a card.">
        <div class="q"><span class="mono">v0.app/t/welcome-single-screen</span><span class="mini">Add</span></div>
        <div class="lrow">
          <div class="mini-t"><Thumb k="w2" /></div>
          <div><b>Welcome, single screen</b><span class="muted">v0 · added just now</span></div>
        </div>
      </div>
      <div class="tx2">
        <h3>{tie('Paste a link')}</h3>
        <p>{tie('A share link from any tool becomes a card on your project.')}</p>
        <div class="srcs"><span class="chip">Figma</span><span class="chip">v0</span><span class="chip">Lovable</span><span class="chip">GitHub Pages</span></div>
      </div>
    </div>
    <div class="panel">
      <div class="shot" role="img" aria-label="A zip file dropped onto a project.">
        <div class="dropz"><span class="chip mono">mobile-sign-up.zip</span><span class="muted">Drop it on a project</span></div>
      </div>
      <div class="tx2">
        <h3>{tie('Drop a zip')}</h3>
        <p>{tie('Drag a zip of built pages onto a project. Canon keeps a copy on your machine and opens it from there.')}</p>
        <div class="srcs"><span class="chip">.zip</span><span class="chip">A folder</span></div>
      </div>
    </div>
  </div>
</section>
