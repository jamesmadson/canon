---
import Thumb from './Thumb.astro';
import { tie } from '../../lib/words';
---

<section class="band" id="projects" aria-labelledby="h-projects">
  <div class="bhead">
    <h2 id="h-projects">{tie('Every prototype lands in a project.')}</h2>
    <p class="lede">{tie('A link, a zip or whatever your agent just built. However it was made, it is filed under the project it belongs to, beside its earlier versions.')}</p>
  </div>
  <div class="three">
    <div class="panel">
        <span class="num" aria-hidden="true">1</span>
      <div class="shot dark" role="img" aria-label="A terminal where you ask your agent to add a page to Canon.">
        <div><span class="dim">&gt;</span> add this page to Canon</div>
        <div><span class="dim">⏺ canon_add</span> “Invite a teammate”</div>
        <div class="dim">{tie('Added to Onboarding.')}</div>
      </div>
      <div class="tx2">
        <h3>{tie('Ask your agent')}</h3>
        <p>{tie('Your coding agent adds what it just built, names it and notes where it came from.')}</p>
        <ul class="srcs"><li>Claude Code</li><li>Codex</li><li>Cursor</li></ul>
      </div>
    </div>
    <div class="panel">
        <span class="num" aria-hidden="true">2</span>
      <div class="shot" role="img" aria-label="A link pasted into Canon becomes a card.">
        <div class="q"><span class="mono">welcome-single-screen.lovable.app</span><span class="mini">Add</span></div>
        <div class="lrow">
          <div class="mini-t"><Thumb k="w2" /></div>
          <div><b>Welcome, single screen</b><span class="muted">Lovable · added just now</span></div>
        </div>
      </div>
      <div class="tx2">
        <h3>{tie('Paste a link')}</h3>
        <p>{tie('A share link from any tool becomes a card on your project.')}</p>
        <ul class="srcs"><li>Figma</li><li>v0</li><li>Lovable</li><li>GitHub Pages</li></ul>
      </div>
    </div>
    <div class="panel">
        <span class="num" aria-hidden="true">3</span>
      <div class="shot" role="img" aria-label="A zip file dropped onto a project.">
        <div class="dropz"><span class="chip mono">mobile-sign-up.zip</span><span class="muted">Drop it on a project</span></div>
      </div>
      <div class="tx2">
        <h3>{tie('Drop a zip')}</h3>
        <p>{tie('Drag a zip of built pages onto a project. Canon keeps a copy on your machine and opens it from there.')}</p>
        <ul class="srcs"><li>.zip</li><li>A folder</li></ul>
      </div>
    </div>
  </div>
  <div class="proj" role="img" aria-label="The Onboarding project with five prototypes in a row, one from each source: Claude Code, Lovable, Figma Make, v0 and a zip.">
    <div class="shead" aria-hidden="true"><b>Onboarding</b><span class="muted">5 prototypes</span></div>
    <div class="shelf" aria-hidden="true">
        <div class="slot">
          <div class="scard">
            <Thumb k="w1" />
            <div class="pname">Welcome, three steps</div>
            <div class="pmeta">Claude Code</div>
          </div>
        </div>
        <div class="slot">
          <div class="scard">
            <Thumb k="w2" />
            <div class="pname">Welcome, single screen</div>
            <div class="pmeta">Lovable</div>
          </div>
        </div>
        <div class="slot">
          <div class="scard">
            <Thumb k="w3" />
            <div class="pname">Invite a teammate</div>
            <div class="pmeta">Figma Make</div>
          </div>
        </div>
        <div class="slot">
          <div class="scard">
            <Thumb k="w4" />
            <div class="pname">Empty dashboard, with sample data</div>
            <div class="pmeta">v0</div>
          </div>
        </div>
        <div class="slot">
          <div class="scard">
            <Thumb k="w5" />
            <div class="pname">Mobile sign-up</div>
            <div class="pmeta">zip</div>
          </div>
        </div>
    </div>
  </div>
</section>
