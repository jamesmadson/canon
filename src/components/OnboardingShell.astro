---
import BaseLayout from '../layouts/BaseLayout.astro';
import MeshPanel from './MeshPanel.astro';
import PreviewLabel from './PreviewLabel.astro';
import RamsMark from './RamsMark.astro';
import type { MarkName } from './RamsMark.astro';
import { withBase } from '../lib/withBase';

interface Props {
  title: string;
  description: string;
  /** 1-based index into STEPS. */
  step: number;
}

/**
 * One mark per step, chosen so the four read as a sequence rather than four
 * unrelated pictures: a whole disc, then it splits into rules, then into
 * stripes, then into faders you can set.
 */
const STEPS: { label: string; href: string; mark: MarkName }[] = [
  { label: 'Project', href: '/v2-preview/onboarding/project/', mark: 'disc' },
  { label: 'GitHub', href: '/v2-preview/onboarding/github/', mark: 'line-stack' },
  { label: 'Figma', href: '/v2-preview/onboarding/figma/', mark: 'split-stripe' },
  { label: 'Skills', href: '/v2-preview/onboarding/skills/', mark: 'fader' },
];

const { title, description, step } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <p class="mb-4 label">
    Canon v2 preview · onboarding
  </p>

  <div data-app-shell class="mx-auto max-w-xl overflow-hidden rounded-lg bg-ground text-ink">
    <PreviewLabel placement="top" />

    {/* The step strip is a row of fills, not a row of tabs: done and current
        carry a surface, the ones ahead sit on the ground with nothing yet. */}
    <ol class="flex gap-[2px] p-2" aria-label="Onboarding steps">
      {STEPS.map((s, i) => (
        <li class="flex-1">
          {i + 1 < step ? (
            <a
              href={withBase(s.href)}
              class="flex min-h-11 items-center justify-center gap-2 rounded-sm bg-recess px-2 py-3 label text-ink transition-colors hover:bg-panel focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
            >
              <span aria-hidden="true">●</span> {s.label}
            </a>
          ) : (
            <span
              class:list={[
                'flex min-h-11 items-center justify-center gap-2 rounded-sm px-2 py-3 label',
                i + 1 === step ? 'bg-panel text-ink' : 'text-ink-soft',
              ]}
              aria-current={i + 1 === step ? 'step' : undefined}
            >
              <span aria-hidden="true">{i + 1 === step ? '●' : '○'}</span> {s.label}
            </span>
          )}
        </li>
      ))}
    </ol>

    <MeshPanel radius="sm" class="mx-2 flex items-center justify-center px-6 py-8">
      <RamsMark name={STEPS[step - 1].mark} size={80} />
    </MeshPanel>

    <div class="px-4 pt-6 pb-6 sm:px-6 sm:pb-8">
      <slot />
    </div>
  </div>
</BaseLayout>
