---
import BaseLayout from '../layouts/BaseLayout.astro';
import PreviewLabel from './PreviewLabel.astro';
import { withBase } from '../lib/withBase';

interface Props {
  title: string;
  description: string;
  /** 1-based index into STEPS. */
  step: number;
}

const STEPS = [
  { label: 'Project', href: '/v2-preview/onboarding/project/' },
  { label: 'GitHub', href: '/v2-preview/onboarding/github/' },
  { label: 'Figma', href: '/v2-preview/onboarding/figma/' },
  { label: 'Skills', href: '/v2-preview/onboarding/skills/' },
];

const { title, description, step } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <p class="mb-4 text-[11px] font-semibold uppercase tracking-wide text-ink-soft">
    Canon v2 preview · onboarding
  </p>

  <div class="mx-auto max-w-xl overflow-hidden rounded-lg border border-rule-strong">
    <PreviewLabel placement="top" />

    <ol class="flex border-b border-rule" aria-label="Onboarding steps">
      {STEPS.map((s, i) => (
        <li class="flex-1">
          {i + 1 < step ? (
            <a
              href={withBase(s.href)}
              class="flex min-h-11 items-center justify-center gap-1.5 px-2 py-3 text-[11px] font-semibold uppercase tracking-wide text-ink transition-colors hover:bg-surface/60 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
            >
              <span aria-hidden="true">●</span> {s.label}
            </a>
          ) : (
            <span
              class:list={[
                'flex min-h-11 items-center justify-center gap-1.5 px-2 py-3 text-[11px] font-semibold uppercase tracking-wide',
                i + 1 === step ? 'border-b-2 border-ink text-ink' : 'text-ink-soft',
              ]}
              aria-current={i + 1 === step ? 'step' : undefined}
            >
              <span aria-hidden="true">{i + 1 === step ? '●' : '○'}</span> {s.label}
            </span>
          )}
        </li>
      ))}
    </ol>

    <div class="px-4 py-6 sm:px-6 sm:py-8">
      <slot />
    </div>
  </div>
</BaseLayout>
