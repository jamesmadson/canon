---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A curated gallery of design and design-engineering skills for AI agents.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Canon</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-bg font-sans font-medium text-ink antialiased">
    <header class="border-b border-rule">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-8">
        <a href="/" class="text-xl font-semibold">Canon</a>
        <nav class="flex gap-6 text-sm font-semibold">
          <a href="/skills" class="text-ink-soft transition-colors hover:text-ink focus-visible:text-ink">Gallery</a>
          <a href="/submit" class="text-ink-soft transition-colors hover:text-ink focus-visible:text-ink">Submit</a>
          <a href="/newsletter" class="text-ink-soft transition-colors hover:text-ink focus-visible:text-ink">Newsletter</a>
        </nav>
      </div>
    </header>
    <main class="grid-overlay mx-auto max-w-6xl px-6 pb-24">
      <slot />
    </main>
    <footer class="border-t border-rule mx-auto max-w-6xl px-6 py-12 text-sm font-medium text-ink-soft">
      <p>A hand-picked gallery of design and design-engineering skills.</p>
    </footer>
    <button
      type="button"
      id="grid-toggle"
      class="fixed bottom-5 right-5 z-10 border border-rule-strong bg-bg px-3.5 py-2 text-xs font-semibold tracking-wide text-ink-soft hover:text-ink"
      aria-pressed="false"
    >
      Grid — Off
    </button>
  </body>
</html>

<script>
  const btn = document.getElementById('grid-toggle') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    const on = document.documentElement.classList.toggle('grid-visible');
    btn.textContent = `Grid — ${on ? 'On' : 'Off'}`;
    btn.setAttribute('aria-pressed', String(on));
  });
</script>
