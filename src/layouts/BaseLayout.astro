---
import '../styles/global.css';
import HomeStyles from '../components/home/HomeStyles.astro';
import SiteHeader from '../components/home/SiteHeader.astro';
import SiteFooter from '../components/home/SiteFooter.astro';
import SectionNav from '../components/home/SectionNav.astro';
import Analytics from '../components/home/Analytics.astro';
import { withBase } from '../lib/withBase';

interface Props {
  title: string;
  description?: string;
  /**
   * Let the page draw its own sections, each in the shared `.wrap` container,
   * rather than the layout wrapping the whole page in it.
   * The homepage is the only thing that needs it.
   */
  wide?: boolean;
  /**
   * The page opens on the homepage hero, which has its own Open the app
   * button, so the header leaves its copy out.
   */
  hero?: boolean;
  /** Keeps the page out of search results, for pages that are only for comparing. */
  noindex?: boolean;
  /** With noindex, also asks crawlers not to follow the page's links. */
  nofollow?: boolean;
}

const {
  title,
  description = 'Every prototype, from any tool, in one place.',
  wide = false,
  hero = false,
  noindex = false,
  nofollow = false,
} = Astro.props;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Canon</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content={nofollow ? 'noindex, nofollow' : 'noindex'} />}
    <meta property="og:title" content={`${title} · Canon`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Canon" />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · Canon`} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={withBase('/icons/canon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/icons/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="preload" href={withBase('/fonts/geist/Geist-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/fonts/geist/Geist-Medium.woff2')} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Lets the page start its demos from their first frame. Without this, or
      // with reduced motion, every demo is already on its last frame.
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <HomeStyles />
  </head>
  <body class="bg-ground font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-sm focus:bg-panel focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    <SiteHeader app={!hero} />
    <main
      id="main"
      class:list={[
        wide ? 'pb-0' : 'wrap pt-8 pb-24 sm:pt-12',
      ]}
    >
      <slot />
    </main>
    <SiteFooter />
    <SectionNav />
    <Analytics />
    <slot name="after-footer" />
</body>
</html>
