---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Wordmark from '../components/Wordmark.astro';
import { withBase } from '../lib/withBase';
import { spellNumber } from '../lib/spellNumber';

interface Props {
  title: string;
  description?: string;
  /**
   * Let the page draw to the edge of the viewport rather than sitting in the
   * shared six-column well. The homepage is the only thing that needs it: the
   * cover hero and the closing strip are full-bleed by construction.
   */
  wide?: boolean;
}

const {
  title,
  description = 'Canon keeps your prototypes in one place and turns feedback into evidence.',
  wide = false,
} = Astro.props;

// Derived, not written down: hiding a skill must not leave the footer
// claiming a count the gallery no longer shows.
const publishedSkills = await getCollection('skills', ({ data }) => data.status === 'active');
const skillCount = spellNumber(publishedSkills.length);

const NAV = [
  { label: 'Try it', href: '/app/' },
  { label: 'Skills', href: '/skills/' },
  { label: 'Alpha', href: '/#signup' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href.startsWith('/#') ? false : path.startsWith(withBase(href));
---

<!doctype html>
<html lang="en" data-app-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Canon</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · Canon`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Canon" />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · Canon`} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={withBase('/icons/canon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/icons/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="theme-color" content="#eeede9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191817" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={withBase('/fonts/public-sans/PublicSans-Variable.woff2')} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-ground font-sans text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-sm focus:bg-panel focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    <header class="rise">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-6 py-5">
        <a
          href={withBase('/')}
          class="flex min-h-11 items-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
        >
          <Wordmark size={22} />
        </a>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <nav aria-label="Sections" class="-mx-2 flex flex-wrap items-center text-sm">
            {NAV.map((item) => (
              <a
                href={withBase(item.href)}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="tick-bar rounded-sm aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>
    </header>
    <main
      id="main"
      class:list={[
        'rise rise-2',
        wide ? 'pb-0' : 'mx-auto max-w-6xl px-6 pt-8 pb-24 sm:pt-12',
      ]}
    >
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col gap-6 py-12 text-sm text-ink-soft sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-md">
          Every skill here was read in full, license-checked, and written up by hand.
          {` ${skillCount.charAt(0).toUpperCase()}${skillCount.slice(1)} of them, chosen from many more.`}
        </p>
        <nav aria-label="More" class="-mx-2 flex flex-wrap items-center text-sm">
          <a href={withBase('/newsletter/')} class="tick-bar rounded-sm">Newsletter</a>
          <a href={withBase('/submit/')} class="tick-bar rounded-sm">Submit</a>
          <a
            href="https://github.com/jamesmadson/canon"
            target="_blank"
            rel="noopener"
            class="tick-bar rounded-sm"
          >
            GitHub
          </a>
        </nav>
      </div>
    </footer>
    <slot name="after-footer" />
  </body>
</html>
