---
import '../styles/global.css';
import { withBase } from '../lib/withBase';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A curated gallery of design and design-engineering skills for AI agents.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Canon</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} · Canon`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Canon" />
    {Astro.site && <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} · Canon`} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" href={withBase('/fonts/archivo/Archivo-400.woff2')} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-bg font-sans font-medium text-ink antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:border focus:border-rule-strong focus:bg-bg focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    <header class="rise">
      <div class="mx-auto max-w-6xl px-6">
        <div class="flex items-center justify-between border-b border-rule py-7">
          <a
            href={withBase('/')}
            class="rounded-sm text-xl font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink"
          >
            Canon
          </a>
          <nav class="-mr-2 flex items-center gap-1 text-sm font-semibold">
            <a href={withBase('/kits')} class="rounded-md px-2 py-3 text-ink-soft transition-colors hover:text-ink focus-visible:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Kits</a>
            <a href={withBase('/skills')} class="rounded-md px-2 py-3 text-ink-soft transition-colors hover:text-ink focus-visible:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Gallery</a>
            <a href={withBase('/submit')} class="rounded-md px-2 py-3 text-ink-soft transition-colors hover:text-ink focus-visible:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Submit</a>
            <a href={withBase('/newsletter')} class="rounded-md px-2 py-3 text-ink-soft transition-colors hover:text-ink focus-visible:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">Newsletter</a>
          </nav>
        </div>
      </div>
    </header>
    <main id="main" class="grid-overlay rise rise-2 mx-auto max-w-6xl px-6 pb-24">
      <slot />
    </main>
    <footer class="mx-auto max-w-6xl px-6">
      <div class="border-t border-rule py-12 text-sm font-medium text-ink-soft">
        <p>
          Every skill here was read in full, license-checked, and written up by hand.
          Twenty of them, chosen from many more.
        </p>
      </div>
    </footer>
    <button
      type="button"
      id="grid-toggle"
      class="fixed bottom-5 right-5 z-10 hidden min-h-11 items-center rounded-md border border-rule-strong bg-bg px-3.5 py-2 text-xs font-semibold tracking-wide text-ink-soft transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink sm:flex"
      aria-pressed="false"
    >
      Grid — Off
    </button>
  </body>
</html>

<script>
  const btn = document.getElementById('grid-toggle') as HTMLButtonElement;
  btn.addEventListener('click', () => {
    const on = document.documentElement.classList.toggle('grid-visible');
    btn.textContent = `Grid — ${on ? 'On' : 'Off'}`;
    btn.setAttribute('aria-pressed', String(on));
  });
</script>
