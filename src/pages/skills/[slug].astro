---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolBadge from '../../components/ToolBadge.astro';
import { CATEGORY_META } from '../../lib/categoryMeta';
import { TOOL_META } from '../../lib/toolMeta';
import { TOOL_VALUES } from '../../content/skillSchema';
import StructureMap from '../../components/StructureMap.astro';
import DepthDots from '../../components/DepthDots.astro';
import { withBase } from '../../lib/withBase';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

export async function getStaticPaths() {
  // Hidden entries get no page at all — otherwise "hidden" only means
  // "unlinked", and the URL is still public.
  const skills = await getCollection('skills', ({ data }) => data.status === 'active');
  return skills.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  name,
  tagline,
  tools,
  categories,
  rating,
  sourceUrl,
  sourceAuthor,
  license,
  lastVerified,
  status,
  fileTree,
  contentOutline,
  previewType,
  previewAssets,
  previewNote,
} = entry.data;

// Text previews are read at build time from public/, so the page carries the
// skill's own words with no script.
const TEXT_PREVIEWS = import.meta.glob('/public/previews/**/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const previewText = previewType === 'reply' || previewType === 'file' ? TEXT_PREVIEWS[`/public${previewAssets[0]}`] : undefined;
const replyHtml = previewType === 'reply' && previewText ? (await (await createMarkdownProcessor()).render(previewText)).code : undefined;
const previewFile = previewAssets[0].split('/').pop();
---

<BaseLayout title={name} description={tagline}>
  <div class="mb-12">
    <span class="chip-outline">{CATEGORY_META[categories[0]].label}</span>
    <h1 class="display-lg mt-6 max-w-3xl">{name}</h1>
    <div class="mt-10 grid max-w-md grid-cols-8 gap-1">
      {TOOL_VALUES.map((toolValue) => {
        const active = tools.includes(toolValue);
        return (
          <div
            title={`${TOOL_META[toolValue].label}${active ? '' : ', not supported'}`}
            aria-label={`${TOOL_META[toolValue].label}: ${active ? 'supported' : 'not supported'}`}
            class={
              active
                ? 'flex aspect-square items-center justify-center rounded-sm bg-ink'
                : 'flex aspect-square items-center justify-center rounded-sm bg-recess'
            }
          >
            <span aria-hidden="true" class={active ? 'font-mono text-[10px] font-medium uppercase text-ground' : 'font-mono text-[10px] font-medium uppercase text-ink-soft'}>
              {TOOL_META[toolValue].abbr}
            </span>
          </div>
        );
      })}
    </div>
    <p class="mt-3 max-w-md text-xs text-ink-soft">
      Tool coverage: filled cells are supported. Full names under “Works with”
      below.
    </p>
  </div>

  {previewType !== 'image' && (
    <section class="mb-16" aria-labelledby="preview-heading">
      <h2 id="preview-heading" class="label mb-3">{previewType === 'page' ? 'Try it' : 'What it made'}</h2>
      {previewType === 'page' && (
        <iframe
          src={withBase(previewAssets[0])}
          title={`What ${name} made on a real run`}
          loading="lazy"
          sandbox="allow-scripts"
          class="block h-[760px] max-h-[85svh] w-full rounded-lg border border-rule bg-panel"
        ></iframe>
      )}
      {previewType === 'reply' && (
        <div class="max-h-[760px] overflow-y-auto rounded-lg border border-rule bg-panel px-6 py-6 sm:px-10 sm:py-8" tabindex="0" aria-label={`${name}'s reply`}>
          <p class="label mb-4">{name} replied</p>
          <div class="prose prose-stone max-w-[68ch] prose-headings:text-ink prose-p:text-ink-soft prose-li:text-ink-soft prose-strong:text-ink prose-code:text-ink" set:html={replyHtml} />
        </div>
      )}
      {previewType === 'file' && (
        <div class="overflow-hidden rounded-lg border border-rule bg-panel">
          <p class="border-b border-rule px-5 py-3 font-mono text-[13px] text-ink-soft">{previewFile}</p>
          <pre class="max-h-[760px] overflow-auto px-5 py-5 font-mono text-[13px] leading-[1.6] whitespace-pre-wrap text-ink" tabindex="0" aria-label={`The file ${name} wrote`}>{previewText}</pre>
        </div>
      )}
      {previewNote && <p class="mt-3 max-w-2xl text-xs text-ink-soft text-pretty">{previewNote}</p>}
    </section>
  )}

  <div class="grid grid-cols-1 gap-12 lg:grid-cols-[2fr_1fr]">
    <div>
      <p class="mb-8 text-lg font-medium text-ink-soft">{tagline}</p>
      <article class="prose prose-stone max-w-none prose-headings:text-ink prose-p:text-ink-soft prose-a:text-ink prose-a:hover:text-ink-soft prose-strong:text-ink">
        <Content />
      </article>
    </div>
    <aside class="flex flex-col gap-6 text-sm">
      {status === 'superseded' && (
        <p class="rounded-md bg-recess p-3 text-ink">
          This skill has been superseded by a newer entry.
        </p>
      )}
      <div>
        <h2 class="label mb-2">Works with</h2>
        <div class="flex flex-wrap gap-2">
          {tools.map((tool) => <ToolBadge tool={tool} />)}
        </div>
      </div>
      <div>
        <h2 class="label mb-2">Categories</h2>
        <div class="flex flex-wrap gap-2">
          {categories.map((category) => (
            <span class="chip-outline">
              {CATEGORY_META[category].label}
            </span>
          ))}
        </div>
      </div>
      <div>
        <h2 class="label mb-2">Depth</h2>
        <p><DepthDots rating={rating} /></p>
        <p class="mt-1 text-[11px] font-medium text-ink-soft">
          How much judgment this skill carries, from a single technique (1) to a
          full method (5).
        </p>
      </div>
      <div>
        <h2 class="label mb-2">Source</h2>
        <p><a href={sourceUrl} class="underline">{sourceAuthor}</a></p>
      </div>
      <div>
        <h2 class="label mb-2">License</h2>
        <p class="text-sm font-medium text-ink">{license === 'none' ? 'None stated' : license}</p>
        {license === 'none' && (
          <p class="mt-1 text-[11px] font-medium text-ink-soft">
            The source states no license, so there is no permission to use, copy, or
            modify it. Worth asking the author to add one.
          </p>
        )}
      </div>
      <div>
        <h2 class="label mb-2">Last verified</h2>
        <p class="font-medium">{lastVerified.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>
      </div>
    </aside>
  </div>

  <StructureMap name={name} tagline={tagline} fileTree={fileTree} contentOutline={contentOutline} />
</BaseLayout>
