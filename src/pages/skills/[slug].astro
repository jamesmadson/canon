---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstallBlock from '../../components/InstallBlock.astro';
import SkillDot from '../../components/SkillDot.astro';
import { withBase } from '../../lib/withBase';
import { plateInk } from '../../lib/plateInk';
import { STATIC_SANDBOX, SCRIPTED_SANDBOX } from '../../lib/frameSandbox';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { lineDiff } from '../../lib/cutDiff';

export async function getStaticPaths() {
  // Hidden entries get no page at all, because otherwise "hidden" only means
  // "unlinked" and the URL is still public.
  const skills = await getCollection('skills', ({ data }) => data.status === 'active');
  return skills.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  slug,
  name,
  tagline,
  story,
  tools,
  previewType,
  previewAssets,
  previewNote,
  prompt,
  notice,
  next,
  subject,
  subjectAfter,
  subjectBrand,
} = entry.data;

// Text previews are read at build time from public/, so the page carries the
// skill's own words with no script.
const TEXT_PREVIEWS = import.meta.glob('/public/previews/**/*.md', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const previewText = previewType === 'reply' || previewType === 'file' ? TEXT_PREVIEWS[`/public${previewAssets[0]}`] : undefined;
const replyHtml = previewType === 'reply' && previewText ? (await (await createMarkdownProcessor()).render(previewText)).code : undefined;
const previewFile = previewAssets[0].split('/').pop();

// The one cut, as a diff of the reviewed page against the page after it.
// The file name is the one the run edited, as the prompt names it.
const fromPublic = (url: string) => readFileSync(path.join(process.cwd(), 'public', url.split('#')[0]), 'utf-8');
const cut = (() => {
  if (!subject || !subjectAfter) return undefined;
  const lines = lineDiff(fromPublic(subject), fromPublic(subjectAfter));
  const removed = lines.filter((d) => d.kind === 'removed').length;
  const added = lines.length - removed;
  const count = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
  return {
    file: 'index.html',
    summary: `${count(removed, 'line')} removed, ${added} added`,
    lines,
    hash: subjectAfter.includes('#') ? subjectAfter.slice(subjectAfter.indexOf('#')) : '',
  };
})();

// A Lath sketch has a fixed width and does not reflow, so its frame scales it
// down to fit. A Graft page reflows, so it needs no scaling.
const SKETCH_WIDTH = 1104;
const SKETCH_HEIGHT = 760;
const scaled = previewType === 'page' && slug === 'lath';

const TOOL_LABELS: Record<string, string> = {
  claude: 'Claude',
  'claude-code': 'Claude Code',
  cursor: 'Cursor',
  codex: 'Codex',
  copilot: 'Copilot',
  figma: 'Figma',
  miro: 'Miro',
};
const named = tools.filter((t) => t !== 'generic').map((t) => TOOL_LABELS[t] ?? t);
const parts = tools.includes('generic') ? [...named, 'any agent that reads a SKILL.md'] : named;
const worksWithLine = `Works with ${parts.length > 1 ? `${parts.slice(0, -1).join(', ')} and ${parts[parts.length - 1]}` : parts[0]}`;
---

<BaseLayout title={name} description={tagline}>
  <header class="mb-12">
    <h1 class="display-lg max-w-3xl"><SkillDot slug={slug} size={14} inline />{name}</h1>
    <p class="mt-5 max-w-2xl text-[18px] leading-[1.45] text-ink-soft text-pretty">{story}</p>
  </header>

  <section class="mb-14" aria-labelledby="say-heading">
    <h2 id="say-heading" class="mb-3 text-[20px] font-medium text-ink">What to say</h2>
    <div class="overflow-hidden rounded-lg border border-rule bg-panel">
      <pre id="prompt-text" class="max-h-[420px] overflow-auto px-5 py-5 font-mono text-[13px] leading-[1.6] whitespace-pre-wrap text-ink" tabindex="0" aria-label={`The prompt that made ${name}'s output`}>{prompt}</pre>
      <div class="flex items-center gap-3 border-t border-rule px-5 py-3">
        <button type="button" class="btn btn-utility" data-copy="prompt-text">Copy</button>
        <span class="text-[13px] text-ink-soft" role="status" aria-live="polite" data-copy-status></span>
      </div>
    </div>
  </section>

  {previewType !== 'image' && (
    <section class="mb-14" aria-labelledby="made-heading">
      <h2 id="made-heading" class="mb-3 text-[20px] font-medium text-ink">What it made</h2>

      {subject && (
        <figure class="mb-6">
          <figcaption class="mb-2 flex items-center gap-2 text-[15px] font-medium text-ink">
            {subjectBrand && (
              <span
                aria-hidden="true"
                class="inline-flex size-[22px] items-center justify-center rounded-[6px] text-[12px] font-medium"
                style={`background:${subjectBrand.colour};color:${plateInk(subjectBrand.colour)}`}
              >{subjectBrand.name.charAt(0)}</span>
            )}
            {subjectBrand ? `What it reviewed: ${subjectBrand.name}’s page` : 'What it reviewed'}
          </figcaption>
          <iframe
            src={withBase(subject)}
            title={`The page ${name} reviewed`}
            loading="lazy"
            sandbox={STATIC_SANDBOX}
            class="block h-[480px] w-full rounded-lg border border-rule bg-panel"
          ></iframe>
        </figure>
      )}

      {previewType === 'page' && !scaled && (
        <iframe
          src={withBase(previewAssets[0])}
          title={`What ${name} made on a real run`}
          loading="lazy"
          sandbox={SCRIPTED_SANDBOX}
          class="block h-[760px] max-h-[85svh] w-full rounded-lg border border-rule bg-panel"
        ></iframe>
      )}
      {previewType === 'page' && scaled && (
        <div class="sketch-frame overflow-x-auto rounded-lg border border-rule bg-panel" data-sketch-frame data-width={SKETCH_WIDTH} data-height={SKETCH_HEIGHT} style={`height:${SKETCH_HEIGHT}px`}>
          <iframe
            src={withBase(previewAssets[0])}
            title={`What ${name} made on a real run`}
            loading="lazy"
            sandbox={STATIC_SANDBOX}
            class="block border-0"
            style={`width:${SKETCH_WIDTH}px;height:${SKETCH_HEIGHT}px;transform-origin:0 0`}
            data-sketch
          ></iframe>
        </div>
      )}
      {previewType === 'reply' && (
        <div class="max-h-[760px] overflow-y-auto rounded-lg border border-rule bg-panel px-6 py-6 sm:px-10 sm:py-8" tabindex="0" aria-label={`${name}'s reply`}>
          <p class="label mb-4">{name} replied</p>
          <div class="prose prose-stone max-w-[68ch] prose-headings:text-ink prose-p:text-ink-soft prose-li:text-ink-soft prose-strong:text-ink prose-code:text-ink" set:html={replyHtml} />
        </div>
      )}
      {subjectAfter && cut && (
        <section class="mt-8" aria-labelledby="cut-heading">
          <h3 id="cut-heading" class="mb-3 text-[15px] font-medium text-ink">The one cut</h3>
          <div class="overflow-hidden rounded-lg border border-rule bg-panel">
            <p class="flex flex-wrap items-baseline gap-x-3 border-b border-rule px-5 py-3 font-mono text-[13px] text-ink">
              <span>{cut.file}</span>
              <span class="text-ink-soft">{cut.summary}</span>
            </p>
            <ul class="px-5 py-4 font-mono text-[13px] leading-[1.7] text-ink" aria-label={`Lines the cut changed in ${cut.file}`}>
              {cut.lines.map((d) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="w-3 shrink-0 text-ink-soft">{d.kind === 'removed' ? '−' : '+'}</span>
                  <span class="sr-only">{d.kind === 'removed' ? 'Removed' : 'Added'}</span>
                  <span class="w-10 shrink-0 text-right text-ink-soft">{d.line}</span>
                  {d.tag && <span class="shrink-0 text-ink-soft">&lt;{d.tag}&gt;</span>}
                  <span class="min-w-0">{d.label}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
            <figure>
              <figcaption class="mb-2 flex items-center gap-2 text-[15px] font-medium text-ink">
                <span aria-hidden="true" class="cut-key"></span>Before, what was cut outlined
              </figcaption>
              <iframe
                src={withBase(`/previews/${slug}/marked.html${cut.hash}`)}
                title={`The page ${name} reviewed, with what the cut removed outlined`}
                loading="lazy"
                sandbox={STATIC_SANDBOX}
                class="block h-[420px] w-full rounded-lg border border-rule bg-panel"
              ></iframe>
            </figure>
            <figure>
              <figcaption class="mb-2 text-[15px] font-medium text-ink">After</figcaption>
              <iframe
                src={withBase(subjectAfter)}
                title={`The page after the one cut ${name} was asked to make`}
                loading="lazy"
                sandbox={STATIC_SANDBOX}
                class="block h-[420px] w-full rounded-lg border border-rule bg-panel"
              ></iframe>
            </figure>
          </div>
        </section>
      )}
      {previewType === 'file' && (
        <div class="overflow-hidden rounded-lg border border-rule bg-panel">
          <p class="border-b border-rule px-5 py-3 font-mono text-[13px] text-ink-soft">{previewFile}</p>
          <pre class="max-h-[760px] overflow-auto px-5 py-5 font-mono text-[13px] leading-[1.6] whitespace-pre-wrap text-ink" tabindex="0" aria-label={`The file ${name} wrote`}>{previewText}</pre>
        </div>
      )}
      {previewNote && <p class="mt-3 max-w-2xl text-xs text-ink-soft text-pretty">{previewNote}</p>}
    </section>
  )}

  <section class="mb-14 max-w-2xl" aria-labelledby="notice-heading">
    <h2 id="notice-heading" class="mb-3 text-[20px] font-medium text-ink">What to notice</h2>
    <ul class="list-disc space-y-2 pl-5 text-[16px] leading-[1.5] text-ink-soft marker:text-ink-soft">
      {notice.map((line) => <li class="text-pretty">{line}</li>)}
    </ul>
  </section>

  <section class="mb-14 max-w-2xl" aria-labelledby="next-heading">
    <h2 id="next-heading" class="mb-3 text-[20px] font-medium text-ink">What to do with it</h2>
    <p class="text-[16px] leading-[1.5] text-ink-soft text-pretty">{next}</p>
  </section>

  <InstallBlock name={name} />

  <article class="prose prose-stone mb-10 max-w-2xl prose-headings:text-ink prose-p:text-ink-soft prose-a:text-ink prose-a:fine-hover:text-ink-soft prose-strong:text-ink">
    <Content />
  </article>

  <p class="text-[14px] text-ink-soft">{worksWithLine}</p>
</BaseLayout>

<script>
  // Copy the prompt. If the browser refuses, select the text so the person can
  // copy it by hand.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const target = document.getElementById(button.dataset.copy ?? '');
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    if (!target) return;
    let timer: number | undefined;
    const say = (text: string) => {
      if (status) status.textContent = text;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => { if (status) status.textContent = ''; }, 2400);
    };
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(target.textContent ?? '');
        say('Copied');
      } catch {
        const range = document.createRange();
        range.selectNodeContents(target);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        say('Select and copy');
      }
    });
  });

  // Scale a fixed-width sketch down to the width available, so all of it shows.
  document.querySelectorAll<HTMLElement>('[data-sketch-frame]').forEach((frame) => {
    const sketch = frame.querySelector<HTMLElement>('[data-sketch]');
    if (!sketch || typeof ResizeObserver === 'undefined') return;
    const width = Number(frame.dataset.width);
    const height = Number(frame.dataset.height);
    const fit = () => {
      const scale = Math.min(1, frame.clientWidth / width);
      sketch.style.transform = scale < 1 ? `scale(${scale})` : '';
      frame.style.height = `${Math.round(height * scale)}px`;
      // Both axes: hiding only x makes y compute to auto, and its
      // scrollbar would take width from the scaled sketch.
      frame.style.overflow = scale < 1 ? 'hidden' : '';
    };
    new ResizeObserver(fit).observe(frame);
    fit();
  });
</script>

<style>
  /* The key for the outline drawn in the marked page: the same orange, the
     colour of a pin. */
  .cut-key {
    display: inline-block;
    width: 14px;
    height: 10px;
    border: 2px solid #ff4f00;
    border-radius: 2px;
  }
</style>
