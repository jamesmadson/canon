---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkillList from '../../components/SkillList.astro';
import InstallBlock from '../../components/InstallBlock.astro';
---

<BaseLayout
  title="Skills"
  description="Canon's own design skills for AI agents: strata, lath, prune and graft, written by James Madson."
>
  <section class="mb-12">
    <h1 class="display-lg max-w-2xl">
      Design briefs your agent can&nbsp;follow.
    </h1>
    <p class="mt-5 max-w-[44ch] text-[18px] leading-[1.45] text-ink-soft text-pretty">
      A skill is a plain text file your agent reads before a piece of work. These are written for
      Canon, and install with one command in Claude&nbsp;Code.
    </p>
    <SkillList />
  </section>

  <InstallBlock />
</BaseLayout>
