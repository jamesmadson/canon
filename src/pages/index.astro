---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingStrip from '../components/ClosingStrip.astro';
import HeroBoard from '../components/HeroBoard.astro';
import McpWalkthrough from '../components/McpWalkthrough.astro';
import { withBase } from '../lib/withBase';

// One idea per row, each shown with the real screen. The screenshots come
// from the sample project via scripts/capture-app-shots.mjs; every name and
// quote in them is invented. Text always sits left, the screen right.
const FEATURES = [
  {
    title: 'Every version, one&nbsp;stack.',
    body: 'Drag in HTML files, zipped builds and whole folders, or paste a link. Versions of the same prototype stack together, newest on top, one marked current. Press ⌘K and open any of them. No more forty&nbsp;tabs.',
    shot: 'library',
    width: 2352,
    height: 1470,
    alt: 'The prototype library: six prototypes from a sample project, one of them a stack of three versions.',
  },
  {
    title: 'See the whole site at&nbsp;once.',
    body: 'A prototype with many pages opens as its map. Every page, the links between them, and the pages nothing points to&nbsp;anymore.',
    shot: 'map',
    width: 2272,
    height: 1420,
    alt: 'A six-page prototype laid out as its map, with the pricing page selected and the pages it links to and from listed beside it.',
  },
  {
    title: 'Leave yourself a&nbsp;note.',
    body: 'Pin a note on a screen, a page or the space between. What changed, what to try next, which one is current. They stay on your machine with everything&nbsp;else.',
    shot: 'comments',
    width: 1520,
    height: 950,
    alt: 'A note pinned to a phone prototype on a board, open, with a question and its answer.',
  },
];

const ADDRESS = 'james@jamesmadson.me';
---

<BaseLayout
  wide
  title="Canon"
  description="Every prototype in one place. Drop them in, see how the pages connect, and talk about them where the work is."
>
  {/* 1. The claim, and a board of prototypes beside it. */}
  <section class="mx-auto max-w-6xl px-6 pt-8 pb-20 sm:pt-14 sm:pb-28">
    <div class="grid grid-cols-1 gap-10 sm:gap-12 lg:grid-cols-12 lg:items-center">
      <div class="min-w-0 lg:col-span-6">
        <h1 class="display-xl max-w-[14ch]">Every prototype, from every tool, in one&nbsp;place.</h1>
        <p class="mt-6 max-w-[40ch] text-[18px] leading-[1.45] text-ink-soft">
          Claude Code, v0, Lovable, Figma Make, a branch, a zip. Canon puts them on one board you can
          see, open and keep in&nbsp;order.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-3">
          <a href={withBase('/app/')} class="btn btn-primary">Try it now</a>
          <a href="#agents" class="tick-bar rounded-sm text-sm">Connect an agent</a>
        </div>
        <p class="mt-5 font-mono text-[11px] leading-[1.6] tracking-[0.08em] text-ink-soft">
          Runs in your browser. Saves to a folder on your machine. Nothing is&nbsp;uploaded.
        </p>
      </div>
      <div class="min-w-0 lg:col-span-6">
        <HeroBoard />
      </div>
    </div>
  </section>

  {/* 2. Three ideas, one screen each, ruled off like a contents page. */}
  <section class="mx-auto max-w-6xl px-6 pb-20 sm:pb-28" aria-label="What Canon does">
    {
      FEATURES.map((f, i) => (
        <article
          class:list={['feature grid grid-cols-1 items-start gap-6 pt-10 sm:pt-12 lg:grid-cols-12 lg:gap-12', i > 0 && 'mt-16 sm:mt-24']}
          aria-labelledby={`feature-${f.shot}`}
        >
          <div class="min-w-0 lg:col-span-4">
            <p class="rail-num text-[3rem] text-ink-soft" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </p>
            <h2 id={`feature-${f.shot}`} class="display mt-6" set:html={f.title} />
            <p class="mt-4 max-w-[38ch] text-[16px] leading-[1.5] text-ink-soft" set:html={f.body} />
          </div>
          <div class="min-w-0 lg:col-span-8">
            <img
              src={withBase(`/shots/${f.shot}.jpg`)}
              alt={f.alt}
              width={f.width}
              height={f.height}
              loading="lazy"
              decoding="async"
              class="shot block h-auto w-full"
            />
          </div>
        </article>
      ))
    }
  </section>

  {/* 3. The MCP, from the agent to the board. */}
  <McpWalkthrough />

  {/* 4. The close, and how to reach me. */}
  <section id="signup" class="mx-auto max-w-6xl scroll-mt-8 px-6 pb-24 sm:pb-32" aria-labelledby="close-heading">
    <div class="max-w-xl">
      <h2 id="close-heading" class="display-lg">Try it, then tell me how it&nbsp;goes.</h2>
      <p class="mt-4 text-[16px] leading-[1.5] text-ink-soft">
        Canon is early. I want to hear what works and what gets in the&nbsp;way.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a href={withBase('/app/')} class="btn btn-primary">Try it now</a>
        <a href={`mailto:${ADDRESS}?subject=Canon`} class="mail select-all font-mono text-[13px] text-ink-soft">
          {ADDRESS}
        </a>
      </div>
    </div>
  </section>

  <ClosingStrip slot="after-footer" />
</BaseLayout>

<style>
  .feature {
    border-top: 1px solid var(--color-rule);
  }
  .shot {
    border-radius: var(--radius-lg);
    /* The hairline. An inset shadow would paint under the image, so it is an
       outline pulled just inside the edge. */
    outline: 1px solid var(--color-rule);
    outline-offset: -1px;
    background-color: var(--color-ground);
  }
  .mail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    border-radius: var(--radius-sm);
    transition: color 220ms cubic-bezier(0.2, 0, 0, 1);
  }
  .mail:hover {
    color: var(--color-ink);
  }
  .mail:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .mail {
      transition: none;
    }
  }
</style>
