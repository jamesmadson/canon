---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingStrip from '../components/ClosingStrip.astro';
import MeshPanel from '../components/MeshPanel.astro';
import Contact from '../components/Contact.astro';
import { withBase } from '../lib/withBase';

// One idea per row, each shown with the real screen. The screenshots come
// from the sample project via scripts/capture-app-shots.mjs; every name and
// quote in them is invented.
const FEATURES = [
  {
    label: 'Library',
    title: 'Every version, one stack.',
    body: 'Drag in HTML files, zipped builds and whole folders, or paste a link. Versions of the same prototype stack together, newest on top, one marked current. Press ⌘K and open any of them. No more forty tabs.',
    shot: 'library',
    alt: 'The prototype library: six prototypes from a sample project, one of them a stack of three versions.',
  },
  {
    label: 'Map',
    title: 'See the whole site at once.',
    body: 'A prototype with many pages opens as its map. Every page, the links between them, and the pages nothing points to anymore.',
    shot: 'map',
    alt: 'A six-page prototype laid out as its information architecture, with the pricing page selected and its links highlighted.',
  },
  {
    label: 'Notes',
    title: 'Leave yourself a note.',
    body: 'Pin a note on a screen, a page or the space between. What changed, what to try next, which one is current. They stay on your machine with everything else.',
    shot: 'comments',
    alt: 'A note pinned to a prototype on the canvas.',
  },
];
---

<BaseLayout
  wide
  title="Canon"
  description="Every prototype in one place. Drop them in, see how the pages connect, and talk about them where the work is."
>
  {/* 1. The cover. The name set the way a book sets it, the claim beside it. */}
  <section class="mx-auto max-w-6xl px-6 pt-6 pb-16 sm:pt-10 sm:pb-20">
    <div class="flex flex-col gap-10 sm:flex-row-reverse sm:items-stretch sm:justify-between sm:gap-16">
      <div class="cover-type" aria-hidden="true">
        <span>canon</span><span>design</span>
      </div>
      <div class="flex min-w-0 flex-col justify-end sm:py-2">
        <p class="label">For people who prototype</p>
        <h1 class="display-lg mt-3 max-w-[18ch]">Every prototype, from every tool, in one place.</h1>
        <p class="mt-5 max-w-[46ch] text-[18px] leading-relaxed text-ink-soft">
          Claude Code, v0, Lovable, Figma Make, a branch, a zip. Your prototypes
          live everywhere. Canon puts them on one shelf you can see, open and keep in order.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href={withBase('/app/')} class="btn btn-primary">Try it now</a>
          <a href="#signup" class="btn btn-secondary">Get in touch</a>
        </div>
        <p class="mt-4 font-mono text-[11px] tracking-[0.08em] text-ink-soft">
          Runs in your browser or as an app. Saves to a folder on your machine. Nothing is uploaded.
        </p>
      </div>
    </div>
  </section>

  {/* 2. The product, big, on warm paper. */}
  <section class="mx-auto max-w-6xl px-6 pb-24 sm:pb-32" aria-label="Canon, a board of prototypes">
    <MeshPanel class="p-3 sm:p-6">
      <img
        src={withBase('/shots/board.jpg')}
        alt="A board of prototypes: four phone and desktop screens, and a six-page site with its other pages fanning out from behind it."
        width="2880"
        height="1800"
        fetchpriority="high"
        class="shot block w-full"
      />
    </MeshPanel>
  </section>

  {/* 3. Four ideas, one screen each. */}
  {
    FEATURES.map((f, i) => (
      <section class="mx-auto max-w-6xl px-6 pb-24 sm:pb-32" aria-labelledby={`feature-${f.shot}`}>
        <div class={`grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12`}>
          <div class={`lg:col-span-4 ${i % 2 ? 'lg:order-2' : ''}`}>
            <p class="label">{f.label}</p>
            <h2 id={`feature-${f.shot}`} class="display mt-3">{f.title}</h2>
            <p class="mt-4 text-[16px] leading-relaxed text-ink-soft">{f.body}</p>
          </div>
          <div class={`lg:col-span-8 ${i % 2 ? 'lg:order-1' : ''}`}>
            <MeshPanel class="p-2 sm:p-4">
              <img
                src={withBase(`/shots/${f.shot}.jpg`)}
                alt={f.alt}
                width="2880"
                height="1800"
                loading="lazy"
                decoding="async"
                class="shot block w-full"
              />
            </MeshPanel>
          </div>
        </div>
      </section>
    ))
  }

  {/* 4. The promise, plainly. */}
  <section class="mx-auto max-w-6xl px-6 pb-24 sm:pb-32">
    <div class="max-w-3xl">
      <h2 class="display-lg">Your prototypes deserve better than a chat thread.</h2>
      <p class="mt-5 max-w-[52ch] text-[18px] leading-relaxed text-ink-soft">
        Canon points at your prototypes wherever they live, and keeps them in
        one place. Your files stay on your machine.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={withBase('/app/')} class="btn btn-primary">Try it now</a>
      </div>
    </div>
  </section>

  {/* 5. Contact. */}
  <div id="signup" class="mx-auto max-w-6xl scroll-mt-8 px-6 pb-24 sm:pb-32">
    <Contact />
  </div>

  <ClosingStrip slot="after-footer" />
</BaseLayout>

<style>
  .shot {
    border-radius: 10px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.08),
      0 24px 60px -20px rgb(0 0 0 / 0.35);
  }
</style>
