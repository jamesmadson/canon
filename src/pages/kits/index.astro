---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KitCard from '../../components/KitCard.astro';
import { withBase } from '../../lib/withBase';

const ROUTED_SLUGS = ['marketing-site', 'product-ui', 'mobile-first-review'];

const kits = (await getCollection('kits', ({ data }) => data.status === 'active')).sort(
  (a, b) => a.data.name.localeCompare(b.data.name)
);
const routedKits = kits.filter((kit) => ROUTED_SLUGS.includes(kit.data.slug));
const bundleKits = kits.filter((kit) => !ROUTED_SLUGS.includes(kit.data.slug));
---

<BaseLayout title="Kits" description="Curated, phased bundles of design skills for a concrete job — with a one-command install.">
  <h1 class="mb-2 text-2xl font-bold">Kits</h1>
  <p class="mb-6 max-w-xl text-[15px] leading-relaxed font-medium text-ink-soft">
    A kit is several skills grouped around one job, in the order you'd actually
    use them. Each installs with a single command — or downloads as one file you
    can upload to design tools like Figma.
  </p>
  <section class="mb-10 rounded-lg border border-rule-strong p-5 sm:p-6">
    <h2 class="text-lg font-semibold text-ink">Start here</h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed font-medium text-ink-soft">
      Rather than choosing a kit yourself, install <strong class="font-semibold text-ink">Canon</strong>
      once and describe the work — a landing page, a dashboard, a mobile review.
      It picks the right kit for you. It stays out of the way until you ask.
    </p>
    <p class="mt-4 text-sm font-medium text-ink-soft">
      Claude Code plugin —
      <code class="rounded-sm bg-surface px-1.5 py-0.5 font-mono text-[13px] text-ink">/plugin marketplace add jamesmadson/canon</code>
    </p>
    <div class="mt-4 flex flex-wrap gap-px overflow-hidden rounded-md bg-rule">
      <a
        href={withBase('/kits/canon-all.md')}
        download
        class="min-h-11 flex-1 bg-bg px-4 py-3 text-sm font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-ink focus-visible:-outline-offset-2"
      >
        canon-all.md — one file for Figma
      </a>
      <a
        href="https://github.com/jamesmadson/canon/tree/main/plugin/canon"
        target="_blank"
        rel="noopener"
        class="min-h-11 flex-1 bg-bg px-4 py-3 text-sm font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-ink focus-visible:-outline-offset-2"
      >
        Plugin source on GitHub
      </a>
    </div>
  </section>
  <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-ink-soft">The router's three routes</h2>
  <div class="-mr-px -mb-px grid grid-cols-1 overflow-hidden rounded-lg border border-rule sm:grid-cols-3">
    {routedKits.map((kit) => <KitCard kit={kit} />)}
  </div>

  <h2 class="mb-4 mt-10 text-sm font-semibold uppercase tracking-wide text-ink-soft">The everything bundle</h2>
  <div class="-mr-px -mb-px grid grid-cols-1 overflow-hidden rounded-lg border border-rule">
    {bundleKits.map((kit) => <KitCard kit={kit} />)}
  </div>
  <p class="mt-4 max-w-2xl text-sm font-medium text-ink-soft">
    Full Redesign is installed directly rather than routed to.
  </p>
</BaseLayout>
