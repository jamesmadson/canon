---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Submit a skill" description="Suggest a skill for the gallery.">
  <h1 class="display-lg mb-3">Submit a skill</h1>
  <p class="mb-10 max-w-xl text-[15px] leading-relaxed text-ink-soft">
    Suggest a skill for the gallery. Nothing publishes on its own: every
    submission is read in full and license-checked before it is added.
  </p>

  <div class="max-w-xl rounded-md bg-panel p-4 text-sm text-ink-soft">
    Submissions are not open yet. Reach out through the source links on any skill
    page in the meantime.
  </div>
</BaseLayout>
