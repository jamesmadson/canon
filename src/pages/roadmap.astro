---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROADMAP, ROADMAP_LEDE, ISSUES_URL } from '../lib/roadmap';
import { withBase } from '../lib/withBase';
import { tie } from '../lib/words';

// Not linked from anywhere and kept out of search results. Share the address directly.
const hosted = withBase('/#hosted');
---

<BaseLayout wide noindex nofollow title="Roadmap" description={ROADMAP_LEDE}>
  <div class="home">
    <div class="wrap">
      <section class="band roadmap" aria-labelledby="h-roadmap">
        <div class="bhead">
          <h1 id="h-roadmap">Roadmap</h1>
          <p class="lede">{tie(ROADMAP_LEDE)}</p>
        </div>
        {
          ROADMAP.map((col) => (
            <section class="rm-col" aria-labelledby={`rm-${col.name.toLowerCase()}`}>
              <h2 class="rm-name" id={`rm-${col.name.toLowerCase()}`}>{col.name}</h2>
              <ul>
                {col.items.map((item) => (
                  <li>
                    {tie(item.text)}
                    {item.link && <a class="rm-link" href={hosted}>{item.link.label}</a>}
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
        <p class="rm-close">
          {tie('Want something that isn’t here?')} <a href={ISSUES_URL}>{tie('Open an issue on GitHub.')}</a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .band.roadmap > .bhead {
    grid-column: 1 / -1;
    margin-bottom: 56px;
  }
  .roadmap .rm-col {
    grid-column: 1 / -1;
    border-top: 1px solid var(--color-rule);
    padding-top: 16px;
    margin-bottom: 40px;
  }
  .roadmap .rm-name {
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-ink-soft);
    margin: 0 0 20px;
  }
  .roadmap .rm-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .roadmap .rm-col li {
    font-size: 16px;
    line-height: 24px;
    text-wrap: pretty;
  }
  .roadmap .rm-link {
    display: block;
    margin-top: 6px;
    font-size: 14px;
    color: var(--color-ink-soft);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .roadmap .rm-link:hover {
      color: var(--color-ink);
    }
  }
  .roadmap .rm-close {
    grid-column: 1 / -1;
    margin-top: 24px;
    font-size: 16px;
    line-height: 24px;
  }
  .roadmap .rm-close a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 900px) {
    .roadmap .rm-col {
      grid-column: span 4;
      margin-bottom: 0;
    }
    .roadmap .rm-close {
      margin-top: 72px;
    }
  }
</style>
