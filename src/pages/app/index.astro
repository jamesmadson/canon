---
// The Canon app, Paper and Lunagraph in shape: boards of prototypes on a
// canvas, personal notes, all kept in this browser. An
// experiment on the canvas-explore branch, so it stays out of search.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#151413" />
    <script is:inline>
      // The saved Appearance, applied before anything paints so the wrong theme never flashes.
      try {
        var a = localStorage.getItem('canon-appearance');
        if (a === 'light' || a === 'dark') document.documentElement.setAttribute('data-theme', a);
        var dark = a === 'dark' || (a !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#151413' : '#F7F5F2');
      } catch (e) {}
    </script>
    <link rel="manifest" href="/canon/app.webmanifest" />
    <link rel="icon" href="/canon/icons/canon.svg" type="image/svg+xml" />
    <link rel="icon" href="/canon/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/canon/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Canon" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>Canon</title>
  </head>
  <body>
    <div id="app"></div>
    <script>
      import '../../app/main';
    </script>
  </body>
</html>
