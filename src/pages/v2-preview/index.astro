---
import AppShell from '../../components/AppShell.astro';
import PrototypeCard from '../../components/PrototypeCard.astro';
import { withBase } from '../../lib/withBase';
import { isStale, STALE_AFTER_DAYS } from '../../lib/staleness';
import { spellNumber } from '../../lib/spellNumber';
import { STRENGTH_SCALE } from '../../lib/evidence';
import {
  BRANCHES,
  CANON_NAMED_REFS,
  RECORD_ENTRIES,
  FIGMA_PROTOTYPES,
  GIT_PROTOTYPES,
  MEMBERS,
  OPENED_SINCE,
  PREVIEW_AS_OF,
  PROJECT,
  PROTOTYPES,
  REVIEW_RUNS,
  SELECTED_BRANCHES,
} from '../../data/v2Preview';

const staleCount = PROTOTYPES.filter((p) => isStale(p.lastActivity, PREVIEW_AS_OF)).length;
const sentenceCase = (word: string) => word.charAt(0).toUpperCase() + word.slice(1);

// Every number here is counted off the data, so the strip cannot outlive it.
// The "From" note has to close the arithmetic: branches picked when the repo
// was connected, plus the ones Canon opened since, plus the Figma set, is the
// prototype count above it.
const STATS = [
  {
    label: 'Prototypes',
    value: String(PROTOTYPES.length),
    note: `${sentenceCase(spellNumber(GIT_PROTOTYPES))} from Git, ${spellNumber(FIGMA_PROTOTYPES)} from\u00A0Figma`,
  },
  {
    label: 'From',
    value: `${BRANCHES.length} branches`,
    note: `${SELECTED_BRANCHES} picked at connect, ${OPENED_SINCE} opened since`,
  },
  { label: 'Stale', value: String(staleCount), note: `Quiet ${STALE_AFTER_DAYS} days or more` },
  { label: 'Review runs', value: String(REVIEW_RUNS), note: 'Every one triggered by a\u00A0person' },
];

const recordVoices = new Set(RECORD_ENTRIES.map((entry) => entry.speaker)).size;

const RECORD_LINKS = [
  {
    label: 'The record',
    href: '/v2-preview/research/',
    line: 'Every entry, newest first, with the count of voices behind each question.',
  },
  {
    label: 'The open report',
    href: '/v2-preview/research/report/',
    line: 'The same entries grouped into patterns, possible patterns, and open loops.',
  },
];
---

<AppShell
  title="Canon v2 preview — dashboard"
  description="A scripted preview of the Canon v2 project dashboard: prototype screens indexed from Git and Figma, with staleness flags."
  active="overview"
>
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold tracking-tight">{PROJECT.name}</h1>
      <p class="mt-1 text-base font-medium text-ink-soft">{PROJECT.tagline}</p>
    </div>
    <a href={withBase('/v2-preview/new/')} class="btn btn-primary">New prototype</a>
  </div>

  <p class="mt-3 max-w-2xl text-base leading-relaxed font-medium text-ink-soft">
    {PROJECT.blurb}
  </p>

  <div class="mt-6 overflow-hidden rounded-md border border-rule">
    <dl class="-mr-px -mb-px grid grid-cols-2 lg:grid-cols-4">
      {STATS.map((stat) => (
        <div class="flex flex-col gap-1 border-r border-b border-rule bg-bg px-4 py-3">
          <dt class="label">
            {stat.label}
          </dt>
          <dd class="text-2xl leading-none font-semibold tracking-tight text-ink tabular-nums">
            {stat.value}
          </dd>
          <dd class="text-[11px] font-medium text-ink-soft tabular-nums">{stat.note}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="mt-6 flex flex-col gap-2 border-t border-rule pt-4 sm:flex-row sm:items-start sm:gap-8">
    <dl class="flex flex-col gap-2 text-[13px] font-medium sm:flex-row sm:gap-8">
      <div>
        <dt class="label">Repository</dt>
        <dd class="mt-1 font-mono break-all text-ink">{PROJECT.repo}</dd>
      </div>
      <div>
        <dt class="label">Figma file</dt>
        <dd class="mt-1 text-ink">{PROJECT.figmaFile}</dd>
      </div>
      <div>
        <dt class="label">Access</dt>
        <dd class="mt-1 text-ink">Read-only</dd>
      </div>
      <div>
        <dt class="label">People</dt>
        <dd class="mt-1 text-ink tabular-nums">
          <a
            href={withBase('/v2-preview/members/')}
            class="font-semibold underline decoration-rule-strong underline-offset-4 transition-colors duration-[120ms] hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          >
            {MEMBERS.length} members
          </a>
        </dd>
      </div>
    </dl>
    <a
      href={withBase('/v2-preview/import/')}
      class="flex min-h-11 items-center text-[13px] font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors duration-[120ms] hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink sm:ml-auto"
    >
      Connect a source
    </a>
  </div>

  <section class="mt-8 scroll-mt-6" id="prototypes" aria-labelledby="prototypes-heading">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="prototypes-heading" class="label">
        Prototypes
      </h2>
      <p class="text-[11px] font-medium text-ink-soft tabular-nums">
        {PROTOTYPES.length} indexed · {staleCount} stale
      </p>
    </div>

    <div class="overflow-hidden rounded-md border border-rule">
      <div class="-mr-px -mb-px grid grid-cols-1 sm:grid-cols-2">
        {PROTOTYPES.map((prototype) => <PrototypeCard prototype={prototype} />)}
      </div>
    </div>

    <p class="mt-4 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
      Canon did not ask anyone to rename a branch. {sentenceCase(spellNumber(SELECTED_BRANCHES))} of
      the {spellNumber(BRANCHES.length)} branches on <span class="font-mono">{PROJECT.repo}</span> were
      picked as prototypes and the rest stayed branches. The{' '}
      {spellNumber(CANON_NAMED_REFS.length)} that carry the{' '}
      <span class="font-mono">prototype-</span> prefix —{' '}
      {CANON_NAMED_REFS.map((ref, i) => (
        <>
          {i > 0 && ' and '}
          <span class="font-mono">{ref}</span>
        </>
      ))}{' '}
      — are the ones Canon opened itself, which is the only case where Canon does the naming.
    </p>
    <p class="mt-2 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
      Anything with no activity for {STALE_AFTER_DAYS} days gets flagged. The flag is not a
      scolding — retiring a prototype is a normal end state, and a project that never retires
      anything is the one with a problem.
    </p>
  </section>

  <section class="mt-8" aria-labelledby="record-heading">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="record-heading" class="label">
        The record
      </h2>
      <p class="text-[11px] font-medium text-ink-soft tabular-nums">
        {RECORD_ENTRIES.length} entries · {recordVoices} voices
      </p>
    </div>

    <div class="overflow-hidden rounded-md border border-rule">
      <div class="-mr-px -mb-px grid grid-cols-1 sm:grid-cols-2">
        {RECORD_LINKS.map((link) => (
          <a
            href={withBase(link.href)}
            class="group flex flex-col gap-1 border-r border-b border-rule bg-bg px-4 py-4 transition-colors duration-[120ms] hover:border-rule-strong hover:bg-surface/30 active:bg-surface/50 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ink"
          >
            <span class="text-base font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors group-hover:decoration-ink">
              {link.label}
            </span>
            <span class="text-[13px] leading-relaxed font-medium text-ink-soft">{link.line}</span>
          </a>
        ))}
      </div>
    </div>

    <p class="mt-2 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
      Feedback lands as entries, not as opinions: said, meant, decided. The report counts the
      people behind each question rather than the entries — {STRENGTH_SCALE}.
    </p>
  </section>

  <a
    slot="footer-nav"
    href={withBase('/v2-preview/today-ring-v2/')}
    class="flex min-h-11 items-center font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    Next screen — a prototype in detail
  </a>

  <a
    slot="footer-nav"
    href={withBase('/v2-preview/flows/')}
    class="flex min-h-11 items-center text-ink-soft underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    Flow map
  </a>
</AppShell>
