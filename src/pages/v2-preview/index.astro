---
import AppShell from '../../components/AppShell.astro';
import PrototypeCard from '../../components/PrototypeCard.astro';
import { withBase } from '../../lib/withBase';
import { isStale, STALE_AFTER_DAYS } from '../../lib/staleness';
import {
  BRANCHES,
  PREVIEW_AS_OF,
  PROJECT,
  PROTOTYPES,
  REVIEW_RUNS,
  SELECTED_BRANCHES,
} from '../../data/v2Preview';

const staleCount = PROTOTYPES.filter((p) => isStale(p.lastActivity, PREVIEW_AS_OF)).length;

// Every number here is counted off the data, so the strip cannot outlive it.
const STATS = [
  { label: 'Prototypes', value: String(PROTOTYPES.length), note: 'Three from Git, one from Figma' },
  {
    label: 'From',
    value: `${BRANCHES.length} branches`,
    note: `${SELECTED_BRANCHES} selected`,
  },
  { label: 'Stale', value: String(staleCount), note: `Quiet ${STALE_AFTER_DAYS} days or more` },
  { label: 'Review runs', value: String(REVIEW_RUNS), note: 'Both triggered by a person' },
];
---

<AppShell
  title="Canon v2 preview — dashboard"
  description="A scripted preview of the Canon v2 project dashboard: prototype screens indexed from Git and Figma, with staleness flags."
  active="overview"
>
  <h1 class="text-3xl font-bold tracking-tight">{PROJECT.name}</h1>
  <p class="mt-1 text-[15px] font-medium text-ink-soft">{PROJECT.tagline}</p>
  <p class="mt-3 max-w-2xl text-[15px] leading-relaxed font-medium text-ink-soft">
    {PROJECT.blurb}
  </p>

  <div class="mt-6 overflow-hidden rounded-md border border-rule">
    <dl class="-mr-px -mb-px grid grid-cols-2 lg:grid-cols-4">
      {STATS.map((stat) => (
        <div class="border-r border-b border-rule bg-bg px-4 py-3">
          <dt class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">
            {stat.label}
          </dt>
          <dd class="mt-0.5 text-lg font-semibold text-ink">{stat.value}</dd>
          <dd class="text-[11px] font-medium text-ink-soft">{stat.note}</dd>
        </div>
      ))}
    </dl>
  </div>

  <dl class="mt-5 flex flex-col gap-2 border-t border-rule pt-4 text-[13px] font-medium sm:flex-row sm:gap-8">
    <div>
      <dt class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">Repository</dt>
      <dd class="mt-0.5 font-mono break-all text-ink">{PROJECT.repo}</dd>
    </div>
    <div>
      <dt class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">Figma file</dt>
      <dd class="mt-0.5 text-ink">{PROJECT.figmaFile}</dd>
    </div>
    <div>
      <dt class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">Access</dt>
      <dd class="mt-0.5 text-ink">Read-only</dd>
    </div>
  </dl>

  <section class="mt-8 scroll-mt-6" id="prototypes" aria-labelledby="prototypes-heading">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="prototypes-heading" class="text-sm font-semibold uppercase tracking-wide text-ink-soft">
        Prototypes
      </h2>
      <p class="text-[11px] font-medium text-ink-soft">
        {PROTOTYPES.length} indexed · {staleCount} idle
      </p>
    </div>

    <div class="overflow-hidden rounded-md border border-rule">
      <div class="-mr-px -mb-px grid grid-cols-1 sm:grid-cols-2">
        {PROTOTYPES.map((prototype) => <PrototypeCard prototype={prototype} />)}
      </div>
    </div>

    <p class="mt-4 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
      Canon did not ask anyone to rename a branch. Three of the six branches on
      <span class="font-mono">{PROJECT.repo}</span> were picked as prototypes and the rest stayed
      branches — only <span class="font-mono">prototype-map-layers</span> carries the prefix,
      because Canon opened that one itself.
    </p>
    <p class="mt-2 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
      Anything with no activity for {STALE_AFTER_DAYS} days gets flagged. The flag is not a
      scolding — retiring a prototype is a normal end state, and a project that never retires
      anything is the one with a problem.
    </p>
  </section>

  <a
    slot="footer-nav"
    href={withBase('/v2-preview/today-ring-v2/')}
    class="flex min-h-11 items-center font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    Next screen — a prototype in detail
  </a>
</AppShell>
