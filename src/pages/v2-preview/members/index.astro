---
import AppShell from '../../../components/AppShell.astro';
import { withBase } from '../../../lib/withBase';
import { spellNumber } from '../../../lib/spellNumber';
import { ENGINEERING_BUDDY, MEMBERS, PROJECT, PROTOTYPES } from '../../../data/v2Preview';

/**
 * Who is on the project, and which of them a prototype gets handed to.
 *
 * The invite affordance is a link rather than an email field on purpose: an
 * invite you can paste into whatever thread the team already uses beats an
 * address book Canon would then have to keep.
 */
const inviteLink = `canon.example/join/${PROJECT.team.toLowerCase().replace(/\s+/g, '-')}-9fk2`;
const designers = MEMBERS.filter((m) => m.role === 'Design').length;
---

<AppShell
  title="Canon v2 preview — members"
  description="A scripted preview of the Canon v2 members page: who is on the project, who the engineering buddy is, and how an invite link works."
  active="members"
>
  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold tracking-tight">Members</h1>
      <p class="mt-1 text-base font-medium text-ink-soft tabular-nums">
        {MEMBERS.length} people on {PROJECT.name}
      </p>
    </div>
    <a href={withBase('/v2-preview/members/#invite')} class="btn btn-primary">Invite with a link</a>
  </div>

  <p class="mt-3 max-w-2xl text-base leading-relaxed font-medium text-ink-soft">
    {spellNumber(designers).charAt(0).toUpperCase() + spellNumber(designers).slice(1)} designers,
    one engineer, one PM. Everybody signs in with their own account, and the project is a list of
    those accounts — teams, billing and roles that mean something come&nbsp;later.
  </p>

  <section class="mt-6" aria-labelledby="people-heading">
    <h2 id="people-heading" class="mb-3 label">
      People
    </h2>

    <div class="overflow-hidden rounded-md border border-rule">
      <ul class="-mb-px">
        {MEMBERS.map((member) => (
          <li class="flex flex-wrap items-start gap-x-3 gap-y-2 border-b border-rule bg-bg px-4 py-4">
            <span
              aria-hidden="true"
              class="flex size-8 shrink-0 items-center justify-center rounded-full bg-recess text-[11px] font-semibold text-ink"
            >
              {member.initials}
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="text-base font-semibold text-ink">{member.name}</span>
                {member.you && (
                  <span class="rounded-full bg-recess px-2 py-1 text-[11px] font-semibold text-ink-soft">
                    You
                  </span>
                )}
                <span class="font-mono text-[11px] break-all text-ink-soft">{member.handle}</span>
              </span>
              <span class="mt-1 block text-[13px] leading-relaxed font-medium text-ink-soft">
                {member.line}
              </span>
              {member.buddy && (
                <span class="mt-2 flex flex-wrap items-center gap-2">
                  <span class="rounded-full bg-recess px-2 py-1 text-[11px] font-semibold text-ink">
                    Engineering buddy
                  </span>
                  <span class="text-[11px] font-medium text-ink-soft tabular-nums">
                    Named on all {PROTOTYPES.length} prototypes
                  </span>
                </span>
              )}
            </span>
            <span class="ml-auto rounded-full bg-recess px-2 py-1 text-[11px] font-semibold whitespace-nowrap text-ink-soft">
              {member.role}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-2 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
      One person is the engineering buddy —{' '}
      <span class="font-semibold text-ink">{ENGINEERING_BUDDY.name}</span> here. Every prototype's
      Hand off section names them, so graduating a prototype is addressed to somebody rather than
      posted at a&nbsp;team.
    </p>
  </section>

  <section class="mt-8 scroll-mt-6" id="invite" aria-labelledby="invite-heading">
    <h2 id="invite-heading" class="mb-3 label">
      Invite with a link
    </h2>

    <div class="overflow-hidden rounded-md border border-rule">
      <p class="border-b border-rule bg-surface/50 px-4 py-2 label">
        Anyone with this link can join {PROJECT.name}
      </p>
      <p class="bg-bg px-4 py-3 font-mono text-[13px] break-all text-ink">{inviteLink}</p>
      <div class="flex flex-wrap items-center gap-3 border-t border-rule px-4 py-3">
        <button type="button" class="btn btn-quiet" data-invite-copy data-label="Copy link">
          Copy link
        </button>
        <button type="button" class="btn btn-quiet" data-invite-new>New link</button>
        <p class="sr-only" role="status" data-invite-status></p>
      </div>
    </div>

    <p class="mt-2 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
      Scripted in this preview — the link goes nowhere and nothing reaches your clipboard. In the
      product a new link retires the old one.
    </p>

    <div class="mt-6 rounded-md border border-rule px-4 py-3">
      <p class="text-sm leading-relaxed font-medium text-ink">
        Personal accounts and invite links now. Teams later.
      </p>
      <p class="mt-2 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
        No seats to buy before anyone has used it, no admin console for a group of five. When
        there is a reason for org accounts, roles and billing, they arrive then — and the invite
        links keep working.
      </p>
    </div>
  </section>

  <a
    slot="footer-nav"
    href={withBase('/v2-preview/')}
    class="flex min-h-11 items-center font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    Back to the dashboard
  </a>

  <a
    slot="footer-nav"
    href={withBase('/v2-preview/flows/')}
    class="flex min-h-11 items-center text-ink-soft underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    Flow map
  </a>
</AppShell>

<script>
  const status = document.querySelector<HTMLElement>('[data-invite-status]');

  function say(message: string) {
    if (status) status.textContent = message;
  }

  const copy = document.querySelector<HTMLButtonElement>('[data-invite-copy]');
  copy?.addEventListener('click', () => {
    copy.textContent = 'Copied';
    say('Copied. Scripted preview — the clipboard is untouched.');
    setTimeout(() => {
      copy.textContent = copy.dataset.label ?? 'Copy link';
      say('');
    }, 2400);
  });

  const fresh = document.querySelector<HTMLButtonElement>('[data-invite-new]');
  fresh?.addEventListener('click', () => {
    fresh.textContent = 'Same link in the preview';
    say('The preview keeps no state, so the link above is unchanged.');
    setTimeout(() => {
      fresh.textContent = 'New link';
      say('');
    }, 2400);
  });
</script>
