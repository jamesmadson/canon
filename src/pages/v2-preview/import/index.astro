---
import AppShell from '../../../components/AppShell.astro';
import { withBase } from '../../../lib/withBase';
import { PROJECT } from '../../../data/v2Preview';
---

<AppShell
  title="Canon v2 preview — connect a source"
  description="A scripted preview of adding a second repository to a Canon v2 project, read-only."
  active="overview"
>
  <a
    href={withBase('/v2-preview/')}
    class="-ml-1 inline-flex min-h-11 items-center px-1 text-[13px] font-medium text-ink-soft underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    ← Overview
  </a>

  <h1 class="mt-2 text-xl font-bold tracking-tight">Connect a source</h1>
  <p class="mt-2 max-w-2xl text-[15px] leading-relaxed font-medium text-ink-soft">
    {PROJECT.name} already reads <span class="font-mono text-[13px]">{PROJECT.repo}</span> and one
    Figma file. A project can hold more than one of each — a second repository joins the same
    grid, marked with where it came from.
  </p>

  <div class="mt-6 max-w-xl">
    <div class="rounded-md border border-rule bg-surface/50 px-4 py-3">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">Connected as</p>
      <p class="mt-1 font-mono text-[13px] text-ink">{PROJECT.handle} · via your sign-in</p>
    </div>

    <label class="mt-4 block">
      <span class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">Repository</span>
      <input
        type="text"
        value={PROJECT.secondRepo}
        readonly
        class="mt-2 h-11 w-full rounded-md border bg-bg px-3 font-mono text-[13px] focus-visible:outline-2 focus-visible:outline-ink border-rule-strong text-ink"
      />
    </label>

    <p class="mt-3 text-sm leading-relaxed font-medium text-ink-soft">
      This grants <strong class="font-semibold text-ink">read-only</strong> access to one
      repository and asks which of its branches are prototypes. Canon never stores your code.
    </p>

    <p class="mt-2 text-[11px] leading-relaxed font-medium text-ink-soft">
      Read-only is the whole permission, not a starting one you get talked out of later. Canon
      cannot push, cannot open a pull request, and cannot delete a branch it did not open.
    </p>
  </div>

  <div class="mt-8 flex max-w-xl items-center justify-between gap-4">
    <a
      href={withBase('/v2-preview/')}
      class="btn btn-quiet"
    >
      Cancel
    </a>
    <a
      href={withBase('/v2-preview/import/branches/')}
      class="btn btn-primary"
    >
      Continue
    </a>
  </div>

  <a
    slot="footer-nav"
    href={withBase('/v2-preview/flows/')}
    class="flex min-h-11 items-center text-ink-soft underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    Flow map
  </a>
</AppShell>
