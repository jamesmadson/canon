---
import AppShell from '../../../../components/AppShell.astro';
import ScriptedCopyButton from '../../../../components/ScriptedCopyButton.astro';
import { withBase } from '../../../../lib/withBase';
import { spellNumber } from '../../../../lib/spellNumber';
import { groupByTheme, openLoops, STRENGTH_SCALE, strengthTag } from '../../../../lib/evidence';
import { PREVIEW_AS_OF, PROJECT, RECORD_ENTRIES } from '../../../../data/v2Preview';

/**
 * The report, derived rather than written.
 *
 * Nothing here is a summary somebody typed: the sections are the record
 * regrouped by strength, each with the count that put it in that section and
 * one entry quoted whole. "Open" is the honest name — the loops at the bottom
 * are the part of a report that usually goes missing.
 */
const themes = groupByTheme(RECORD_ENTRIES);
const patterns = themes.filter((t) => t.strength === 'pattern');
const possible = themes.filter((t) => t.strength === 'possible');
const loops = openLoops(RECORD_ENTRIES);

/** The earliest entry on a theme — the one that raised the question first. */
function representative(entries: (typeof RECORD_ENTRIES)[number][]) {
  return [...entries].sort((a, b) => a.date.localeCompare(b.date))[0];
}
---

<AppShell
  title="Canon v2 preview — the open report"
  description="A scripted preview of the Canon v2 report: patterns with three voices or more, possible patterns, and the open loops nobody decided."
  active="research"
>
  <a
    href={withBase('/v2-preview/research/')}
    class="-ml-1 inline-flex min-h-11 items-center px-1 text-[13px] font-medium text-ink-soft underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    ← The record
  </a>

  <h1 class="mt-2 text-2xl font-bold tracking-tight">The open report</h1>
  <p class="mt-1 text-[13px] font-medium text-ink-soft tabular-nums">
    {PROJECT.name} · {RECORD_ENTRIES.length} entries as of {PREVIEW_AS_OF}
  </p>

  <p class="mt-3 max-w-2xl text-base leading-relaxed font-medium text-ink-soft">
    Not a write-up. The same entries, regrouped by the question they answer and ordered by how
    many people are behind them. It stays open because the record does — every count moves the
    moment an entry&nbsp;lands.
  </p>

  <p class="mt-4 flex flex-wrap items-baseline gap-x-2 gap-y-1 border-t border-rule pt-4 text-[13px] font-medium text-ink-soft">
    <span class="label text-ink">Evidence strength</span>
    <span class="tabular-nums">{STRENGTH_SCALE}</span>
  </p>

  <div class="mt-4">
    <ScriptedCopyButton
      label="Copy report"
      note="Scripted in this preview — the button flips and the clipboard stays empty. In the product it copies the text below, counts included, ready to paste into a doc or a thread."
    />
  </div>

  <section class="mt-8" aria-labelledby="patterns-heading">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="patterns-heading" class="label">
        Patterns — three voices or more
      </h2>
      <p class="text-[11px] font-medium text-ink-soft tabular-nums">
        {patterns.length} {patterns.length === 1 ? 'question' : 'questions'}
      </p>
    </div>

    {patterns.length > 0 ? (
      <div class="overflow-hidden rounded-md border border-rule">
        {patterns.map((theme) => {
          const quote = representative(theme.entries);
          return (
            <article class="border-b border-rule bg-bg px-4 py-4 last:border-b-0">
              <header class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                <h3 class="text-base font-semibold tracking-tight text-ink">{theme.theme}</h3>
                <span class="rounded-full bg-recess px-2 py-1 text-[11px] font-semibold whitespace-nowrap text-ink tabular-nums">
                  {strengthTag(theme)}
                </span>
              </header>
              <p class="mt-3 border-l border-rule-strong pl-3 text-base leading-relaxed font-medium text-ink">
                “{quote.said}”
              </p>
              <p class="mt-2 text-[11px] font-medium text-ink-soft tabular-nums">
                <span class="font-mono font-semibold text-ink">{quote.speaker}</span> ·{' '}
                {quote.date} · {quote.source} · {theme.entries.length}{' '}
                {theme.entries.length === 1 ? 'entry' : 'entries'} on this question
              </p>
              <p class="mt-3 text-[13px] leading-relaxed font-medium text-ink-soft">
                <span class="font-semibold text-ink">Decided —</span>{' '}
                {theme.decided ?? 'Nothing yet.'}
              </p>
            </article>
          );
        })}
      </div>
    ) : (
      <p class="rounded-md border border-rule px-4 py-4 text-[13px] font-medium text-ink-soft">
        Nothing has three voices behind it yet.
      </p>
    )}
  </section>

  <section class="mt-8" aria-labelledby="possible-heading">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="possible-heading" class="label">
        Possible patterns — two voices
      </h2>
      <p class="text-[11px] font-medium text-ink-soft tabular-nums">
        {possible.length} {possible.length === 1 ? 'question' : 'questions'}
      </p>
    </div>

    <div class="overflow-hidden rounded-md border border-rule">
      {possible.map((theme) => {
        const quote = representative(theme.entries);
        return (
          <article class="border-b border-rule bg-bg px-4 py-4 last:border-b-0">
            <header class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <h3 class="text-base font-semibold tracking-tight text-ink">{theme.theme}</h3>
              <span class="rounded-full bg-recess px-2 py-1 text-[11px] font-semibold whitespace-nowrap text-ink-soft tabular-nums">
                {strengthTag(theme)}
              </span>
            </header>
            <p class="mt-3 border-l border-rule-strong pl-3 text-base leading-relaxed font-medium text-ink">
              “{quote.said}”
            </p>
            <p class="mt-2 text-[11px] font-medium text-ink-soft tabular-nums">
              <span class="font-mono font-semibold text-ink">{quote.speaker}</span> · {quote.date} ·{' '}
              {quote.source}
            </p>
            <p class="mt-3 text-[13px] leading-relaxed font-medium text-ink-soft">
              <span class="font-semibold text-ink">Decided —</span> {theme.decided ?? 'Nothing yet.'}
            </p>
          </article>
        );
      })}
    </div>

    <p class="mt-2 max-w-2xl text-[11px] leading-relaxed font-medium text-ink-soft">
      Two people is a reason to look again, not a reason to build. The count is printed so the
      next reader can disagree with the call.
    </p>
  </section>

  <section class="mt-8" aria-labelledby="loops-heading">
    <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="loops-heading" class="label">
        Open loops — said, never decided
      </h2>
      <p class="text-[11px] font-medium text-ink-soft tabular-nums">
        {loops.length} {loops.length === 1 ? 'question' : 'questions'}
      </p>
    </div>

    <div class="overflow-hidden rounded-md border border-rule">
      {loops.map((theme) => {
        const quote = representative(theme.entries);
        return (
          <div class="border-b border-rule bg-bg px-4 py-4 last:border-b-0">
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <p class="text-base font-semibold text-ink">{theme.theme}</p>
              <span class="rounded-full bg-recess px-2 py-1 text-[11px] font-semibold whitespace-nowrap text-ink-soft tabular-nums">
                {strengthTag(theme)}
              </span>
            </div>
            <p class="mt-2 text-[13px] leading-relaxed font-medium text-ink-soft">
              “{quote.said}” —{' '}
              <span class="font-mono text-[11px] font-semibold text-ink">{quote.speaker}</span>
              <span class="text-[11px] tabular-nums"> · {quote.date}</span>
            </p>
          </div>
        );
      })}
    </div>

    <p class="mt-2 max-w-2xl text-[13px] leading-relaxed font-medium text-ink-soft">
      {spellNumber(loops.length).charAt(0).toUpperCase() + spellNumber(loops.length).slice(1)} of the{' '}
      {spellNumber(themes.length)} questions in the record have nothing decided against them. That
      is a normal state and a visible one — a report that only listed what was acted on would make
      the rest disappear.
    </p>
  </section>

  <a
    slot="footer-nav"
    href={withBase('/v2-preview/research/')}
    class="flex min-h-11 items-center font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    Back to the record
  </a>

  <a
    slot="footer-nav"
    href={withBase('/v2-preview/')}
    class="flex min-h-11 items-center text-ink-soft underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
  >
    Dashboard
  </a>
</AppShell>
