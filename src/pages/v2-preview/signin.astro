---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MeshPanel from '../../components/MeshPanel.astro';
import PreviewLabel from '../../components/PreviewLabel.astro';
import RamsMark from '../../components/RamsMark.astro';
import { withBase } from '../../lib/withBase';
import { PROJECT } from '../../data/v2Preview';
---

<BaseLayout
  title="Canon v2 preview — sign in"
  description="A scripted preview of Canon v2's sign-in: OAuth only, first sign-in creates the account."
>
  <p class="mb-4 label">
    Canon v2 preview · sign in
  </p>

  <div class="mx-auto flex max-w-md flex-col gap-[10px] overflow-hidden rounded-lg bg-ground text-ink">
    <PreviewLabel placement="top" />

    {/* The one warmed surface on the page, and the only place the door shows
        any colour: rings, with the accent at the centre of them. */}
    <MeshPanel class="mx-2 flex items-center justify-center px-6 py-10">
      <RamsMark name="rings" size={104} />
    </MeshPanel>

    <div class="px-6 pb-2 text-center">
      <p class="display">Canon</p>
      <p class="mt-3 text-sm leading-relaxed font-medium text-ink-soft">
        Sign in or create an account — they're the same door. No passwords to
        make, none for us to lose.
      </p>

      {/* One primary on this view: the door people actually use. Google is the
          same door, so it takes the secondary pill rather than a second solid. */}
      <div class="mt-8 flex flex-col gap-2">
        <a
          href={withBase('/v2-preview/onboarding/project/')}
          class="btn btn-primary"
        >
          Continue with GitHub
        </a>
        <a
          href={withBase('/v2-preview/onboarding/project/')}
          class="btn btn-secondary"
        >
          Continue with Google
        </a>
      </div>

      <p class="mt-6 text-[11px] leading-relaxed font-medium text-ink-soft">
        Personal account. Read-only access to anything you connect — Canon
        indexes and annotates; your work stays where it lives.
      </p>
    </div>

    <p class="mx-2 mb-2 rounded-sm bg-recess px-4 py-3 text-[11px] font-medium text-ink-soft">
      In this preview both buttons continue as
      <span class="font-mono">{PROJECT.account}</span> — an invented person on an
      invented team.
    </p>
  </div>
</BaseLayout>
