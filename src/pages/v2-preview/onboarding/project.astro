---
import OnboardingShell from '../../../components/OnboardingShell.astro';
import { withBase } from '../../../lib/withBase';
import { PROJECT } from '../../../data/v2Preview';
---

<OnboardingShell
  title="Canon v2 preview — name the project"
  description="Onboarding step 1 of the scripted Canon v2 preview: naming the first project."
  step={1}
>
  <h1 class="display">Name your first project</h1>
  <p class="mt-2 text-sm leading-relaxed font-medium text-ink-soft">
    Signed in as <span class="font-mono text-[13px]">{PROJECT.account}</span> — a
    project is the home for one product's prototypes, feedback, and reviews.
  </p>

  <label class="mt-6 block">
    <span class="label">Project name</span>
    <input
      type="text"
      value={PROJECT.name}
      readonly
      class="mt-2 field text-base"
    />
  </label>

  <label class="mt-4 block">
    <span class="label">One line on what it is <span class="normal-case">(optional)</span></span>
    <input
      type="text"
      value={PROJECT.tagline}
      readonly
      class="mt-2 field text-base text-ink-soft"
    />
  </label>

  <div class="mt-8 flex items-center justify-between gap-4">
    <a
      href={withBase('/v2-preview/signin/')}
      class="btn btn-quiet"
    >
      Back
    </a>
    <a
      href={withBase('/v2-preview/onboarding/github/')}
      class="btn btn-primary"
    >
      Continue
    </a>
  </div>
</OnboardingShell>
