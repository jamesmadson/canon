---
import OnboardingShell from '../../../components/OnboardingShell.astro';
import BranchChecklist from '../../../components/BranchChecklist.astro';
import { withBase } from '../../../lib/withBase';
import { BRANCHES, PROJECT } from '../../../data/v2Preview';
---

<OnboardingShell
  title="Canon v2 preview — choose what's visible"
  description="Onboarding step 2 of the scripted Canon v2 preview: connecting a repository read-only and picking which branches are prototypes."
  step={2}
>
  <h1 class="text-xl font-bold tracking-tight">Choose what's visible</h1>
  <p class="mt-2 text-sm leading-relaxed font-medium text-ink-soft">
    You signed in with GitHub, so Canon already knows who you are — this step
    grants <strong class="font-semibold text-ink">read-only</strong> access to
    one repository and asks which of its branches are prototypes. Canon never
    stores your code.
  </p>

  <div class="mt-6 rounded-md border border-rule bg-surface/50 px-4 py-3">
    <p class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">Connected as</p>
    <p class="mt-0.5 font-mono text-sm text-ink">{PROJECT.handle} · via your sign-in</p>
  </div>

  <label class="mt-4 block">
    <span class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">Repository</span>
    <input
      type="text"
      value={PROJECT.repo}
      readonly
      class="mt-1.5 w-full rounded-md border border-rule-strong bg-bg px-3 py-2.5 font-mono text-sm text-ink focus-visible:outline-2 focus-visible:outline-ink"
    />
  </label>

  <div class="mt-5">
    <BranchChecklist branches={BRANCHES} />
  </div>
  <p class="mt-2 text-[11px] leading-relaxed font-medium text-ink-soft">
    Read-only in this preview — in the product these are yours to tick and untick,
    and you can change your mind later.
  </p>

  <div class="mt-5 rounded-md border border-rule px-4 py-3">
    <p class="text-sm leading-relaxed font-medium text-ink">
      Canon does not ask you to rename anything. Your branches keep whatever
      convention you already use —
      <span class="font-mono text-[13px]">feat/</span>,
      <span class="font-mono text-[13px]">exp/</span>, or nothing at all — and you
      pick which ones are prototypes.
    </p>
    <p class="mt-2 text-[13px] leading-relaxed font-medium text-ink-soft">
      The one exception is a prototype started
      <em class="font-semibold text-ink not-italic">from</em> Canon: those branches
      get the <code class="rounded-sm bg-surface px-1.5 py-0.5 font-mono text-[13px]">prototype-</code>
      prefix automatically, because Canon is the thing naming them.
    </p>
  </div>

  <div class="mt-8 flex items-center justify-between gap-4">
    <a
      href={withBase('/v2-preview/onboarding/project/')}
      class="flex min-h-11 items-center rounded-md px-2 py-3 text-sm font-semibold text-ink-soft transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-ink"
    >
      Back
    </a>
    <a
      href={withBase('/v2-preview/onboarding/figma/')}
      class="flex min-h-11 items-center rounded-md bg-ink px-5 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      Connect read-only
    </a>
  </div>
</OnboardingShell>
