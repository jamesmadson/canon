---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/home/HomePage.astro';
import { WAITLIST_URL } from '../lib/site';
---

<!-- The tabs hero is now the homepage hero. This address still works: hidden, unlinked and out of the sitemap. -->
<BaseLayout
  wide
  hero
  noindex
  nofollow
  title="One place for every prototype"
  description="Your prototypes are spread across tools. Canon keeps every link, zip and agent build in one place, by project, on your machine."
>
  <HomePage waitlistUrl={WAITLIST_URL} hero="tabs" />
</BaseLayout>
