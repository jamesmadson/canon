---
import BaseLayout from '../layouts/BaseLayout.astro';
import MeshPanel from '../components/MeshPanel.astro';
import PreviewLabel from '../components/PreviewLabel.astro';
import PrototypeRow from '../components/PrototypeRow.astro';
import FeedbackEntryCard from '../components/FeedbackEntryCard.astro';
import RamsMark from '../components/RamsMark.astro';
import ReviewRunCard from '../components/ReviewRunCard.astro';
import { withBase } from '../lib/withBase';
import { spellNumber } from '../lib/spellNumber';
import { getCollection } from 'astro:content';
import { PROTOTYPES, RECORDS } from '../data/v2Preview';

const record = RECORDS['today-ring-v2'];
// The entry with a Decided line: the pane should show the shape end to end.
const featuredEntry = record.feedback.find((entry) => entry.decided) ?? record.feedback[0];
const paneHeading = 'label';

// Derived rather than written down, so the sentence cannot outlive the gallery.
const publishedSkills = await getCollection('skills', ({ data }) => data.status === 'active');
const skillCount = spellNumber(publishedSkills.length);
---

{/* This page needed a scope of its own while the product and the gallery spoke
    two languages. They speak one now, so it is an ordinary page. */}
<BaseLayout
  title="Canon v2 alpha"
  description="Canon v2 keeps your team's prototypes, their feedback, and their reviews in one place. Join the alpha."
>
  <section class="mb-12 max-w-2xl">
    <p class="mb-3 label">Canon v2 · alpha</p>
    <h1 class="display-lg">
      Your prototypes, in one place, with the feedback still attached.
    </h1>
    <p class="mt-5 text-base leading-relaxed font-medium text-ink-soft">
      AI made it easy to build five versions of a screen in an afternoon. It did nothing
      about what comes next: branches nobody can find, Figma links buried in a chat
      thread, and feedback scattered across three of them.
    </p>
    <p class="mt-3 text-base leading-relaxed font-medium text-ink-soft">
      Canon does two jobs: <strong class="font-semibold text-ink">prototypes in one place</strong>,
      and <strong class="font-semibold text-ink">feedback that becomes evidence</strong>. It lists
      every prototype your team has made, from GitHub and Figma, and shows each one as the screen
      it actually is. Comments pin to the running build and file into a record as drafts you
      confirm, so what a person said, what you think it meant, and what got decided all stay in
      one place, with the number of voices behind each one printed next to it.
    </p>
    <p class="mt-3 text-base leading-relaxed font-medium text-ink-soft">
      It flags the prototypes nobody has touched in three weeks, and your work stays where it is:
      Canon reads it, never copies it.
    </p>
  </section>

  <section class="mb-14" aria-labelledby="preview-heading">
    <h2 id="preview-heading" class="mb-2 label">
      What it looks like
    </h2>
    <p class="mb-4 max-w-2xl text-sm font-medium text-ink-soft">
      Three parts of one project, an invented app called Fernwell: the prototypes it has,
      one piece of feedback filed against one of them, and a review that only ever suggests
      taking things away.
    </p>

    {/* Three panes, three fills, a real gap between them. The old version was
        one bordered slab cut into thirds by hairlines. */}
    <div class="overflow-hidden rounded-lg bg-ground">
      <div class="grid grid-cols-1 gap-[10px] p-[10px] lg:grid-cols-3">
        <section class="flex flex-col gap-[10px]" aria-label="Prototypes pane">
          <p class={`px-1 ${paneHeading}`}>Prototypes</p>
          {PROTOTYPES.map((prototype) => <PrototypeRow prototype={prototype} />)}
        </section>

        <section class="flex flex-col gap-[10px]" aria-label="Feedback pane">
          <p class={`px-1 ${paneHeading}`}>Feedback: said, meant, decided</p>
          <FeedbackEntryCard entry={featuredEntry} compact />
        </section>

        <section class="flex flex-col gap-[10px]" aria-label="Review pane">
          <p class={`px-1 ${paneHeading}`}>Review: what to remove</p>
          {record.review && (
            <div class="overflow-hidden rounded-md bg-panel">
              <ReviewRunCard run={record.review} compact />
            </div>
          )}
        </section>
      </div>

      <PreviewLabel placement="bottom" />
    </div>

    <a
      href={withBase('/v2-preview/')}
      class="mt-3 flex min-h-11 items-center text-sm font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      Walk through the full screens
    </a>
    <p class="max-w-2xl text-sm font-medium text-ink-soft">
      A scripted click-through of the dashboard and one prototype, at four screen sizes.
    </p>
    <a
      href={withBase('/v2-preview/flows/')}
      class="mt-2 flex min-h-11 items-center text-sm font-medium text-ink-soft underline decoration-rule underline-offset-4 transition-colors hover:text-ink hover:decoration-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      Walk every flow →
    </a>
  </section>

  <section class="mb-14" aria-labelledby="how-heading">
    <h2 id="how-heading" class="mb-4 label">
      What the alpha does
    </h2>
    <div class="grid grid-cols-1 gap-[10px] sm:grid-cols-3">
      <div class="rounded-md bg-panel p-4">
        <RamsMark name="dot-grid" size={48} class="mb-4" />
        <h3 class="text-base font-semibold text-ink">Indexes what exists</h3>
        <p class="mt-2 text-[13px] leading-relaxed font-medium text-ink-soft">
          Connect a repository read-only and attach a Figma file, then tick the branches
          that are prototypes. Keep the names you already use, and each one shows up as a
          screen, with its author, its last commit, and how long it has been quiet.
        </p>
      </div>
      <div class="rounded-md bg-panel p-4">
        <RamsMark name="line-stack" size={48} class="mb-4" />
        <h3 class="text-base font-semibold text-ink">Turns feedback into evidence</h3>
        <p class="mt-2 text-[13px] leading-relaxed font-medium text-ink-soft">
          Comments pin to the running build and file as dated entries: what a person said,
          word for word; what you think it meant, marked as your reading; and what was
          decided. The report counts the voices behind each question: one is a quote, three
          is a pattern. Names never enter the record.
        </p>
      </div>
      <div class="rounded-md bg-panel p-4">
        <RamsMark name="dial" size={48} class="mb-4" />
        <h3 class="text-base font-semibold text-ink">Reviews on request</h3>
        <p class="mt-2 text-[13px] leading-relaxed font-medium text-ink-soft">
          Press a button and a review runs against a prototype. The first one only
          proposes removals, each with a reason. Nothing runs on its own.
        </p>
      </div>
    </div>
  </section>

  <section class="mb-12 max-w-xl" aria-labelledby="waitlist-heading">
    <h2 id="waitlist-heading" class="display">Join the alpha</h2>
    <p class="mt-3 text-base leading-relaxed font-medium text-ink-soft">
      Teams of two to fifteen who prototype in code and Figma at the same time. Onboarded
      by hand, a few at a time.
    </p>

    <MeshPanel class="mt-5 flex items-center justify-center px-6 py-10">
      <RamsMark name="disc" size={104} />
    </MeshPanel>

    <div class="mt-[10px] rounded-lg bg-panel p-4 sm:p-5">
      <label for="waitlist-email" class="block label">
        Work email
      </label>
      <div class="mt-2 flex flex-col gap-2 sm:flex-row">
        <input
          id="waitlist-email"
          type="email"
          name="email"
          disabled
          placeholder="you@studio.example"
          aria-describedby="waitlist-note"
          class="field sm:flex-1"
        />
        <button
          type="button"
          disabled
          aria-describedby="waitlist-note"
          class="btn btn-utility"
        >
          Request an invite
        </button>
      </div>
      <p id="waitlist-note" class="mt-2 text-[13px] leading-relaxed font-medium text-ink-soft">
        The waitlist opens shortly. Or email
        <a
          href="mailto:james@jamesmadson.me"
          class="inline-flex min-h-11 items-center font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
        >
          james@jamesmadson.me
        </a>
        to be first.
      </p>
    </div>

    <p class="mt-5 text-[13px] leading-relaxed font-medium text-ink-soft">
      Built by the practice behind the Canon gallery: {skillCount} design skills,
      each read in full, license-checked, and written up by hand.
    </p>
    <a
      href={withBase('/skills/')}
      class="flex min-h-11 items-center text-[13px] font-semibold text-ink underline decoration-rule-strong underline-offset-4 transition-colors hover:decoration-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      See the gallery
    </a>
  </section>
</BaseLayout>
